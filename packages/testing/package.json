{
  "name": "@alienplatform/testing",
  "version": "3.3.26",
  "description": "Testing framework for Alien applications",
  "homepage": "https://alien.dev",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Alien Software, Inc. <hi@alien.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alienplatform/alien.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ts": "tsc --noEmit"
  },
  "dependencies": {
    "@alienplatform/commands": "workspace:*",
    "@alienplatform/core": "workspace:*",
    "get-port": "^7.1.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@alienplatform/typescript-config": "workspace:^",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.0.0",
    "@google-cloud/secret-manager": "^6.0.0",
    "@types/node": "^24.0.15",
    "tsdown": "^0.13.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-ssm": "^3.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-ssm": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  }
}
