{
  "name": "@alienplatform/sdk",
  "version": "3.3.26",
  "description": "TypeScript SDK for Alien Worker apps — handler APIs and re-exported binding factories",
  "keywords": [
    "alien",
    "bindings",
    "sdk",
    "worker"
  ],
  "homepage": "https://alien.dev",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Alien Software, Inc. <hi@alien.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alienplatform/alien.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime/index.d.ts",
      "import": "./dist/worker-runtime/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./native-bindings": {
      "types": "./dist/native-bindings.d.ts",
      "import": "./dist/native-bindings.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "test:ts": "tsc --noEmit",
    "generate": "./scripts/generate-proto.sh",
    "format-and-lint": "oxfmt --check \"**/*.{cjs,css,cts,js,json,jsonc,jsx,mjs,mts,ts,tsx}\" && oxlint .",
    "format-and-lint:fix": "oxfmt --write \"**/*.{cjs,css,cts,js,json,jsonc,jsx,mjs,mts,ts,tsx}\" && oxlint --fix ."
  },
  "dependencies": {
    "@alienplatform/ai-gateway": "workspace:^",
    "@alienplatform/bindings": "workspace:^",
    "@alienplatform/core": "workspace:^",
    "@bufbuild/protobuf": "^2.5.3",
    "@grpc/grpc-js": "^1.14.4",
    "nice-grpc": "^2.1.11",
    "nice-grpc-common": "^2.0.2",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@alienplatform/typescript-config": "workspace:^",
    "@types/node": "^24.0.15",
    "ts-proto": "^2.7.0",
    "tsdown": "^0.13.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
