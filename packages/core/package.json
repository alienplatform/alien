{
  "name": "@alienplatform/core",
  "version": "3.3.25",
  "description": "Core types and schemas for the Alien platform",
  "keywords": [
    "alien",
    "cloud",
    "deployment",
    "infrastructure"
  ],
  "homepage": "https://alien.dev",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Alien Software, Inc. <hi@alien.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alienplatform/alien.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:ts": "tsc --noEmit",
    "generate": "rm -rf src/generated && cargo run --quiet --bin schema_exporter --features=clap,openapi -p alien-core -- --output openapi.json && kubb generate",
    "format-and-lint": "oxfmt --check \"**/*.{cjs,css,cts,js,json,jsonc,jsx,mjs,mts,ts,tsx}\" && oxlint .",
    "format-and-lint:fix": "oxfmt --write \"**/*.{cjs,css,cts,js,json,jsonc,jsx,mjs,mts,ts,tsx}\" && oxlint --fix ."
  },
  "dependencies": {
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.0.0",
    "serialize-error": "^12.0.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@alienplatform/typescript-config": "workspace:^",
    "@kubb/cli": "^4.35.1",
    "@kubb/core": "^4.35.1",
    "@kubb/oas": "^4.35.1",
    "@kubb/plugin-oas": "^4.35.1",
    "@kubb/plugin-zod": "^4.35.1",
    "@types/node": "^24.0.15",
    "tsdown": "^0.13.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
