FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /data /opt/alien
COPY alien-sandbox-agent /usr/local/bin/alien-sandbox-agent
RUN echo '{"command":["/bin/sh","-c","env > /data/image-env"],"env":{"PATH":"/usr/local/bin:/usr/bin:/bin"},"workingDirectory":"/data"}' > /opt/alien/image-command.json
ENV ALIEN_SANDBOX_ROOT=/data ALIEN_SANDBOX_PORT=8080 \
    ALIEN_SANDBOX_EXEC_UID=60000 ALIEN_SANDBOX_EXEC_GID=60000 \
    ALIEN_SANDBOX_ISOLATION=uid-split ALIEN_SANDBOX_AUTHORIZATION=transport \
    ALIEN_SANDBOX_EGRESS=internet
ENTRYPOINT ["alien-sandbox-agent"]
