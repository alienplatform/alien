{
  // Allows consuming and acknowledging messages from queues
  "id": "queue/data-read",
  "description": "Allows consuming and acknowledging messages from message queues",
  "platforms": {
    "aws": [
      {
        "grant": {
          "actions": [
            "sqs:ReceiveMessage",
            "sqs:DeleteMessage",
            "sqs:ChangeMessageVisibility",
            "sqs:GetQueueAttributes",
            "sqs:GetQueueUrl",
          ],
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:sqs:${awsRegion}:${awsAccountId}:${stackPrefix}-*"],
          },
          "resource": {
            "resources": ["arn:aws:sqs:${awsRegion}:${awsAccountId}:${resourceName}"],
          },
        },
      },
    ],
    "gcp": [
      {
        "grant": {
          "predefinedRoles": ["roles/pubsub.subscriber", "roles/pubsub.viewer"],
        },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": {
            "scope": "projects/${projectName}/subscriptions/${resourceName}",
          },
        },
      },
    ],
    "azure": [
      {
        "grant": {
          "predefinedRoles": ["Azure Service Bus Data Receiver"],
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}",
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.ServiceBus/namespaces/${resourceName}-sb/queues/${resourceName}",
          },
        },
      },
    ],
  },
}
