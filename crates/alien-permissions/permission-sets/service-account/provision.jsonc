{
  "id": "service-account/provision",
  "description": "Allows provisioning and creating service accounts/roles/managed identities",
  "platforms": {
    "aws": [
      {
        "grant": {
          "actions": ["iam:CreateRole", "iam:PutRolePolicy", "iam:PutRolePermissionsBoundary"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}"
              }
            }
          }
        },
        "label": "legacy-role-1"
      },
      {
        "grant": {
          "actions": ["iam:CreateRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          }
        },
        "label": "bounded-role-create-1"
      },
      {
        "grant": {
          "actions": ["iam:PutRolePolicy", "iam:PutRolePermissionsBoundary"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        },
        "label": "bounded-role-write-1"
      },
      {
        "grant": {
          "actions": [
            "iam:GetRole",
            "iam:GetRolePolicy",
            "iam:ListRolePolicies",
            "iam:ListAttachedRolePolicies"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"]
          }
        }
      },
      {
        "grant": {
          "actions": ["iam:TagRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"]
          }
        },
        "label": "legacy-role-2"
      },
      {
        "grant": {
          "actions": ["iam:TagRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          }
        },
        "label": "bounded-role-tag-2"
      },
      // Setup grants roles their permissions through customer-managed policies. Terraform names
      // them `<prefix>-<role>-setup-<hash>`; CloudFormation generates
      // `<stack name>-<logical ID>-<random suffix>` with a logical ID containing
      // `RoleManagedPermissions`. CloudFormation cannot tag managed policies (AWS::IAM::ManagedPolicy
      // has no Tags), so these grants are bound by those names. The name alone also matches a
      // stack whose name starts with this one plus a dash; that reaches no further than the setup
      // identity's existing iam:PutRolePolicy on `<prefix>-*` roles, which is bound the same way.
      {
        "label": "setup-role-managed-policies",
        "grant": {
          "actions": [
            "iam:CreatePolicy",
            "iam:GetPolicy",
            "iam:GetPolicyVersion",
            "iam:ListPolicyVersions",
            "iam:CreatePolicyVersion",
            "iam:DeletePolicyVersion",
            "iam:DeletePolicy",
            "iam:ListEntitiesForPolicy"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*-setup-*",
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-${resourceName}-setup-*",
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
            ]
          }
        }
      },
      // Attaching is limited to those setup policies, never an AWS managed or other policy, and
      // to roles tagged for this stack. Only setups attach them, and setup-created roles have no
      // permissions boundary; a role written under the boundary gets inline policies instead.
      {
        "label": "legacy-role-attach-setup-policies",
        "grant": {
          "actions": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringLike": {
                "iam:PolicyARN": [
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*-setup-*",
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringLike": {
                "iam:PolicyARN": [
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-${resourceName}-setup-*",
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
                ]
              }
            }
          }
        }
      }
    ],
    "gcp": [
      // Listing usage requires the project even for a resource-scoped grant.
      {
        "label": "service-account-quota-inventory",
        "description": "Read project service-account inventory for quota preflights",
        "grant": { "permissions": ["iam.serviceAccounts.list"] },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      },
      {
        "grant": {
          "permissions": [
            "iam.serviceAccounts.create",
            "iam.serviceAccounts.get",
            "iam.serviceAccounts.getIamPolicy",
            "iam.serviceAccounts.setIamPolicy",
            "iam.serviceAccounts.update",
            "iam.roles.create",
            "iam.roles.get",
            "iam.roles.list",
            "serviceusage.quotas.get",
            "iam.roles.undelete",
            "iam.roles.update",
            "resourcemanager.projects.getIamPolicy",
            "resourcemanager.projects.setIamPolicy"
          ]
        },
        "binding": {
          "stack": {
            "scope": "projects/${projectName}"
          },
          "resource": {
            "scope": "projects/${projectName}/serviceAccounts/${stackPrefix}-${resourceName}@${projectName}.iam.gserviceaccount.com"
          }
        }
      }
    ],
    "azure": [
      {
        "grant": {
          "predefinedRoles": ["Managed Identity Contributor"],
          "actions": [
            "Microsoft.Authorization/roleDefinitions/read",
            "Microsoft.Authorization/roleDefinitions/write",
            "Microsoft.Authorization/roleAssignments/read",
            "Microsoft.Authorization/roleAssignments/write"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/${resourceName}"
          }
        }
      }
    ]
  }
}
