{
  "id": "service-account/setup",
  "description": "Allows a CloudFormation or Terraform setup to manage the managed policies it attaches to the roles it creates. Only the setup identity holds it; management and runtime roles do not.",
  "platforms": {
    "aws": [
      // Setup grants roles their permissions through customer-managed policies. Terraform names
      // them `<prefix>-<role>-setup-<hash>`; CloudFormation generates
      // `<stack name>-<logical ID>-<random suffix>` with a logical ID containing
      // `RoleManagedPermissions`. CloudFormation cannot tag managed policies (AWS::IAM::ManagedPolicy
      // has no Tags), so these grants are bound by those names. The name alone also matches a
      // stack whose name starts with this one plus a dash; that reaches no further than the setup
      // identity's existing iam:PutRolePolicy on `<prefix>-*` roles, which is bound the same way.
      {
        "label": "setup-role-managed-policies",
        "grant": {
          "actions": [
            "iam:CreatePolicy",
            "iam:GetPolicy",
            "iam:GetPolicyVersion",
            "iam:ListPolicyVersions",
            "iam:CreatePolicyVersion",
            "iam:DeletePolicyVersion",
            "iam:DeletePolicy",
            "iam:ListEntitiesForPolicy"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*-setup-*",
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-${resourceName}-setup-*",
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
            ]
          }
        }
      },
      // Attaching is limited to those setup policies, never an AWS managed or other policy, and
      // to roles tagged for this stack.
      {
        "label": "attach-setup-role-policies",
        "grant": {
          "actions": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringLike": {
                "iam:PolicyARN": [
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*-setup-*",
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringLike": {
                "iam:PolicyARN": [
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-${resourceName}-setup-*",
                  "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-*RoleManagedPermissions*"
                ]
              }
            }
          }
        }
      },
      // The sandbox egress gateway's role. Setup creates it without the deployment's permissions
      // boundary, which denies every role under it the gateway configuration, and tags it
      // `managed-by=setup`, as the CloudFormation and Terraform setups do; management can then
      // neither adopt nor change it, so only setup writes it. The provision grants on roles all
      // require the boundary, so these grants name this deployment's gateway role alone. An
      // earlier direct setup created that role bounded and tagged `managed-by=runtime`; setup
      // retags it and removes that boundary.
      {
        "label": "create-sandbox-gateway-role",
        "grant": {
          "actions": ["iam:CreateRole"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-sandbox-egress-gateway-sa"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "setup"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type"
                ]
              }
            }
          }
        }
      },
      // CreateRole with tags also authorizes TagRole, with the new role's tags as its resource
      // tags. IfExists keeps that working; an existing role must already be this stack's.
      {
        "label": "tag-sandbox-gateway-role",
        "grant": {
          "actions": ["iam:TagRole"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-sandbox-egress-gateway-sa"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "setup"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type"
                ]
              },
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": ["runtime", "setup"]
              }
            }
          }
        }
      },
      {
        "label": "write-sandbox-gateway-role",
        "grant": {
          "actions": [
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:UpdateAssumeRolePolicy",
            "iam:DeleteRolePermissionsBoundary",
            "iam:DeleteRole"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-sandbox-egress-gateway-sa"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": ["runtime", "setup"]
              }
            }
          }
        }
      },
      {
        // The Terraform AWS provider lists a role's instance profiles before deleting the role.
        "label": "read-setup-role-instance-profiles",
        "description": "List the instance profiles of the roles the setup created.",
        "grant": {
          "actions": ["iam:ListInstanceProfilesForRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        }
      }
    ]
  }
}
