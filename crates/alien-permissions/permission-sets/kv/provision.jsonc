{
  "id": "kv/provision",
  "description": "Allows provisioning and destroying KV stores",
  "platforms": {
    "aws": [
      {
        "label": "kv-provision",
        "description": "Create, read, update and delete this stack's DynamoDB tables.",
        "grant": {
          "actions": [
            "dynamodb:CreateTable",
            "dynamodb:DeleteTable",
            "dynamodb:DescribeTable",
            "dynamodb:ListTables",
            "dynamodb:UpdateTable",
            "dynamodb:UpdateTimeToLive",
            "dynamodb:DescribeTimeToLive",
            "dynamodb:ListTagsOfResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${resourceName}"]
          }
        }
      },
      {
        // Another stack's name can start with this stack's prefix, so tagging also needs the
        // table to carry this stack's tag (or no tag yet, at creation) and keep it. Otherwise
        // a table of that other stack could be retagged into this one.
        "label": "tag-dynamodb-tables",
        "description": "Tag this stack's DynamoDB tables at creation.",
        "grant": {
          "actions": ["dynamodb:TagResource"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${stackPrefix}-*"],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${resourceName}"],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        }
      },
      {
        // Bound to the stack tag as well as the name, for the same reason as tagging.
        "label": "enable-dynamodb-point-in-time-recovery",
        "description": "Read and turn on point-in-time recovery for this stack's DynamoDB tables.",
        "grant": {
          "actions": [
            "dynamodb:DescribeContinuousBackups",
            "dynamodb:UpdateContinuousBackups"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:dynamodb:${awsRegion}:${awsAccountId}:table/${resourceName}"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        }
      }
    ],
    "gcp": [
      {
        "grant": {
          "permissions": [
            "datastore.databases.get",
            "datastore.databases.getMetadata",
            "datastore.databases.create",
            "datastore.databases.update",
            "datastore.databases.delete",
            "datastore.databases.list",
            "datastore.indexes.create",
            "datastore.indexes.delete",
            "datastore.indexes.get",
            "datastore.indexes.list",
            "datastore.indexes.update"
          ]
        },
        // Firestore uses the (default) database shared across stacks.
        // Isolation is enforced at the collection level by the application (collection names
        // are prefixed with kv-{stackPrefix}-). IAM conditions cannot scope to collections,
        // so we use scope-only bindings.
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      }
    ],
    "azure": [
      {
        "grant": {
          "actions": [
            "Microsoft.Storage/storageAccounts/tableServices/read",
            "Microsoft.Storage/storageAccounts/tableServices/tables/read",
            "Microsoft.Storage/storageAccounts/tableServices/tables/write",
            "Microsoft.Storage/storageAccounts/tableServices/tables/delete",
            "Microsoft.Storage/storageAccounts/read"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.Storage/storageAccounts/${storageAccountName}"
          }
        }
      }
    ]
  }
}
