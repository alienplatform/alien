{
  "id": "build/provision",
  "description": "Allows creating, deleting, and performing fundamental lifecycle management on build projects",
  "platforms": {
    "aws": [
      {
        "grant": {
          "actions": [
            "codebuild:CreateProject",
            "codebuild:DeleteProject",
            "codebuild:UpdateProject",
            "codebuild:BatchGetProjects",
            "codebuild:ListBuildsForProject",
            "codebuild:ListCuratedEnvironmentImages",
            "codebuild:GetResourcePolicy",
            "codebuild:PutResourcePolicy",
            "codebuild:DeleteResourcePolicy"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:codebuild:${awsRegion}:${awsAccountId}:project/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:codebuild:${awsRegion}:${awsAccountId}:project/${resourceName}"]
          }
        }
      },
      {
        // Direct setup creates a build project's log group, tagged and with a retention
        // period, instead of the never-expiring group CodeBuild creates on the first build.
        // Every grant is bound to the deployment tag, since another deployment's name can
        // start with this one's prefix.
        "label": "create-build-log-groups",
        "description": "Create the CloudWatch log groups of this application's build projects, tagged for this deployment.",
        "grant": {
          "actions": ["logs:CreateLogGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${stackPrefix}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": ["${managedByTag}", "${stackTag}", "${resourceTag}"]
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": ["${managedByTag}", "${stackTag}", "${resourceTag}"]
              }
            }
          }
        }
      },
      {
        // Creating a group with tags also authorizes logs:TagResource. ResourceTag keeps the
        // grant from retagging another deployment's (or an untagged) group.
        "label": "tag-build-log-groups",
        "description": "Tag this deployment's build log groups as they are created.",
        "grant": {
          "actions": ["logs:TagResource"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${stackPrefix}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": ["${managedByTag}", "${stackTag}", "${resourceTag}"]
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": ["${managedByTag}", "${stackTag}", "${resourceTag}"]
              }
            }
          }
        }
      },
      {
        "label": "set-build-log-retention",
        "description": "Set how long this deployment's build log groups keep logs.",
        "grant": {
          "actions": ["logs:PutRetentionPolicy"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${stackPrefix}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:/aws/codebuild/${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        }
      },
      {
        "label": "bounded-role-pass",
        "grant": {
          "actions": ["iam:PassRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-sa"],
            "condition": {
              "StringEquals": {
                "iam:PassedToService": "codebuild.amazonaws.com"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-sa"],
            "condition": {
              "StringEquals": {
                "iam:PassedToService": "codebuild.amazonaws.com"
              }
            }
          }
        }
      },
      // Setups without a boundary retain their existing role-passing grants.
      {
        "label": "legacy-role-pass",
        "grant": {
          "actions": ["iam:PassRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-sa"]
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-sa"]
          }
        }
      }
    ],
    "gcp": [
      {
        "grant": {
          "permissions": [
            "cloudbuild.workerpools.create",
            "cloudbuild.workerpools.delete",
            "cloudbuild.workerpools.update",
            "cloudbuild.workerpools.get",
            "cloudbuild.workerpools.list",
            "cloudbuild.builds.create",
            "cloudbuild.builds.update",
            "cloudbuild.workerpools.use",
            "cloudbuild.operations.get",
            "cloudbuild.operations.list"
          ]
        },
        // Cloud Build IDs are auto-generated UUIDs — name-prefix conditions can never match.
        // Worker pool names are user-chosen but builds/triggers use UUIDs. Must use scope-only.
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      }
    ],
    "azure": [
      {
        "grant": {
          "actions": [
            "Microsoft.App/jobs/write",
            "Microsoft.App/jobs/delete",
            "Microsoft.App/managedEnvironments/read",
            "Microsoft.App/managedEnvironments/write",
            "Microsoft.App/jobs/read",
            "Microsoft.App/jobs/executions/read"
          ],
          "dataActions": []
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.App/jobs/${resourceName}"
          }
        }
      }
    ]
  }
}
