{
  "id": "artifact-registry/provision",
  "description": "Allows creating, deleting, and performing fundamental lifecycle management on artifact registries",
  "platforms": {
    "aws": [
      {
        "grant": {
          "actions": [
            "ecr:CreateRepository",
            "ecr:DeleteRepository",
            "ecr:SetRepositoryPolicy",
            "ecr:DeleteRepositoryPolicy",
            "ecr:TagResource",
            "ecr:PutLifecyclePolicy",
            "ecr:DeleteLifecyclePolicy",
            "ecr:PutImageScanningConfiguration",
            "ecr:PutImageTagMutability",
            "ecr:DescribeRepositories",
            "ecr:DescribeImages",
            "ecr:ListImages",
            "ecr:DescribeImageScanFindings",
            "ecr:GetRepositoryPolicy",
            "ecr:ListTagsForResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ecr:${awsRegion}:${awsAccountId}:repository/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:ecr:${awsRegion}:${awsAccountId}:repository/${resourceName}-*"]
          }
        }
      },
      {
        "grant": {
          "actions": ["ecr:DescribeRegistry"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      },
      {
        "grant": {
          "actions": [
            "iam:CreateRole",
            "iam:UpdateAssumeRolePolicy",
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:DetachRolePolicy",
            "iam:PutRolePermissionsBoundary"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}"
              }
            }
          }
        },
        "label": "legacy-role-3"
      },
      {
        "grant": {
          "actions": ["iam:CreateRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          }
        },
        "label": "bounded-role-create-3"
      },
      {
        "grant": {
          "actions": [
            "iam:UpdateAssumeRolePolicy",
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:DetachRolePolicy",
            "iam:PutRolePermissionsBoundary"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"],
            "condition": {
              "StringEquals": {
                "iam:PermissionsBoundary": "${awsPermissionsBoundaryArn}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        },
        "label": "bounded-role-write-3"
      },
      {
        "grant": {
          "actions": [
            "iam:GetRole",
            "iam:GetRolePolicy",
            "iam:ListRolePolicies",
            "iam:ListAttachedRolePolicies"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"]
          }
        }
      },
      {
        "grant": {
          "actions": [
            "iam:TagRole",
            "iam:DeleteRole"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"]
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"]
          }
        },
        "label": "legacy-role-4"
      },
      {
        "grant": {
          "actions": ["iam:TagRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "${managedByTag}",
                  "${stackTag}",
                  "${resourceTag}",
                  "resource-type",
                  "Name"
                ]
              }
            }
          }
        },
        "label": "bounded-role-tag-4"
      },
      {
        "grant": {
          "actions": ["iam:DeleteRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${resourceName}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          }
        },
        "label": "bounded-role-delete-4"
      }
    ],
    "gcp": [
      {
        "grant": {
          "permissions": [
            "artifactregistry.repositories.create",
            "artifactregistry.repositories.delete",
            "artifactregistry.repositories.update",
            "artifactregistry.repositories.setIamPolicy",
            "artifactregistry.locations.get",
            "artifactregistry.locations.list",
            "artifactregistry.repositories.get",
            "artifactregistry.repositories.list",
            "artifactregistry.repositories.getIamPolicy",
            "artifactregistry.tags.get",
            "artifactregistry.tags.list",
            "artifactregistry.versions.get",
            "artifactregistry.versions.list",
            "artifactregistry.packages.get",
            "artifactregistry.packages.list"
          ]
        },
        "binding": {
          "stack": {
            "scope": "projects/${projectName}"
          },
          "resource": {
            "scope": "projects/${projectName}/locations/${region}/repositories/${resourceName}"
          }
        }
      }
    ],
    "azure": [
      {
        "grant": {
          "actions": [
            "Microsoft.ContainerRegistry/registries/write",
            "Microsoft.ContainerRegistry/registries/delete",
            "Microsoft.ContainerRegistry/registries/updatePolicies/write",
            "Microsoft.ContainerRegistry/registries/read",
            "Microsoft.ContainerRegistry/registries/metadata/read",
            "Microsoft.ContainerRegistry/registries/quarantine/read",
            "Microsoft.ContainerRegistry/registries/quarantine/write",
            "Microsoft.ContainerRegistry/registries/sign/write"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.ContainerRegistry/registries/${resourceName}"
          }
        }
      }
    ]
  }
}
