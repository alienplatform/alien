{
  "id": "artifact-registry/remote-read-write",
  "description": "Allows remote OCI clients to pull and push artifacts in one setup-owned registry without repository lifecycle access",
  "platforms": {
    "aws": [
      {
        "label": "authenticate",
        "description": "Request a short-lived ECR registry authorization token.",
        "grant": {
          "actions": ["ecr:GetAuthorizationToken"]
        },
        "binding": {
          "resource": {
            "resources": ["*"]
          }
        }
      },
      {
        "label": "pull-and-push-artifacts",
        "description": "Read and write image layers and manifests inside repositories owned by this registry resource.",
        "grant": {
          "actions": [
            "ecr:BatchCheckLayerAvailability",
            "ecr:GetDownloadUrlForLayer",
            "ecr:BatchGetImage",
            "ecr:DescribeRepositories",
            "ecr:DescribeImages",
            "ecr:ListImages",
            "ecr:CompleteLayerUpload",
            "ecr:UploadLayerPart",
            "ecr:InitiateLayerUpload",
            "ecr:PutImage"
          ]
        },
        "binding": {
          "resource": {
            "resources": ["arn:aws:ecr:${awsRegion}:${awsAccountId}:repository/${resourceName}-*"]
          }
        }
      }
    ],
    "gcp": [
      {
        "label": "pull-and-push-artifacts",
        "description": "Read and write artifacts and their OCI tags inside the selected Artifact Registry repository.",
        "grant": {
          "permissions": [
            "artifactregistry.repositories.get",
            "artifactregistry.repositories.list",
            "artifactregistry.repositories.downloadArtifacts",
            "artifactregistry.repositories.uploadArtifacts",
            "artifactregistry.tags.get",
            "artifactregistry.tags.list",
            "artifactregistry.tags.create",
            "artifactregistry.tags.update",
            "artifactregistry.versions.get",
            "artifactregistry.versions.list"
          ]
        },
        "binding": {
          "resource": {
            "scope": "projects/${projectName}/locations/${region}/repositories/${resourceName}"
          }
        }
      }
    ],
    "azure": [
      {
        "label": "pull-and-push-artifacts",
        "description": "Pull and push artifacts without registry control-plane or artifact deletion access.",
        "grant": {
          "predefinedRoles": ["AcrPush"]
        },
        "binding": {
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.ContainerRegistry/registries/${resourceName}"
          }
        }
      }
    ]
  }
}
