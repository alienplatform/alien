{
  "id": "kubernetes-public-endpoint/management",
  "description": "Allows Kubernetes public endpoint controllers to publish application-owned TLS certificates to ACM when the selected route profile requires it",
  "platforms": {
    "aws": [
      {
        "label": "import-kubernetes-endpoint-certificates",
        "description": "Import TLS certificates for application-owned Kubernetes public endpoints.",
        "grant": {
          "actions": ["acm:ImportCertificate", "acm:AddTagsToCertificate"]
        },
        "binding": {
          "resource": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "label": "manage-kubernetes-endpoint-certificates",
        "description": "Inspect, update, and delete TLS certificates owned by Kubernetes public endpoints.",
        "grant": {
          "actions": [
            "acm:ImportCertificate",
            "acm:AddTagsToCertificate",
            "acm:DeleteCertificate",
            "acm:DescribeCertificate",
            "acm:ListTagsForCertificate"
          ]
        },
        "binding": {
          "resource": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        // The delete above is tag-scoped, and a gone certificate has no tags, so the tag-scoped
        // describe is denied too. Granting it on certificates without the stack's tag lets a gone
        // certificate answer NotFound. It returns certificate metadata, never the private key.
        "label": "read-gone-tls-certificates",
        "description": "Describe ACM certificates that carry no deployment tag, so a deleted certificate answers NotFound.",
        "grant": {
          "actions": ["acm:DescribeCertificate"]
        },
        "binding": {
          "resource": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "Null": {
                "aws:ResourceTag/${stackTag}": "true"
              }
            }
          }
        }
      },
      {
        // ListCertificates supports no resource-level scoping or condition keys; AWS
        // evaluates it against `*` only. It returns certificate ARNs and domain names.
        // Used with ListTagsForCertificate to find a certificate whose import response
        // was lost by the create token it was tagged with.
        "label": "list-tls-certificates",
        "description": "List ACM certificates (AWS supports this action only on all resources).",
        "grant": {
          "actions": ["acm:ListCertificates"]
        },
        "binding": {
          "resource": {
            "resources": ["*"]
          }
        }
      }
    ]
  }
}
