{
  "id": "postgres/management",
  "description": "Allows describing and reconfiguring Postgres databases",
  "platforms": {
    "aws": [
      {
        "label": "read-aurora",
        "description": "Read cluster, instance and subnet group state.",
        "grant": {
          "actions": [
            "rds:DescribeDBClusters",
            "rds:DescribeDBSubnetGroups",
            "rds:ListTagsForResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*"
            ]
          }
        }
      },
      {
        // Every create path tags the cluster with the stack tag, so a stack named `app` cannot
        // change `app-prod`'s cluster.
        "label": "modify-aurora-cluster",
        "description": "Apply configuration changes to this application's Aurora cluster.",
        "grant": {
          "actions": ["rds:ModifyDBCluster", "rds:StartDBCluster"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // Instances the runtime controller created before it tagged them carry no tags;
        // IfExists keeps those working and denies instances tagged for another stack.
        "label": "modify-aurora-instances",
        "description": "Apply configuration changes to this application's Aurora instances.",
        "grant": {
          "actions": ["rds:ModifyDBInstance"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*"],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // The controller lists instances by DB cluster filter without an instance ID.
        // AWS evaluates that DescribeDBInstances request against "*".
        "label": "describe-database-instances",
        "description": "List the Aurora cluster's instances during management.",
        "grant": {
          "actions": ["rds:DescribeDBInstances"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      }
    ],
    "gcp": [
      {
        "label": "describe-and-modify-cloud-sql",
        "description": "Read instance state and apply configuration changes.",
        "grant": {
          "permissions": [
            "cloudsql.instances.get",
            "cloudsql.instances.list",
            "cloudsql.instances.update"
          ]
        },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      }
    ],
    "azure": [
      {
        "label": "describe-and-modify-flexible-server",
        "description": "Read server state and apply configuration changes.",
        "grant": {
          "actions": [
            "Microsoft.DBforPostgreSQL/flexibleServers/read",
            "Microsoft.DBforPostgreSQL/flexibleServers/write",
            "Microsoft.DBforPostgreSQL/flexibleServers/configurations/read",
            "Microsoft.DBforPostgreSQL/flexibleServers/configurations/write"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.DBforPostgreSQL/flexibleServers/${resourceName}"
          }
        }
      }
    ]
  }
}
