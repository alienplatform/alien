{
  "id": "postgres/provision",
  "description": "Allows provisioning and destroying Postgres databases",
  "platforms": {
    "aws": [
      // Metric alarms on the database's writer instance. A new alarm must carry this deployment's
      // tag, and an existing alarm may only be replaced, retagged or deleted while it carries
      // that tag, so another deployment's alarm whose name shares the prefix stays out of
      // reach. Alarm actions run as CloudWatch, not as this role, so no alarm may have any:
      // cloudwatch:AlarmActions covers AlarmActions, OKActions and InsufficientDataActions.
      {
        "grant": {
          "actions": ["cloudwatch:PutMetricAlarm"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "Null": { "cloudwatch:AlarmActions": "true" },
              "StringEquals": { "aws:RequestTag/${stackTag}": "${stackPrefix}" },
              "StringEqualsIfExists": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "Null": { "cloudwatch:AlarmActions": "true" },
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}"
              },
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      // TagResource on its own only retags an alarm that already carries this deployment's
      // tag. Creating an alarm with tags doesn't need it to match, so an untagged alarm under
      // the prefix can't be tagged into this deployment and then deleted.
      {
        "grant": {
          "actions": ["cloudwatch:TagResource"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}",
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["cloudwatch:DeleteAlarms"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "StringEquals": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      // The setup templates create a setup-owned cluster's writer alarms, and their alarm
      // handlers read an alarm and its tags back. Reads never reach another deployment's alarm.
      {
        "grant": {
          "actions": ["cloudwatch:DescribeAlarms", "cloudwatch:ListTagsForResource"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "StringEqualsIfExists": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          }
        }
      },
      {
        // Every create path (runtime controller, CloudFormation, Terraform) tags the cluster, subnet
        // group and cluster parameter group with the stack tag in the create request, so creates
        // bind on the request tag. CreateDBCluster is also authorized against the subnet group and
        // parameter group it names; this statement covers only the cluster, so those must carry
        // this stack's tag (manage-aurora-groups), whatever tags the request sends.
        "label": "create-aurora-cluster",
        "description": "Create the Aurora cluster.",
        "grant": {
          "actions": ["rds:CreateDBCluster"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        "label": "create-aurora-groups",
        "description": "Create the Aurora subnet group and cluster parameter group.",
        "grant": {
          "actions": ["rds:CreateDBSubnetGroup", "rds:CreateDBClusterParameterGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // Writer instances created by the runtime controller before it tagged them carry no tags,
        // and a controller older than this grant still creates them untagged. IfExists keeps both
        // working and denies an instance tagged for another stack.
        "label": "create-aurora-instances",
        "description": "Create the Aurora writer instance.",
        "grant": {
          "actions": ["rds:CreateDBInstance"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*"],
            "condition": {
              "StringEqualsIfExists": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // The stack tag decides, not the name: a stack named `app` cannot reach `app-prod-*`.
        // CreateDBInstance is also authorized against the cluster it joins, so an instance can
        // only join a cluster of this stack.
        "label": "manage-aurora-cluster",
        "description": "Change, start and delete this application's Aurora cluster.",
        "grant": {
          "actions": [
            "rds:CreateDBInstance",
            "rds:ModifyDBCluster",
            "rds:StartDBCluster",
            "rds:DeleteDBCluster"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // CloudFormation reads and sets a new parameter group's parameters, and creates the
        // cluster in the new groups, within seconds of creating them. RDS authorizes those calls
        // before the create-time tags are visible to it (a describe in the same second was denied
        // live), so the tag check is IfExists: a group tagged for another stack is still denied.
        // CreateDBCluster is authorized against the groups it names as well.
        "label": "manage-aurora-groups",
        "description": "Use, change and delete this application's Aurora subnet group and cluster parameter group.",
        "grant": {
          "actions": [
            "rds:CreateDBCluster",
            "rds:DescribeDBClusterParameters",
            "rds:ModifyDBClusterParameterGroup",
            "rds:ResetDBClusterParameterGroup",
            "rds:DeleteDBClusterParameterGroup",
            "rds:DeleteDBSubnetGroup"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // CloudFormation reboots the writer to apply pending-reboot cluster parameters. IfExists
        // keeps untagged runtime instances working (see create-aurora-instances).
        "label": "manage-aurora-instances",
        "description": "Change, restart and delete this application's Aurora instances.",
        "grant": {
          "actions": ["rds:ModifyDBInstance", "rds:RebootDBInstance", "rds:DeleteDBInstance"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*"],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // A create that carries tags is also authorized as AddTagsToResource on the new, untagged
        // object, so the existing-tag check is IfExists. An object tagged for another stack cannot
        // be tagged, and no request can set the stack tag to another stack.
        "label": "tag-aurora-resources",
        "description": "Tag the Aurora objects this application creates.",
        "grant": {
          "actions": ["rds:AddTagsToResource"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // CloudFormation removes tags dropped from the template. The ownership tags can never be
        // removed, so a stack cannot release an object for another stack to claim.
        "label": "untag-aurora-resources",
        "description": "Remove tags from this application's Aurora objects.",
        "grant": {
          "actions": ["rds:RemoveTagsFromResource"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              },
              "ForAllValues:StringNotEquals": {
                "aws:TagKeys": ["${stackTag}", "${resourceTag}", "${managedByTag}"]
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              },
              "ForAllValues:StringNotEquals": {
                "aws:TagKeys": ["${stackTag}", "${resourceTag}", "${managedByTag}"]
              }
            }
          }
        }
      },
      {
        "label": "read-aurora-resources",
        "description": "Read the Aurora cluster, instances, subnet group and cluster parameter group.",
        "grant": {
          "actions": [
            "rds:DescribeDBClusters",
            "rds:DescribeDBInstances",
            "rds:DescribeDBSubnetGroups",
            "rds:DescribeDBClusterParameterGroups",
            "rds:ListTagsForResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster:${stackPrefix}-${resourceName}",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:db:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:subgrp:${stackPrefix}-${resourceName}-*",
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ]
          }
        }
      },
      {
        // CloudFormation and Terraform read the group's current values when they create or
        // update it, to work out which values to change, and reset a value that a template no
        // longer sets (also on rollback). Limited to groups tagged for this stack, so a stack
        // whose name starts with this prefix is not reachable.
        "label": "update-cluster-parameters",
        "description": "Read and reset values of the Aurora cluster parameter group.",
        "grant": {
          "actions": ["rds:DescribeDBClusterParameters", "rds:ResetDBClusterParameterGroup"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:rds:${awsRegion}:${awsAccountId}:cluster-pg:${stackPrefix}-${resourceName}-*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}"
              }
            }
          }
        }
      },
      {
        // RDS creates this account-level role on the first cluster. The role is
        // shared across stacks, so restrict both its exact ARN and service.
        "label": "create-rds-service-linked-role",
        "description": "Allow RDS to create its default service-linked role in a new account.",
        "grant": {
          "actions": ["iam:CreateServiceLinkedRole"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS"
            ],
            "condition": {
              "StringEquals": {
                "iam:AWSServiceName": "rds.amazonaws.com"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS"
            ],
            "condition": {
              "StringEquals": {
                "iam:AWSServiceName": "rds.amazonaws.com"
              }
            }
          }
        }
      },
      {
        "label": "manage-connection-secret",
        "description": "Create and delete the generated connection-password secret.",
        "grant": {
          "actions": [
            "secretsmanager:CreateSecret",
            "secretsmanager:DeleteSecret",
            "secretsmanager:PutSecretValue",
            "secretsmanager:TagResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:secretsmanager:${awsRegion}:${awsAccountId}:secret:${stackPrefix}-*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:secretsmanager:${awsRegion}:${awsAccountId}:secret:${stackPrefix}-${resourceName}-*"
            ]
          }
        }
      },
      {
        // The Aurora cluster sits in a dedicated security group that admits 5432
        // only from the stack security group. AWS authorizes CreateSecurityGroup
        // against the target VPC as well as the new group, so the create leg
        // cannot be tag-conditioned; the paired CreateTags-on-create grant below
        // stamps the Alien boundary tags so every later mutation is tag-scoped.
        "label": "create-database-security-group",
        "description": "Create the dedicated database security group.",
        "grant": {
          "actions": ["ec2:CreateSecurityGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"
            ]
          }
        }
      },
      {
        "label": "tag-database-security-group",
        "description": "Stamp the Alien boundary tags on the database security group at creation.",
        "grant": {
          "actions": ["ec2:CreateTags"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSecurityGroup",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSecurityGroup",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceName}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        // The 5432-from-stack rule and teardown only touch the database security
        // group this application already owns, so they are gated on its tags.
        "label": "manage-database-security-group",
        "description": "Add the 5432 ingress rule and delete the database security group owned by this application.",
        "grant": {
          "actions": [
            "ec2:AuthorizeSecurityGroupIngress",
            "ec2:RevokeSecurityGroupIngress",
            "ec2:DeleteSecurityGroup"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceName}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        // The controller lists the cluster's instances with a db-cluster-id
        // filter (no instance identifier in the request), so IAM evaluates the
        // call against "*" (Describe* takes no resource-level ARN). Read-only,
        // no data-content access.
        "label": "describe-database-instances",
        "description": "List the Aurora cluster's instances by cluster filter.",
        "grant": {
          "actions": ["rds:DescribeDBInstances"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      }
    ],
    "gcp": [
      {
        // The instance is private-only behind Private Service Connect: the
        // controller reserves a consumer IP in the stack subnetwork and creates
        // a PSC forwarding rule targeting the Cloud SQL service attachment.
        "label": "manage-psc-consumer-endpoint",
        "description": "Reserve the PSC consumer IP and manage the forwarding rule to the Cloud SQL service attachment.",
        "grant": {
          "permissions": [
            "compute.addresses.create",
            "compute.addresses.createInternal",
            "compute.addresses.get",
            "compute.addresses.delete",
            "compute.addresses.deleteInternal",
            "compute.addresses.use",
            "compute.addresses.useInternal",
            "compute.forwardingRules.create",
            "compute.forwardingRules.get",
            "compute.forwardingRules.delete",
            "compute.forwardingRules.pscCreate",
            "compute.forwardingRules.pscDelete",
            "compute.subnetworks.use",
            "compute.networks.use",
            "compute.regionOperations.get",
            // PSC endpoint create/delete auto-(de)registers the endpoint in Service
            // Directory; the forwarding-rule ops fail without these.
            "servicedirectory.namespaces.create",
            "servicedirectory.namespaces.delete",
            "servicedirectory.services.create",
            "servicedirectory.services.delete",
            "servicedirectory.endpoints.create",
            "servicedirectory.endpoints.delete"
          ]
        },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      },
      {
        "label": "manage-cloud-sql-instance",
        "description": "Create, update and delete the Cloud SQL instance, its database, and the app user.",
        "grant": {
          "permissions": [
            "cloudsql.instances.create",
            "cloudsql.instances.update",
            "cloudsql.instances.delete",
            "cloudsql.instances.get",
            "cloudsql.instances.list",
            "cloudsql.databases.create",
            "cloudsql.databases.delete",
            "cloudsql.databases.get",
            // The instance create provisions only the built-in `postgres` superuser, so the `alien`
            // app user is created and its password set to match the connection secret.
            "cloudsql.users.create",
            "cloudsql.users.update"
          ]
        },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      },
      {
        "label": "create-connection-secret",
        // `secretmanager.secrets.create` cannot be IAM-conditioned on the secret name: the
        // secret does not exist yet at create time, so a `resource.name.startsWith(...)`
        // condition would evaluate against a non-existent resource and fail closed. This
        // mirrors `vault/data-write`, which likewise leaves `secrets.create` unconditioned.
        "description": "Create the connection-password secret.",
        "grant": {
          "permissions": ["secretmanager.secrets.create"]
        },
        "binding": {
          "stack": { "scope": "projects/${projectName}" },
          "resource": { "scope": "projects/${projectName}" }
        }
      },
      {
        "label": "write-connection-secret",
        // Versioning and deleting operate on an existing secret, so they ARE prefix-scoped to
        // the stack/resource secret name — the management identity can never version or delete
        // secrets outside its own deployment.
        "description": "Version and delete the generated connection-password secret.",
        "grant": {
          "permissions": ["secretmanager.secrets.delete", "secretmanager.versions.add"]
        },
        "binding": {
          "stack": {
            "scope": "projects/${projectName}",
            "condition": {
              "title": "StackPostgresSecretWrite",
              "expression": "(resource.type == \"secretmanager.googleapis.com/Secret\" || resource.type == \"secretmanager.googleapis.com/SecretVersion\") && resource.name.startsWith(\"projects/${projectNumber}/secrets/${stackPrefix}-\") && !resource.name.startsWith(\"projects/${projectNumber}/secrets/${stackPrefix}-deployer-secrets-\")"
            }
          },
          "resource": {
            "scope": "projects/${projectName}",
            "condition": {
              "title": "ResourcePostgresSecretWrite",
              "expression": "(resource.type == \"secretmanager.googleapis.com/Secret\" || resource.type == \"secretmanager.googleapis.com/SecretVersion\") && resource.name.startsWith(\"projects/${projectNumber}/secrets/${resourceName}-\") && !resource.name.startsWith(\"projects/${projectNumber}/secrets/${stackPrefix}-deployer-secrets-\")"
            }
          }
        }
      }
    ],
    "azure": [
      {
        // Async server updates return location-level operation URLs. Tracking them needs
        // resource-group scope even when the mutation is scoped to one server. These
        // operations return control-plane status, never database or secret contents.
        "label": "read-flexible-server-operations",
        "description": "Track asynchronous Flexible Server settings updates.",
        "grant": {
          "actions": [
            "Microsoft.DBforPostgreSQL/locations/azureAsyncOperation/read",
            "Microsoft.DBforPostgreSQL/locations/operationResults/read"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          }
        }
      },
      // No Key Vault secret grant here: the Azure controller stores the generated password in the
      // shared deployment "secrets" vault, whose data-plane writes are authored (vault-scoped) by
      // the secrets-vault preflight (management gets vault/data-write on it). A separate per-secret
      // grant would duplicate that write access, so provision relies on the shared-vault path.
      {
        "label": "manage-flexible-server",
        "description": "Create and delete the Flexible Server plus the private-networking it owns: the Private Endpoint and its DNS zone group, the private DNS zone, and the zone's VNet link.",
        "grant": {
          // The controller creates AND deletes each of these for a Live (Alien-owned) server, so
          // provision needs write+delete on all of them — including the private DNS zone, its VNet
          // link, and the Private Endpoint's DNS zone group — or teardown leaves orphans. All are
          // management-plane network actions (no dataActions); none expose secret contents.
          // flexibleServers and privateEndpoints also need `/read`: Azure completes both
          // asynchronously, so the controller polls the resource itself (server state to Ready /
          // Dropping-to-gone; PE to Succeeded before the DNS zone-group bind and to gone before
          // the server delete). The DNS-zone ops are LRO-confirmed and stay write+delete only.
          "actions": [
            "Microsoft.DBforPostgreSQL/flexibleServers/write",
            "Microsoft.DBforPostgreSQL/flexibleServers/delete",
            "Microsoft.DBforPostgreSQL/flexibleServers/read",
            "Microsoft.Network/privateEndpoints/write",
            "Microsoft.Network/privateEndpoints/read",
            "Microsoft.Network/privateEndpoints/delete",
            "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/write",
            "Microsoft.Network/privateEndpoints/privateDnsZoneGroups/delete",
            "Microsoft.Network/privateDnsZones/write",
            "Microsoft.Network/privateDnsZones/delete",
            "Microsoft.Network/privateDnsZones/virtualNetworkLinks/write",
            "Microsoft.Network/privateDnsZones/virtualNetworkLinks/delete"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.DBforPostgreSQL/flexibleServers/${resourceName}"
          }
        }
      }
    ]
  }
}
