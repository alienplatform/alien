{
  "id": "daemon/provision",
  "description": "Allows creating daemon infrastructure (cloud load balancers, public endpoint security groups, and certificates). Derived from cloud daemon controller API calls.",
  "platforms": {
    "aws": [
      // Metric alarms on the daemon's load balancer. A new alarm must carry this deployment's
      // tag, and an existing alarm may only be replaced, retagged or deleted while it carries
      // that tag, so another deployment's alarm whose name shares the prefix stays out of
      // reach. Alarm actions run as CloudWatch, not as this role, so no alarm may have any:
      // cloudwatch:AlarmActions covers AlarmActions, OKActions and InsufficientDataActions.
      {
        "grant": {
          "actions": [
            "cloudwatch:PutMetricAlarm",
            "cloudwatch:TagResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "Null": { "cloudwatch:AlarmActions": "true" },
              "StringEquals": { "aws:RequestTag/${stackTag}": "${stackPrefix}" },
              "StringEqualsIfExists": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          },
          "resource": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"],
            "condition": {
              "Null": { "cloudwatch:AlarmActions": "true" },
              "StringEquals": { "aws:RequestTag/${stackTag}": "${stackPrefix}" },
              "StringEqualsIfExists": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "cloudwatch:DeleteAlarms"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-*"],
            "condition": {
              "StringEquals": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          },
          "resource": {
            "resources": ["arn:aws:cloudwatch:${awsRegion}:${awsAccountId}:alarm:${stackPrefix}-${resourceName}-*"],
            "condition": {
              "StringEquals": { "aws:ResourceTag/${stackTag}": "${stackPrefix}" }
            }
          }
        }
      },
      {
        "label": "create-public-load-balancer",
        "description": "Create ALB resources for public daemon endpoints.",
        "grant": {
          "actions": [
            "elasticloadbalancing:CreateLoadBalancer",
            "elasticloadbalancing:CreateTargetGroup"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // AWS authorizes CreateListener against the load balancer, so the load balancer's tags
      // limit it to this stack's load balancers. AWS checks neither the target group nor the
      // certificate a listener names (no resource check and no condition key), so IAM cannot stop
      // this role from pointing this stack's own listeners at any target group in the same
      // account and VPC that no other load balancer uses, at a redirect to any URL or a fixed
      // response, or at any ACM certificate of the same account and region or IAM server
      // certificate of the account. The certificate's private key never leaves AWS. Other
      // accounts' target groups and certificates, other stacks' listeners and target groups
      // another load balancer uses stay out of reach.
      // IAM can bound the TLS policy and the protocol. A create must name both: an HTTPS
      // listener created without a policy gets ELBSecurityPolicy-2016-08, which allows TLS 1.0.
      // Both FIPS policies accept TLS 1.2 and 1.3 only; the PQ one adds post-quantum key exchange.
      {
        "label": "create-public-load-balancer-listener",
        "description": "Create the HTTPS listener on a daemon ALB of this stack.",
        "grant": {
          "actions": ["elasticloadbalancing:CreateListener"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "elasticloadbalancing:ListenerProtocol": "HTTPS",
                "elasticloadbalancing:SecurityPolicy": [
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-2023-04",
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-PQ-2025-09"
                ]
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "elasticloadbalancing:ListenerProtocol": "HTTPS",
                "elasticloadbalancing:SecurityPolicy": [
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-2023-04",
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-PQ-2025-09"
                ]
              }
            }
          }
        }
      },
      // The port 80 listener, which only redirects to HTTPS. IAM cannot see a listener's
      // actions, so it cannot tell the redirect from an HTTP listener that forwards: this role
      // could serve this stack's own ALB over plain HTTP, with the same target group limits as
      // above.
      {
        "label": "create-public-load-balancer-redirect-listener",
        "description": "Create the HTTP listener that redirects to HTTPS on a daemon ALB of this stack.",
        "grant": {
          "actions": ["elasticloadbalancing:CreateListener"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "elasticloadbalancing:ListenerProtocol": "HTTP"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime",
                "elasticloadbalancing:ListenerProtocol": "HTTP"
              }
            }
          }
        }
      },
      {
        "label": "tag-public-load-balancer-on-create",
        "description": "Allow tags supplied during daemon ALB resource creation. AWS authorizes tag-on-create through AddTags plus elasticloadbalancing:CreateAction.",
        "grant": {
          "actions": ["elasticloadbalancing:AddTags"]
        },
        "binding": {
          "stack": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              },
              "StringLike": {
                "elasticloadbalancing:CreateAction": "Create*"
              }
            }
          },
          "resource": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime"
              },
              "StringLike": {
                "elasticloadbalancing:CreateAction": "Create*"
              }
            }
          }
        }
      },
      {
        "label": "manage-public-load-balancer",
        "description": "Delete ALB resources owned by public daemon endpoints.",
        "grant": {
          "actions": [
            "elasticloadbalancing:DeleteLoadBalancer",
            "elasticloadbalancing:DeleteTargetGroup",
            "elasticloadbalancing:DeleteListener"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*",
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:targetgroup/*/*",
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:listener/app/*/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:loadbalancer/app/*/*",
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:targetgroup/*/*",
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:listener/app/*/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // Certificate rotation and TLS policy moves on this stack's HTTPS listeners, with the same
      // target group and certificate limits as CreateListener above. A modify that names neither
      // the TLS policy nor the protocol keeps the listener's own, so both are checked if present.
      {
        "label": "update-public-load-balancer-listener",
        "description": "Rotate the certificate and TLS policy of daemon ALB listeners.",
        "grant": {
          "actions": ["elasticloadbalancing:ModifyListener"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:listener/app/*/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              },
              "StringEqualsIfExists": {
                "elasticloadbalancing:SecurityPolicy": [
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-2023-04",
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-PQ-2025-09"
                ],
                "elasticloadbalancing:ListenerProtocol": "HTTPS"
              }
            }
          },
          "resource": {
            "resources": [
              "arn:aws:elasticloadbalancing:${awsRegion}:${awsAccountId}:listener/app/*/*/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              },
              "StringEqualsIfExists": {
                "elasticloadbalancing:SecurityPolicy": [
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-2023-04",
                  "ELBSecurityPolicy-TLS13-1-2-FIPS-PQ-2025-09"
                ],
                "elasticloadbalancing:ListenerProtocol": "HTTPS"
              }
            }
          }
        }
      },
      {
        "label": "inspect-public-load-balancer",
        "description": "Inspect ALB resources for daemon endpoint status and cleanup.",
        "grant": {
          "actions": [
            "elasticloadbalancing:DescribeLoadBalancers",
            "elasticloadbalancing:DescribeTargetGroups",
            "elasticloadbalancing:DescribeTargetHealth",
            "elasticloadbalancing:DescribeListeners"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      },
      {
        "label": "create-public-load-balancer-security-group",
        "description": "Create the runtime-owned ALB security group for public daemon endpoints.",
        "grant": {
          "actions": ["ec2:CreateSecurityGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"
            ]
          },
          "resource": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"
            ]
          }
        }
      },
      {
        "label": "tag-public-load-balancer-security-group",
        "description": "Apply runtime boundary tags while creating the daemon ALB security group.",
        "grant": {
          "actions": ["ec2:CreateTags"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSecurityGroup",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSecurityGroup",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "label": "manage-public-load-balancer-security-group",
        "description": "Open HTTPS ingress on, revoke rules from, and delete the runtime-owned ALB security group.",
        "grant": {
          "actions": [
            "ec2:AuthorizeSecurityGroupIngress",
            "ec2:RevokeSecurityGroupIngress",
            "ec2:DeleteSecurityGroup"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "label": "manage-compute-cluster-ingress",
        "description": "Add and remove the ALB-to-managed-compute host-port rule on the setup-owned ComputeCluster security group.",
        "grant": {
          "actions": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/resource-type": "compute-cluster",
                "aws:ResourceTag/${managedByTag}": "setup"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/resource-type": "compute-cluster",
                "aws:ResourceTag/${managedByTag}": "setup"
              }
            }
          }
        }
      },
      {
        "label": "inspect-network-security-groups",
        "description": "Read VPC and security group metadata needed to attach daemon public endpoints.",
        "grant": {
          "actions": ["ec2:DescribeSecurityGroups", "ec2:DescribeVpcs"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      },
      {
        "label": "create-elb-service-linked-role",
        "description": "Allow AWS to create the Elastic Load Balancing service-linked role required the first time an account creates an ELB resource.",
        "grant": {
          "actions": ["iam:CreateServiceLinkedRole"]
        },
        "binding": {
          "stack": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
              }
            }
          },
          "resource": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
              }
            }
          }
        }
      },
      {
        "label": "import-tls-certificates",
        "description": "Import TLS certificates for daemon-owned HTTPS endpoints.",
        "grant": {
          "actions": ["acm:ImportCertificate"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${resourceTag}": "${resourceId}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "label": "manage-tls-certificates",
        "description": "Inspect and delete TLS certificates owned by daemon public endpoints.",
        "grant": {
          "actions": [
            "acm:AddTagsToCertificate",
            "acm:DeleteCertificate",
            "acm:DescribeCertificate",
            "acm:ListTagsForCertificate"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          },
          "resource": {
            "resources": ["arn:aws:acm:${awsRegion}:${awsAccountId}:certificate/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${resourceTag}": "${resourceId}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        // ListCertificates supports no resource-level scoping or condition keys; AWS
        // evaluates it against `*` only. It returns certificate ARNs and domain names.
        // Used with ListTagsForCertificate to find a certificate whose import response
        // was lost by the create token it was tagged with.
        "label": "list-tls-certificates",
        "description": "List ACM certificates (AWS supports this action only on all resources).",
        "grant": {
          "actions": ["acm:ListCertificates"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          },
          "resource": {
            "resources": ["*"]
          }
        }
      }
    ],
    "gcp": [
      {
        "label": "manage-public-https-load-balancer",
        "description": "Create, update, inspect, and delete Google Cloud HTTPS load-balancer resources used by daemon public endpoints.",
        "grant": {
          "permissions": [
            "compute.sslCertificates.create",
            "compute.sslCertificates.delete",
            "compute.sslCertificates.get",
            "compute.healthChecks.create",
            "compute.healthChecks.delete",
            "compute.healthChecks.get",
            "compute.healthChecks.update",
            "compute.healthChecks.useReadOnly",
            "compute.networkEndpointGroups.create",
            "compute.networkEndpointGroups.delete",
            "compute.networkEndpointGroups.get",
            "compute.networkEndpointGroups.use",
            "compute.backendServices.create",
            "compute.backendServices.delete",
            "compute.backendServices.get",
            "compute.backendServices.update",
            "compute.backendServices.use",
            "compute.urlMaps.create",
            "compute.urlMaps.delete",
            "compute.urlMaps.get",
            "compute.urlMaps.use",
            "compute.targetHttpsProxies.create",
            "compute.targetHttpsProxies.delete",
            "compute.targetHttpsProxies.get",
            "compute.targetHttpsProxies.setSslCertificates",
            "compute.targetHttpsProxies.use",
            "compute.globalAddresses.create",
            "compute.globalAddresses.delete",
            "compute.globalAddresses.get",
            "compute.globalAddresses.use",
            "compute.globalForwardingRules.create",
            "compute.globalForwardingRules.delete",
            "compute.globalForwardingRules.get",
            "compute.zones.list"
          ]
        },
        "binding": {
          "stack": {
            "scope": "projects/${projectName}"
          },
          "resource": {
            "scope": "projects/${projectName}"
          }
        }
      }
    ],
    "azure": [
      {
        "label": "manage-public-application-gateway",
        "description": "Create, update, inspect, and delete Azure public IPs, identities, role assignments, and Application Gateways for daemon public endpoints.",
        "grant": {
          "actions": [
            "Microsoft.Network/applicationGateways/write",
            "Microsoft.Network/applicationGateways/read",
            "Microsoft.Network/applicationGateways/delete",
            "Microsoft.ManagedIdentity/userAssignedIdentities/read",
            "Microsoft.ManagedIdentity/userAssignedIdentities/write",
            "Microsoft.ManagedIdentity/userAssignedIdentities/delete",
            "Microsoft.ManagedIdentity/userAssignedIdentities/assign/action",
            "Microsoft.Authorization/roleAssignments/read",
            "Microsoft.Authorization/roleAssignments/write",
            "Microsoft.Authorization/roleAssignments/delete",
            "Microsoft.Network/publicIPAddresses/write",
            "Microsoft.Network/publicIPAddresses/read",
            "Microsoft.Network/publicIPAddresses/delete",
            // Every gateway PUT re-checks join on its App Gateway subnet and frontend public IP.
            // https://learn.microsoft.com/azure/application-gateway/configuration-infrastructure
            "Microsoft.Network/publicIPAddresses/join/action",
            "Microsoft.Network/virtualNetworks/subnets/read",
            "Microsoft.Network/virtualNetworks/subnets/join/action"
          ]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          },
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          }
        }
      }
    ]
  }
}
