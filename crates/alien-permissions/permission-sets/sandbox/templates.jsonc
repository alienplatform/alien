{
  "id": "sandbox/templates",
  "description": "Allows creating and replacing the image a sandbox launches from under its setup-created parent (no access to sandbox contents)",
  "platforms": {
    "gcp": [
      {
        // A Frozen sandbox's engine is setup-owned but its template is release-owned: the manager
        // creates the first one and replaces it when the image changes. No reasoningEngines verb,
        // so the holder cannot create or delete the engine, and no sandboxEnvironments verb, so it
        // cannot reach a live session.
        "label": "sandbox-templates",
        "description": "Create, read and delete environment templates under the selected reasoning engine.",
        "grant": {
          "permissions": [
            "aiplatform.sandboxEnvironmentTemplates.create",
            "aiplatform.sandboxEnvironmentTemplates.delete",
            "aiplatform.sandboxEnvironmentTemplates.get",
            "aiplatform.sandboxEnvironmentTemplates.list"
          ]
        },
        // The engine only: project scope would let the manager replace a sibling sandbox's image.
        "binding": {
          "resource": {
            "scope": "projects/${projectName}/locations/${region}/reasoningEngines/${resourceName}"
          }
        }
      }
    ]
  }
}
