{
  "id": "sandbox/protect-setup-roles",
  "description": "Refuses changes to the IAM roles setup creates for one sandbox",
  "platforms": {
    "aws": [
      {
        // Role writes other sets grant on `role/${stackPrefix}-*` match these names, and provision
        // may pass the build role, so this Deny stops management rewriting a role it can run code
        // under. Named per sandbox because `*-build` also matches a Build's role; PassRole stays.
        "effect": "Deny",
        "grant": {
          "actions": [
            "iam:CreateRole",
            "iam:DeleteRole",
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:AttachRolePolicy",
            "iam:DetachRolePolicy",
            "iam:UpdateAssumeRolePolicy",
            "iam:PutRolePermissionsBoundary",
            "iam:DeleteRolePermissionsBoundary",
            "iam:UpdateRole",
            "iam:TagRole",
            "iam:UntagRole"
          ]
        },
        "binding": {
          "resource": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}-build",
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-${resourceName}-egress"
            ]
          }
        }
      }
    ]
  }
}
