{
  "id": "sandbox/protect-setup-roles",
  "description": "Refuses changes to the IAM roles setup creates for sandboxes",
  "platforms": {
    "aws": [
      {
        // Other sets grant role writes on `role/${stackPrefix}-*`, and provision may pass a
        // sandbox's build role, so management could rewrite a role it runs code under. Matched by
        // setup's tags, not names: a template may name these roles itself, and a sibling
        // deployment's prefix can collide with this one's. PassRole stays.
        "label": "deny-sandbox-setup-role-changes",
        "effect": "Deny",
        "grant": {
          "actions": [
            "iam:DeleteRole",
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:AttachRolePolicy",
            "iam:DetachRolePolicy",
            "iam:UpdateAssumeRolePolicy",
            "iam:PutRolePermissionsBoundary",
            "iam:DeleteRolePermissionsBoundary",
            "iam:UpdateRole",
            "iam:TagRole",
            "iam:UntagRole"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${managedByTag}": "setup",
                "aws:ResourceTag/resource-type": "sandbox"
              }
            }
          }
        }
      }
    ]
  }
}
