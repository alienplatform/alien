{
  "id": "sandbox/protect-bundle-policy",
  "description": "Keeps a workload from changing the policy of the bucket sandbox images are built from",
  "platforms": {
    "aws": [
      {
        // The sandbox bundle bucket's policy is what keeps every principal but management from
        // writing the bundles sandbox images are built from. Preflights add this to a workload
        // profile that can manage the stack's bucket policies, so that grant cannot lift it.
        // Setup and management never hold it: they set that policy.
        "label": "deny-sandbox-bundle-bucket-policy-changes",
        "effect": "Deny",
        "grant": {
          "actions": ["s3:PutBucketPolicy", "s3:DeleteBucketPolicy"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:s3:::${stackPrefix}-sandbox-bundles*"]
          },
          "resource": {
            "resources": ["arn:aws:s3:::${stackPrefix}-sandbox-bundles*"]
          }
        }
      }
    ]
  }
}
