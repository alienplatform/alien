{
  "id": "sandbox/protect-bundle-policy",
  "description": "Keeps a workload from changing the policy of, or deleting, the bucket sandbox images are built from",
  "platforms": {
    "aws": [
      {
        // The sandbox bundle bucket's policy is what keeps every principal but management from
        // writing the bundles sandbox images are built from. Preflights add this to every
        // workload profile of a stack that holds the bucket, so no grant, built-in or inline,
        // can lift it or delete the bucket and create one of the same name without the policy.
        // Setup and management never hold it: they set that policy and own the bucket.
        "label": "deny-sandbox-bundle-bucket-policy-changes",
        "effect": "Deny",
        "grant": {
          "actions": ["s3:PutBucketPolicy", "s3:DeleteBucketPolicy", "s3:DeleteBucket"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:s3:::${stackPrefix}-sandbox-bundles*"]
          },
          "resource": {
            "resources": ["arn:aws:s3:::${stackPrefix}-sandbox-bundles*"]
          }
        }
      }
    ]
  }
}
