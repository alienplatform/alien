{
  "id": "sandbox/images",
  "description": "Allows building, reading and deleting the disk images a sandbox starts from, under its setup-created parent (no access to sandbox contents)",
  "platforms": {
    "azure": [
      {
        // The manager builds a registry image into a disk image before any sandbox starts from
        // it, and deletes the one a changed reference replaced. Disk-image verbs only: no sandbox
        // is created, read or reached, so the data-plane role `sandbox/execute` carries stays
        // the only way into a session.
        "description": "Allows creating, reading and deleting disk images under the selected sandbox group.",
        "grant": {
          "dataActions": [
            "Microsoft.App/sandboxGroups/diskimages/read",
            "Microsoft.App/sandboxGroups/diskimages/write",
            "Microsoft.App/sandboxGroups/diskimages/delete"
          ]
        },
        // The group only: at resource-group scope the manager could replace a sibling sandbox's
        // image.
        "binding": {
          "resource": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}/providers/Microsoft.App/sandboxGroups/${resourceName}"
          }
        }
      }
    ]
  }
}
