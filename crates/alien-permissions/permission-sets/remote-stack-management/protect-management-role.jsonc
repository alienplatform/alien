{
  "id": "remote-stack-management/protect-management-role",
  "description": "Refuses the management identity any change to its own IAM role",
  "platforms": {
    "aws": [
      {
        "label": "bounded-role-protect-boundary",
        "effect": "Deny",
        "grant": {
          "actions": [
            "iam:CreatePolicyVersion",
            "iam:SetDefaultPolicyVersion",
            "iam:DeletePolicyVersion",
            "iam:DeletePolicy",
            "iam:TagPolicy",
            "iam:UntagPolicy",
            "iam:DeleteRolePermissionsBoundary"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "${awsPermissionsBoundaryArn}",
              "arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*"
            ]
          }
        }
      },
      {
        // Other sets grant role writes on `role/${stackPrefix}-*`, which names this role too, and
        // only setup changes it. The same grants still reach the other `${stackPrefix}-*` roles.
        "label": "deny-management-role-changes",
        "effect": "Deny",
        "grant": {
          "actions": [
            "iam:DeleteRole",
            "iam:PutRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:AttachRolePolicy",
            "iam:DetachRolePolicy",
            "iam:UpdateAssumeRolePolicy",
            "iam:PutRolePermissionsBoundary",
            "iam:DeleteRolePermissionsBoundary",
            "iam:UpdateRole",
            "iam:TagRole",
            "iam:UntagRole"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-management"]
          }
        }
      },
      {
        // The management role's own managed policies decide what it may do, and only setup
        // changes them. A grant on `policy/${stackPrefix}-*` or on the CloudFormation policy
        // names would otherwise let the role write a new version of its own policy. Rendered for
        // a protected install only.
        "label": "signing-only-setup-changes-management-policies",
        "effect": "Deny",
        "grant": {
          "actions": [
            "iam:CreatePolicyVersion",
            "iam:SetDefaultPolicyVersion",
            "iam:DeletePolicyVersion",
            "iam:DeletePolicy"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-ManagementRole*",
              "arn:aws:iam::${awsAccountId}:policy/${stackPrefix}-deployment-management-*"
            ]
          }
        }
      },
      {
        // Signing settings, ledgers and signed inputs live under `/signed/`, and only setup
        // writes them. No grant reaches the path today; this holds if a later one does, and is
        // harmless on installs without signing.
        "label": "only-setup-changes-signing-settings",
        "effect": "Deny",
        "grant": {
          "actions": [
            "ssm:PutParameter",
            "ssm:DeleteParameter",
            "ssm:DeleteParameters",
            "ssm:LabelParameterVersion",
            "ssm:UnlabelParameterVersion",
            "ssm:AddTagsToResource",
            "ssm:RemoveTagsFromResource"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ssm:*:*:parameter/signed/*"]
          }
        }
      }
    ]
  }
}
