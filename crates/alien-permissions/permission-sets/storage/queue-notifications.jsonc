{
  "id": "storage/queue-notifications",
  "description": "Allows reconciling EventBridge rules for storage notifications into queues",
  "platforms": {
    "aws": [
      {
        "grant": {
          "actions": [
            "events:PutRule",
            "events:DescribeRule",
            "events:DeleteRule",
            "events:PutTargets",
            "events:ListTargetsByRule",
            "events:RemoveTargets"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:events:${awsRegion}:${awsAccountId}:rule/${stackPrefix}-sn-*"]
          },
          "resource": {
            "resources": ["arn:aws:events:${awsRegion}:${awsAccountId}:rule/${stackPrefix}-sn-*"]
          }
        }
      }
    ]
  }
}
