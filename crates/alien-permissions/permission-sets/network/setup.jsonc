{
  "id": "network/setup",
  "description": "Allows setup to create and delete a created network's VPC flow log, the log group it writes to and the role the VPC flow logs service assumes",
  // Setup credentials only: the flow log is part of the network, which setup creates, so
  // the management identity never needs these. Creating a role and writing its policy cannot
  // be limited to what the role may do either. Automatic setup management copies only
  // provision, management, heartbeat and telemetry sets to the management identity.
  "platforms": {
    "aws": [
      // The created VPC's flow log. AWS also authorizes the create against the VPC, which must
      // already carry this network's tags. A tagged create also needs the tagging action.
      {
        "grant": {
          "actions": ["ec2:CreateFlowLogs"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc-flow-log/*"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["ec2:CreateFlowLogs"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["ec2:CreateTags"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc-flow-log/*"],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateFlowLogs",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["ec2:DeleteFlowLogs"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc-flow-log/*"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // AWS requires Resource: "*" for this read-only discovery API.
      {
        "grant": {
          "actions": ["ec2:DescribeFlowLogs"]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          }
        }
      },
      // CreateLogGroup with tags also authorizes the tagging actions. They are limited to a
      // group without this stack's tag, which is the group being created: a group that already
      // carries ownership tags, such as one a template setup made, cannot be retagged.
      {
        "grant": {
          "actions": ["logs:CreateLogGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:${stackPrefix}-*-flow-logs"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["logs:TagResource", "logs:TagLogGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:${stackPrefix}-*-flow-logs"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              },
              "Null": {
                "aws:ResourceTag/${stackTag}": "true"
              }
            }
          }
        }
      },
      // Reading the tags tells this network's group from another with the same name.
      {
        "grant": {
          "actions": ["logs:ListTagsForResource"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:${stackPrefix}-*-flow-logs"
            ]
          }
        }
      },
      {
        "grant": {
          "actions": ["logs:PutRetentionPolicy", "logs:DeleteLogGroup"]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:logs:${awsRegion}:${awsAccountId}:log-group:${stackPrefix}-*-flow-logs"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["iam:CreateRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-flow-logs"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // CreateRole with tags also authorizes TagRole, and IAM checks it with the new role's
      // tags as its resource tags. IfExists keeps that working while a role that carries
      // another deployment's or a template setup's tags cannot be retagged into this network's.
      {
        "grant": {
          "actions": ["iam:TagRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-flow-logs"],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              },
              "StringEqualsIfExists": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": ["iam:GetRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:DeleteRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-flow-logs"],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // CreateFlowLogs checks PassRole without aws:ResourceTag in the request context, so the
      // role's tags are matched with IAM's own iam:ResourceTag key.
      {
        "grant": {
          "actions": ["iam:PassRole"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:iam::${awsAccountId}:role/${stackPrefix}-*-flow-logs"],
            "condition": {
              "StringEquals": {
                "iam:PassedToService": "vpc-flow-logs.amazonaws.com",
                "iam:ResourceTag/${stackTag}": "${stackPrefix}",
                "iam:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      }
    ]
  }
}
