{
  "id": "network/provision",
  "description": "Allows creating, deleting, and managing network infrastructure (VPCs, subnets, NAT gateways, route tables, security groups)",
  // Note: Network has only "stack" binding since it's shared infrastructure.
  // Resource-scoped permissions don't apply - this is used by the management profile.
  "platforms": {
    "aws": [
      // Create operations must include Alien boundary tags in the request.
      {
        "grant": {
          "actions": [
            "ec2:CreateVpc",
            "ec2:CreateInternetGateway",
            "ec2:CreateSubnet",
            "ec2:CreateRouteTable",
            "ec2:CreateNatGateway",
            "ec2:AllocateAddress",
            "ec2:CreateSecurityGroup"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:internet-gateway/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:subnet/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:route-table/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:natgateway/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:elastic-ip/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // Tag-on-create grants name the creation action; later tagging requires ownership.
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateVpc",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:internet-gateway/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateInternetGateway",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:subnet/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSubnet",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:route-table/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateRouteTable",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:natgateway/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateNatGateway",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:elastic-ip/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "AllocateAddress",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      {
        "grant": {
          "actions": [
            "ec2:CreateTags"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"
            ],
            "condition": {
              "StringEquals": {
                "ec2:CreateAction": "CreateSecurityGroup",
                "aws:RequestTag/${stackTag}": "${stackPrefix}",
                "aws:RequestTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // AWS also authorizes these creates against the parent: the VPC for subnets, route
      // tables and security groups, the subnet and Elastic IP for NAT gateways. Request tags
      // don't apply to a parent, so the parent must already carry this network's tags.
      {
        "grant": {
          "actions": [
            "ec2:CreateSubnet",
            "ec2:CreateRouteTable",
            "ec2:CreateSecurityGroup",
            "ec2:CreateNatGateway"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:subnet/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:elastic-ip/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // Existing network resources can be changed only after they carry Alien boundary tags.
      {
        "grant": {
          "actions": [
            "ec2:CreateTags",
            "ec2:DeleteVpc",
            "ec2:ModifyVpcAttribute",
            "ec2:DeleteInternetGateway",
            "ec2:AttachInternetGateway",
            "ec2:DetachInternetGateway",
            "ec2:DeleteSubnet",
            "ec2:DeleteRouteTable",
            "ec2:CreateRoute",
            "ec2:DeleteRoute",
            "ec2:AssociateRouteTable",
            "ec2:DisassociateRouteTable",
            "ec2:DeleteNatGateway",
            "ec2:ReleaseAddress",
            "ec2:DeleteSecurityGroup",
            "ec2:AuthorizeSecurityGroupIngress",
            "ec2:AuthorizeSecurityGroupEgress",
            "ec2:RevokeSecurityGroupIngress",
            "ec2:RevokeSecurityGroupEgress",
            "ec2:DescribeVpcAttribute"
          ]
        },
        "binding": {
          "stack": {
            "resources": [
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:vpc/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:internet-gateway/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:subnet/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:route-table/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:natgateway/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:elastic-ip/*",
              "arn:aws:ec2:${awsRegion}:${awsAccountId}:security-group/*"
            ],
            "condition": {
              "StringEquals": {
                "aws:ResourceTag/${stackTag}": "${stackPrefix}",
                "aws:ResourceTag/${managedByTag}": "runtime"
              }
            }
          }
        }
      },
      // Delete removes detached network interfaces Lambda leaves in this network's subnets;
      // they block deleting the security group, subnets and VPC and never go away on their own.
      // It cannot be scoped further: Lambda's interfaces carry no Alien tags, so no tag condition
      // matches them, and ec2:Vpc / ec2:Subnet conditions would need the VPC ID, which a created
      // network only gets at runtime. EC2 refuses to delete an attached interface, and the
      // controller deletes only interfaces that are available, AWS-managed and of type `lambda`,
      // in its own security group and subnets.
      {
        "grant": {
          "actions": ["ec2:DeleteNetworkInterface"]
        },
        "binding": {
          "stack": {
            "resources": ["arn:aws:ec2:${awsRegion}:${awsAccountId}:network-interface/*"]
          }
        }
      },
      // AWS requires Resource: "*" for these read-only discovery APIs.
      {
        "grant": {
          "actions": [
            "ec2:DescribeVpcs",
            "ec2:DescribeAvailabilityZones",
            "ec2:DescribeInternetGateways",
            "ec2:DescribeSubnets",
            "ec2:DescribeRouteTables",
            "ec2:DescribeNatGateways",
            "ec2:DescribeAddresses",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSecurityGroupRules",
            "ec2:DescribeNetworkInterfaces",
            "ec2:DescribeTags",
            "servicequotas:GetServiceQuota"
          ]
        },
        "binding": {
          "stack": {
            "resources": ["*"]
          }
        }
      }
    ],
    "gcp": [
      {
        "grant": {
          "permissions": [
            // Network operations
            "compute.networks.create",
            "compute.networks.delete",
            "compute.networks.get",
            "compute.networks.list",
            "compute.networks.update",
            "compute.networks.updatePolicy",
            // Subnetwork operations
            "compute.subnetworks.create",
            "compute.subnetworks.delete",
            "compute.subnetworks.get",
            "compute.subnetworks.list",
            "compute.subnetworks.update",
            "compute.subnetworks.setPrivateIpGoogleAccess",
            // Router operations (for Cloud NAT)
            "compute.routers.create",
            "compute.routers.delete",
            "compute.routers.get",
            "compute.routers.list",
            "compute.routers.update",
            // Firewall operations
            "compute.firewalls.create",
            "compute.firewalls.delete",
            "compute.firewalls.get",
            "compute.firewalls.list",
            "compute.firewalls.update",
            // Operation tracking
            "compute.globalOperations.get",
            "compute.globalOperations.list",
            "compute.regionOperations.get",
            "compute.regionOperations.list",
            // Project access
            "resourcemanager.projects.get"
          ]
        },
        // Compute/VPC/Network does not support resource-level IAM.
        // Resource binding is the same as stack (project-level).
        "binding": {
          "stack": {
            "scope": "projects/${projectName}"
          },
          "resource": {
            "scope": "projects/${projectName}"
          }
        }
      }
    ],
    "azure": [
      {
        "grant": {
          "predefinedRoles": ["Network Contributor"]
        },
        "binding": {
          "stack": {
            "scope": "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroup}"
          }
        }
      }
    ]
  }
}
