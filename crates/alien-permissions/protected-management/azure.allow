# What a protected Azure install accepts in the management roles.
#
# Azure's deny settings refuse writes and deletes at the install's resource group, but not an
# `/action` and not the data plane, so what management's roles may name is limited here.
#
# Data-plane actions, checked for every permission set rendered into a management role, built-in or
# not, whether setup creates the role or the runtime assigns it. The runtime's role-assignment
# condition can't name the scope it assigns at, so a role it may assign can land on the signing
# vault, whose secrets hold the ledger and the signed inputs. This file goes once the signing vault
# has its own resource group.
#
# Format: `data <pattern>  # reason`. A requested pattern is covered when this file's
# pattern matches it with the requested pattern's own `*` and `?` taken as literal characters,
# so `*/read` covers `Microsoft.Storage/storageAccounts/read` but not `Microsoft.Storage/*`.
# Every line needs a reason. Key Vault secret reads and writes and certificate writes are
# deliberately absent: a vault's secrets hold the signing ledger and the signed inputs.

data Microsoft.Storage/storageAccounts/blobServices/containers/blobs/read    # reads blobs
data Microsoft.Storage/storageAccounts/blobServices/containers/blobs/write   # writes blobs
data Microsoft.Storage/storageAccounts/blobServices/containers/blobs/delete  # deletes blobs
data Microsoft.Storage/storageAccounts/tableServices/tables/entities/read    # reads table entities
data Microsoft.Storage/storageAccounts/tableServices/tables/entities/write   # writes table entities
data Microsoft.Storage/storageAccounts/tableServices/tables/entities/delete  # deletes table entities
data Microsoft.Storage/storageAccounts/tableServices/tables/entities/add/action     # adds a table entity
data Microsoft.Storage/storageAccounts/tableServices/tables/entities/update/action  # updates a table entity
data Microsoft.ServiceBus/namespaces/messages/send/action     # sends a queue message
data Microsoft.ServiceBus/namespaces/messages/receive/action  # receives a queue message
data Microsoft.KeyVault/vaults/secrets/readMetadata/action    # lists secret metadata
data Microsoft.KeyVault/vaults/keys/read                      # reads key metadata
data Microsoft.KeyVault/vaults/keys/encrypt/action            # encrypts with an existing key
data Microsoft.KeyVault/vaults/keys/decrypt/action            # decrypts with an existing key
# Sandbox image and sandbox writes (`diskimages/write`, `sandboxes/write`) are the verifier's:
# they decide what a sandbox runs.
data Microsoft.App/sandboxGroups/diskimages/read              # sandbox images (built-in sandbox sets)
data Microsoft.App/sandboxGroups/diskimages/delete            # sandbox images (built-in sandbox sets)
data Microsoft.App/sandboxGroups/sandboxes/read               # sandboxes (built-in sandbox sets)
data Microsoft.App/sandboxGroups/sandboxes/count/read         # sandboxes (built-in sandbox sets)
data Microsoft.App/sandboxGroups/sandboxes/delete             # sandboxes (built-in sandbox sets)

