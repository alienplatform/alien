# What a protected GCP install accepts in the management roles.
#
# - `role`: predefined roles, exact names. Checked for every permission set rendered for the
#   management identity, built-in or not: a predefined role can't be narrowed, so a role that is not
#   listed (a broad one such as `roles/editor`, or one GCP adds later) is refused.
# - `permission`: permissions of a custom role. Checked for every permission set except the
#   built-in sets `held-sets.allow` names, which are reviewed separately and filtered by the
#   verifier-owned list.
#
# Format: `<kind> <pattern or name>  # reason`. A requested permission is covered when this
# file's pattern matches it, with `*` matching any run of characters. Every line needs a reason.
# Secret Manager values are not listed: setup's conditions keep `signed-` secrets from every
# Secret Manager grant, and a stack that needs a secret value uses a listed role.

role roles/artifactregistry.reader            # pulls images
role roles/cloudkms.cryptoKeyEncrypterDecrypter  # encrypts and decrypts with an existing key
role roles/cloudkms.viewer                    # reads key metadata
role roles/datastore.user                     # reads and writes entities
role roles/datastore.viewer                   # reads entities
role roles/iam.roleViewer                     # reads role definitions
role roles/iam.serviceAccountViewer           # reads service accounts
role roles/logging.logWriter                  # writes log entries
role roles/pubsub.publisher                   # publishes messages
role roles/pubsub.subscriber                  # consumes messages
role roles/pubsub.viewer                      # reads topics and subscriptions
role roles/run.invoker                        # calls services as released
role roles/run.viewer                         # reads services and jobs
role roles/secretmanager.secretAccessor       # reads secret values; setup's condition leaves out `signed-` secrets
role roles/secretmanager.secretVersionAdder   # adds secret versions; setup's condition leaves out `signed-` secrets
role roles/secretmanager.viewer               # reads secret metadata
role roles/serviceusage.serviceUsageAdmin     # enables APIs
role roles/serviceusage.serviceUsageViewer    # reads enabled APIs
role roles/storage.bucketViewer               # reads bucket metadata
role roles/storage.objectAdmin                # object data; a bucket's IAM policy is another permission
role roles/storage.objectCreator              # creates objects
role roles/storage.objectViewer               # reads objects

permission *.get                              # reads
permission *.list                             # reads
permission storage.objects.create             # writes an object
permission storage.objects.update             # updates an object
permission storage.objects.delete             # deletes an object
permission pubsub.topics.publish              # publishes a message
permission pubsub.subscriptions.consume       # consumes a message
permission datastore.entities.create          # writes an entity
permission datastore.entities.update          # updates an entity
permission datastore.entities.delete          # deletes an entity
permission logging.logEntries.create          # writes log entries
permission monitoring.timeSeries.create       # writes metric points
permission cloudkms.cryptoKeyVersions.useToEncrypt  # encrypts with an existing key
permission cloudkms.cryptoKeyVersions.useToDecrypt  # decrypts with an existing key
permission run.routes.invoke                  # calls a service as released
