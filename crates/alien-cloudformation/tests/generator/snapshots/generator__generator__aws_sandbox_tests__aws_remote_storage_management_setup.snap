---
source: crates/alien-cloudformation/tests/generator/aws_sandbox_tests.rs
expression: yaml
---
AWSTemplateFormatVersion: 2010-09-09
Description: remote storage management
Transform:
- AWS::LanguageExtensions
Metadata:
  AWS::CloudFormation::Interface:
    ParameterGroups:
    - Label:
        default: Registration
      Parameters:
      - Token
      - ManagingRoleArn
    ParameterLabels:
      ManagingRoleArn:
        default: Management role ARN
      Token:
        default: Install token
Parameters:
  Token:
    Type: String
    Description: Install token from the application setup page.
    NoEcho: true
  ManagingRoleArn:
    Type: String
    Description: ARN of the management identity allowed to assume setup-created roles.
Resources:
  CustomerData:
    Type: AWS::S3::Bucket
    Properties:
      BucketName:
        Fn::Join:
        - '-'
        - - Ref: AWS::StackName
          - customer-data
          - Fn::Select:
            - 0
            - Fn::Split:
              - '-'
              - Fn::Select:
                - 2
                - Fn::Split:
                  - /
                  - Ref: AWS::StackId
      BucketEncryption:
        ServerSideEncryptionConfiguration:
        - ServerSideEncryptionByDefault:
            SSEAlgorithm: AES256
      OwnershipControls:
        Rules:
        - ObjectOwnership: BucketOwnerEnforced
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      Tags:
      - Key: managed-by
        Value: setup
      - Key: deployment
        Value:
          Ref: AWS::StackName
      - Key: resource
        Value: customer-data
      - Key: resource-type
        Value: storage
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
  CustomerDataBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket:
        Ref: CustomerData
      PolicyDocument:
        Version: 2012-10-17
        Statement:
        - Sid: DenyInsecureTransport
          Effect: Deny
          Principal: '*'
          Action: s3:*
          Resource:
          - Fn::GetAtt:
            - CustomerData
            - Arn
          - Fn::Sub: arn:${AWS::Partition}:s3:::${CustomerData}/*
          Condition:
            Bool:
              aws:SecureTransport: 'false'
  CustomerDataManagementRoleStoragePermission00:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Sub: ${AWS::StackName}-customer-data-storage-0-0
      PolicyDocument:
        Version: 2012-10-17
        Statement:
        - Action:
          - s3:GetBucketAcl
          - s3:GetBucketLocation
          - s3:GetBucketPolicy
          - s3:GetBucketPublicAccessBlock
          - s3:GetBucketVersioning
          - s3:GetEncryptionConfiguration
          - s3:GetLifecycleConfiguration
          Effect: Allow
          Resource:
          - Fn::GetAtt:
            - CustomerData
            - Arn
          Sid: CheckS3BucketHealth
      Roles:
      - Ref: ManagementRole
    DependsOn:
    - CustomerData
    - ManagementRole
  CustomerDataAccessRoleStoragePermission10:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Sub: ${AWS::StackName}-customer-data-storage-1-0
      PolicyDocument:
        Version: 2012-10-17
        Statement:
        - Action:
          - s3:GetBucketLocation
          - s3:ListBucket
          - s3:ListBucketMultipartUploads
          Effect: Allow
          Resource:
          - Fn::GetAtt:
            - CustomerData
            - Arn
          Sid: ListBucketAndUploads
        - Action:
          - s3:AbortMultipartUpload
          - s3:DeleteObject
          - s3:GetObject
          - s3:ListMultipartUploadParts
          - s3:PutObject
          Effect: Allow
          Resource:
          - Fn::Sub: arn:${AWS::Partition}:s3:::${CustomerData}/*
          Sid: ReadWriteBucketObjects
      Roles:
      - Ref: AccessRole
    DependsOn:
    - CustomerData
    - AccessRole
  AccessRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName:
        Fn::Sub: ${AWS::StackName}-access
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
        - Sid: AllowManagingRole
          Effect: Allow
          Principal:
            AWS:
              Ref: ManagingRoleArn
          Action: sts:AssumeRole
          Condition:
            StringEquals:
              aws:PrincipalArn:
                Ref: ManagingRoleArn
      Tags:
      - Key: managed-by
        Value: setup
      - Key: deployment
        Value:
          Ref: AWS::StackName
      - Key: resource
        Value: access
      - Key: resource-type
        Value: resource-access
  ManagementRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName:
        Fn::Sub: ${AWS::StackName}-management
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
        - Sid: AllowManagingRole
          Effect: Allow
          Principal:
            AWS:
              Ref: ManagingRoleArn
          Action: sts:AssumeRole
          Condition:
            StringEquals:
              aws:PrincipalArn:
                Ref: ManagingRoleArn
      Tags:
      - Key: managed-by
        Value: setup
      - Key: deployment
        Value:
          Ref: AWS::StackName
      - Key: resource
        Value: management
      - Key: resource-type
        Value: management
  ManagementRoleManagementPolicy1:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      Description: Application management permissions
      PolicyDocument:
        Version: 2012-10-17
        Statement:
        - Action:
          - s3:GetBucketAcl
          - s3:GetBucketLocation
          - s3:GetBucketPolicy
          - s3:GetBucketPublicAccessBlock
          - s3:GetBucketVersioning
          - s3:GetEncryptionConfiguration
          - s3:GetLifecycleConfiguration
          Effect: Allow
          Resource:
          - Fn::Sub: arn:${AWS::Partition}:s3:::${AWS::StackName}-*
          Sid: CheckS3BucketHealth
        - Sid: ReadOwnManagementRole
          Effect: Allow
          Action: iam:GetRole
          Resource:
            Fn::Sub: arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${AWS::StackName}-management
      Roles:
      - Ref: ManagementRole
    DependsOn:
    - ManagementRole
  DeploymentRegistration:
    Type: AWS::CloudFormation::CustomResource
    Properties:
      ServiceToken: arn:aws:lambda:us-east-1:123456789012:function:register
      Token:
        Ref: Token
      DeploymentName:
        Ref: AWS::StackName
      ResourcePrefix:
        Ref: AWS::StackName
      SourceKind: cloudformation
      Platform: aws
      Region:
        Ref: AWS::Region
      SetupTarget: aws
      SetupImportFormatVersion: 1
      SetupFingerprint: test
      SetupFingerprintVersion: 1
      ManagementConfig:
        platform: aws
        managingRoleArn:
          Ref: ManagingRoleArn
      StackSettings:
        deploymentModel: push
        updates: approval-required
        telemetry: "off"
        heartbeats: "on"
      Resources:
      - id: customer-data
        type: storage
        importData:
          bucketName:
            Ref: CustomerData
          bucketArn:
            Fn::GetAtt:
            - CustomerData
            - Arn
      - id: access
        type: resource-access
        importData:
          roleName:
            Ref: AccessRole
          roleArn:
            Fn::GetAtt:
            - AccessRole
            - Arn
      - id: management
        type: remote-stack-management
        importData:
          roleName:
            Ref: ManagementRole
          roleArn:
            Fn::GetAtt:
            - ManagementRole
            - Arn
          managementPermissionsApplied: true
          installedManagementGrants:
            '*':
            - e6aaf1c9c62a24857ff69229d28bb99c586095ffff44d782b4c7ca6f368c0d5b
    DependsOn:
    - CustomerData
    - CustomerDataBucketPolicy
    - CustomerDataManagementRoleStoragePermission00
    - CustomerDataAccessRoleStoragePermission10
    - AccessRole
    - ManagementRole
    - ManagementRoleManagementPolicy1
