      "config": {
        "id": "prebuilt",
        "type": "container",
        "code": {
          "image": "ghcr.io/acme/prebuilt:2.0.0",
          "type": "image"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "1",
          "min": "1"
        },
        "environment": {},
        "kubernetesSecretMounts": [],
        "links": [],
        "memory": {
          "desired": "1Gi",
          "min": "1Gi"
        },
        "permissions": "prebuilt",
        "ports": [],
        "publicEndpoints": [],
        "stateful": false
      },
      "dependencies": [],
      "lifecycle": "live"
    },
