{
  "id": "acme-jobs",
  "resources": {
    "compute": {
      "config": {
        "id": "compute",
        "type": "compute-cluster",
        "capacityGroups": [
          {
            "groupId": "workers",
            "maxSize": 1,
            "minSize": 1,
            "profile": {
              "cpu": "2",
              "ephemeralStorageBytes": 21474836480,
              "memoryBytes": 4294967296
            },
            "scalePolicy": {
              "machines": {
                "default": 1,
                "max": 20,
                "min": 1
              },
              "type": "fixed"
            }
          }
        ]
      },
      "dependencies": [],
      "lifecycle": "frozen"
    },
    "job-worker": {
      "config": {
        "id": "job-worker",
        "type": "daemon",
        "cluster": "compute",
        "code": {
          "src": ".",
          "toolchain": {
            "binaryName": "job-worker",
            "type": "rust"
          },
          "type": "source"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "0.1",
          "min": "0.1"
        },
        "environment": {},
        "healthCheck": {
          "path": "/healthz",
          "port": 8080
        },
        "links": [],
        "memory": {
          "desired": "128Mi",
          "min": "128Mi"
        },
        "pool": "workers",
        "publicEndpoints": [],
        "runtime": {
          "networkMode": "host"
        },
        "stopGracePeriodSeconds": 3600
      },
      "dependencies": [],
      "lifecycle": "live"
    }
  },
  "supportedPlatforms": [
    "machines"
  ]
}
