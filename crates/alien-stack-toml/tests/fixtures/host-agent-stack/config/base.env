# Defaults shipped with every build of the agent.
AGENT_HOST_ROOT=/host
AGENT_STATE_DIR=/host/var/lib/acme-host-agent
AGENT_SOCKET="/host/run/acme-host-agent.sock"
AGENT_BANNER='scan # not a comment'
AGENT_RULES_DIR=/host/etc/acme/rules.d

# alien.toml sets LOG_FORMAT too, and its value wins.
LOG_FORMAT=text
