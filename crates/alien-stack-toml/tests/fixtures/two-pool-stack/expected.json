{
  "id": "acme-pipeline",
  "inputs": [
    {
      "description": "Where shipped logs are sent.",
      "env": [
        {
          "name": "SHIP_TARGET",
          "targetResources": [
            "log-shipper"
          ]
        }
      ],
      "id": "log_sink",
      "kind": "string",
      "label": "Log sink",
      "providedBy": [
        "developer"
      ],
      "required": true,
      "validation": {
        "format": "url"
      }
    }
  ],
  "permissions": {
    "profiles": {
      "api": {
        "artifacts": [
          "storage/data-read",
          "storage/data-write"
        ]
      },
      "log-shipper": {
        "artifacts": [
          "storage/data-write"
        ]
      }
    }
  },
  "resources": {
    "pipeline": {
      "config": {
        "id": "pipeline",
        "type": "compute-cluster",
        "capacityGroups": [
          {
            "groupId": "frontend",
            "maxSize": 8,
            "minSize": 2,
            "profile": {
              "architecture": "x86_64",
              "cpu": "4",
              "ephemeralStorageBytes": 53687091200,
              "memoryBytes": 17179869184
            },
            "scalePolicy": {
              "max": {
                "default": 8,
                "max": 8,
                "min": 8
              },
              "min": {
                "default": 2,
                "max": 2,
                "min": 2
              },
              "type": "autoscale"
            }
          },
          {
            "groupId": "batch",
            "maxSize": 1,
            "minSize": 1,
            "profile": {
              "architecture": "arm64",
              "cpu": "16",
              "dataDisk": {
                "sizeBytes": 1099511627776
              },
              "ephemeralStorageBytes": 21474836480,
              "gpu": {
                "count": 2,
                "type": "nvidia-l4"
              },
              "memoryBytes": 68719476736
            },
            "scalePolicy": {
              "machines": {
                "default": 1,
                "max": 1,
                "min": 1
              },
              "type": "fixed"
            }
          }
        ],
        "failureDomainSpread": {
          "batch": 2
        }
      },
      "dependencies": [],
      "lifecycle": "frozen"
    },
    "artifacts": {
      "config": {
        "id": "artifacts",
        "type": "storage",
        "corsAllowedOrigins": [],
        "lifecycleRules": [],
        "publicRead": false,
        "versioning": true
      },
      "dependencies": [],
      "lifecycle": "frozen"
    },
    "api": {
      "config": {
        "id": "api",
        "type": "container",
        "autoscaling": {
          "desired": 2,
          "max": 6,
          "min": 2,
          "targetCpuPercent": 65
        },
        "cluster": "pipeline",
        "code": {
          "image": "ghcr.io/acme/pipeline-api:4.0.1",
          "type": "image"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "1",
          "min": "1"
        },
        "environment": {
          "RUST_LOG": "info",
          "ARTIFACT_PREFIX": "builds/"
        },
        "healthCheck": {
          "path": "/healthz",
          "port": 8080
        },
        "kubernetesSecretMounts": [],
        "links": [
          {
            "id": "artifacts",
            "type": "storage"
          }
        ],
        "memory": {
          "desired": "2Gi",
          "min": "2Gi"
        },
        "permissions": "api",
        "pool": "frontend",
        "ports": [
          {
            "port": 8080
          }
        ],
        "publicEndpoints": [
          {
            "name": "http",
            "port": 8080,
            "protocol": "http",
            "wildcardSubdomains": false
          }
        ],
        "stateful": false
      },
      "dependencies": [],
      "lifecycle": "live"
    },
    "log-shipper": {
      "config": {
        "id": "log-shipper",
        "type": "daemon",
        "cluster": "pipeline",
        "code": {
          "src": ".",
          "toolchain": {
            "binaryName": "log-shipper",
            "type": "rust"
          },
          "type": "source"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "0.25",
          "min": "0.25"
        },
        "environment": {
          "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.acme.example:4317",
          "OTEL_SERVICE_NAMESPACE": "acme-pipeline",
          "OTEL_RESOURCE_ATTRIBUTES": "team=platform,tier=batch",
          "SHIP_BATCH_SIZE": "200"
        },
        "links": [
          {
            "id": "artifacts",
            "type": "storage"
          }
        ],
        "memory": {
          "desired": "128Mi",
          "min": "128Mi"
        },
        "permissions": "log-shipper",
        "pool": "frontend",
        "publicEndpoints": []
      },
      "dependencies": [],
      "lifecycle": "live"
    },
    "gpu-monitor": {
      "config": {
        "id": "gpu-monitor",
        "type": "daemon",
        "cluster": "pipeline",
        "code": {
          "image": "ghcr.io/acme/gpu-monitor:0.9.4",
          "type": "image"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "0.1",
          "min": "0.1"
        },
        "environment": {
          "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.acme.example:4317",
          "OTEL_SERVICE_NAMESPACE": "acme-pipeline",
          "OTEL_RESOURCE_ATTRIBUTES": "team=platform,tier=batch",
          "POLL_INTERVAL_SECONDS": "15"
        },
        "links": [],
        "memory": {
          "desired": "128Mi",
          "min": "128Mi"
        },
        "pool": "batch",
        "publicEndpoints": [],
        "runtime": {
          "mounts": [
            {
              "source": "/",
              "target": "/host"
            }
          ],
          "networkMode": "host",
          "pidNamespace": "host",
          "privileged": true,
          "user": "0"
        },
        "stopGracePeriodSeconds": 30
      },
      "dependencies": [],
      "lifecycle": "live"
    }
  },
  "supportedPlatforms": [
    "machines",
    "aws"
  ]
}
