          "image": "ghcr.io/acme/sweeper:1.0.0",
          "type": "image"
        },
        "commandsEnabled": false,
        "cpu": {
          "desired": "1",
          "min": "1"
        },
        "environment": {},
        "kubernetesSecretMounts": [],
