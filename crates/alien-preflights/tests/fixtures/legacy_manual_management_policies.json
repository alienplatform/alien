        "Sid": "WriteSsmParameters",
        "Effect": "Allow",
        "Action": ["ssm:PutParameter", "ssm:DeleteParameter"],
        "Resource": ["arn:aws:ssm:us-east-1:123456789012:parameter/sample-secrets-*"]
      }
    ],
    "uploads": [
      {
        "Sid": "ReadS3Objects",
        "Effect": "Allow",
        "Action": ["s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAcl"],
        "Resource": ["arn:aws:s3:::sample-uploads", "arn:aws:s3:::sample-uploads/*"]
      }
    ]
  }
