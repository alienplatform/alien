{
  "extend": {
    "*": [
      {
        "Sid": "PassLambdaExecutionRoles",
        "Effect": "Allow",
        "Action": ["iam:PassRole"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-*-sa"]
      },
      {
        "Sid": "AttachLambdaRuntimePolicies",
        "Effect": "Allow",
        "Action": ["iam:PutRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-*"],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/deployment": "sample",
            "aws:ResourceTag/managed-by": "runtime"
          }
        }
      },
      {
        "Sid": "ContainerProvisionIamGetRole",
        "Effect": "Allow",
        "Action": ["iam:GetRole"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-volume-backups-*"]
      },
      {
        "Sid": "ContainerProvisionIamPassRole",
        "Effect": "Allow",
        "Action": ["iam:PassRole"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-volume-backups-*"],
        "Condition": {
          "StringEquals": {
            "iam:PassedToService": "dlm.amazonaws.com"
          }
        }
      },
      {
        "Sid": "DenyVolumeBackupRoleChanges",
        "Effect": "Deny",
        "Action": [
          "iam:DeleteRole",
          "iam:PutRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:UpdateAssumeRolePolicy",
          "iam:PutRolePermissionsBoundary",
          "iam:DeleteRolePermissionsBoundary",
          "iam:UpdateRole",
          "iam:TagRole",
          "iam:UntagRole"
        ],
        "Resource": ["arn:aws:iam::123456789012:role/sample-volume-backups-*"]
      },
      {
        "Sid": "DenyPassingLegacyVolumeBackupRoles",
        "Effect": "Deny",
        "Action": ["iam:PassRole"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-dlm-*"]
      },
      {
        "Sid": "ContainerProvisionIamGetRolePermissions",
        "Effect": "Allow",
        "Action": ["iam:GetRole", "iam:DeleteRole"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-dlm-*"]
      },
      {
        "Sid": "ContainerProvisionIamDetachRolePolicy",
        "Effect": "Allow",
        "Action": ["iam:DetachRolePolicy"],
        "Resource": ["arn:aws:iam::123456789012:role/sample-dlm-*"],
        "Condition": {
          "StringEquals": {
            "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
          }
        }
      },
      {
        "Sid": "ContainerProvisionIamCreateServiceLinkedRole",
        "Effect": "Allow",
        "Action": ["iam:CreateServiceLinkedRole"],
        "Resource": ["*"],
        "Condition": {
          "StringEquals": {
            "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
          }
        }
      },
      {
        "Sid": "DenyManagementRoleChanges",
        "Effect": "Deny",
        "Action": [
          "iam:DeleteRole",
          "iam:PutRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:UpdateAssumeRolePolicy",
          "iam:PutRolePermissionsBoundary",
          "iam:DeleteRolePermissionsBoundary",
          "iam:UpdateRole",
          "iam:TagRole",
          "iam:UntagRole"
        ],
        "Resource": ["arn:aws:iam::123456789012:role/sample-management"]
      }
    ],
    "secrets": [
      {
        "Sid": "WriteSsmParameters",
        "Effect": "Allow",
        "Action": ["ssm:PutParameter", "ssm:DeleteParameter"],
        "Resource": ["arn:aws:ssm:us-east-1:123456789012:parameter/sample-secrets-*"]
      }
    ],
    "uploads": [
      {
        "Sid": "ReadS3Objects",
        "Effect": "Allow",
        "Action": ["s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAcl"],
        "Resource": ["arn:aws:s3:::sample-uploads", "arn:aws:s3:::sample-uploads/*"]
      }
    ]
  },
  "override": {
    "*": [
      {
        "Sid": "PassLambdaExecutionRoles",
