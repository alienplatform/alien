# Source: operator/templates/clusterrole.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: acme-shop
  labels:
    app.kubernetes.io/name: acme-operator
    app.kubernetes.io/instance: acme
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "1.2.3"
    helm.sh/chart: "operator-1.2.3"
rules:
  # Required by the Operator runtime: Recent events of each observed workload.
  - apiGroups: ['']
    resources: ['events']
    verbs: ['list']
  # Required by operation kubernetes/get-pods: list pods
  # Required by the Operator runtime: Pod status of each observed workload; pod log discovery in podApi mode.
  - apiGroups: ['']
    resources: ['pods']
    verbs: ['get', 'list']
  # Required by the Operator runtime: Workload inventory reported on every sync; log collector discovery in podApi mode.
  - apiGroups: ['apps']
    resources: ['daemonsets']
    verbs: ['list']
  # Required by the Operator runtime: Workload inventory reported on every sync.
  - apiGroups: ['apps']
    resources: ['deployments']
    verbs: ['list']
  # Required by the Operator runtime: Workload inventory reported on every sync.
  - apiGroups: ['apps']
    resources: ['statefulsets']
    verbs: ['list']
  # Required by the Operator runtime: CPU and memory of each observed workload.
  - apiGroups: ['metrics.k8s.io']
    resources: ['pods']
    verbs: ['list']
  # Required by Pod log collection through the Kubernetes API.
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  # Required by access-request materialization and approval observation.
  - apiGroups: ['accessrequests.acme']
    resources: ['acmeaccessrequests']
    verbs: ["get", "list", "watch", "create", "update", "patch"]
  # Required by access-request status reporting.
  - apiGroups: ['accessrequests.acme']
    resources: ['acmeaccessrequests/status']
    verbs: ["get", "update", "patch"]
---
