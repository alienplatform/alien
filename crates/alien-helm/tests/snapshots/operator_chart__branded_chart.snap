# Source: operator/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: acme
  namespace: shop
  labels:
    app.kubernetes.io/name: acme-operator
    app.kubernetes.io/instance: acme
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "1.2.3"
    helm.sh/chart: "operator-1.2.3"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: acme-operator
      app.kubernetes.io/instance: acme
  template:
    metadata:
      labels:
        app.kubernetes.io/name: acme-operator
        app.kubernetes.io/instance: acme
      annotations:
        # A new token on upgrade restarts the pod, which then uses it.
        checksum/enrollment: 36997ef9c1713fc3ce0a28cdce364a1cdda1544e7c225647a45d7f031f0f624b
        checksum/config: 347ce9315469113a8cde28756fed59ed997a0fd869fd7ada897909a41ef80ca5
    spec:
      serviceAccountName: acme
      automountServiceAccountToken: true
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: operator
          image: "registry.example/operator@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          env:
            - name: PLATFORM
              value: "kubernetes"
            - name: KUBERNETES_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: OPERATOR_SCOPE
              value: "shop"
            - name: OPERATOR_OBSERVE_ALL_NAMESPACES
              value: "true"
            - name: OPERATOR_PERMISSION
              value: "diagnostics"
            - name: OPERATOR_INITIAL_DESIRED_RELEASE
              value: "none"
            - name: OPERATOR_SETUP_METHOD
              value: "manual"
            - name: DATA_DIR
              value: "/var/lib/operator"
            - name: OPERATOR_DATA_PERSISTENT
              value: "false"
            - name: OPERATOR_IDENTITY_SECRET
              value: "acme-identity"
            - name: OPERATOR_ENROLLMENT_TOKEN_FILE
              value: "/etc/operator/enrollment/token"
            - name: OPERATOR_CONFIG_FILE
              value: "/etc/operator/config/operator-config.json"
            - name: OPERATOR_ACCESS_REQUESTS
              value: "true"
            - name: OPERATOR_OTLP_MAX_QUEUED_BYTES
              value: "268435456"
            - name: SYNC_INTERVAL
              value: "30"
            - name: OPERATOR_READINESS_PORT
              value: "8081"
            - name: OPERATOR_POD_LOG_SCOPE
              value: "cluster"
            - name: OPERATOR_POD_LOG_MAX_STREAMS
              value: "200"
          ports:
            - name: readiness
              containerPort: 8081
          readinessProbe:
            httpGet:
              path: /ready
              port: readiness
            periodSeconds: 2
            failureThreshold: 150
          volumeMounts:
            - name: enrollment
              mountPath: /etc/operator/enrollment
              readOnly: true
            - name: config
              mountPath: /etc/operator/config
              readOnly: true
            - name: data
              mountPath: /var/lib/operator
            - name: tmp
              mountPath: /tmp
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 50m
              memory: 128Mi
      volumes:
        # Absent after the code was used and the release was upgraded without
        # it: the identity in the Secret is then all the Operator needs.
        - name: enrollment
          secret:
            secretName: acme-enrollment
            optional: true
            defaultMode: 288
        - name: config
          configMap:
            name: acme-config
        # A cache. The identity and the key to this cache live in the Secret.
        - name: data
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
