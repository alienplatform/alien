---
# Source: operator/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alien
  namespace: shop
  labels:
    app.kubernetes.io/name: operator
    app.kubernetes.io/instance: alien
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "1.2.3"
    helm.sh/chart: "operator-1.2.3"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: operator
      app.kubernetes.io/instance: alien
  template:
    metadata:
      labels:
        app.kubernetes.io/name: operator
        app.kubernetes.io/instance: alien
    spec:
      serviceAccountName: alien
      automountServiceAccountToken: true
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: operator
          image: "registry.example/operator@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          env:
            - name: PLATFORM
              value: "kubernetes"
            - name: KUBERNETES_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: OPERATOR_SCOPE
              value: "shop"
            - name: OPERATOR_OBSERVE_ALL_NAMESPACES
              value: "true"
            - name: OPERATOR_PERMISSION
              value: "diagnostics"
            - name: OPERATOR_INITIAL_DESIRED_RELEASE
              value: "none"
            - name: OPERATOR_SETUP_METHOD
              value: "manual"
            - name: DATA_DIR
              value: "/var/lib/operator"
            - name: OPERATOR_DATA_PERSISTENT
              value: "false"
            - name: OPERATOR_IDENTITY_SECRET
              value: "alien-identity"
            - name: OPERATOR_ENROLLMENT_TOKEN_FILE
              value: "/etc/alien/enrollment/token"
            - name: OPERATOR_ACCESS_REQUESTS
              value: "false"
            - name: SYNC_INTERVAL
              value: "30"
            - name: OPERATOR_READINESS_PORT
              value: "8081"
            - name: OPERATOR_POD_LOG_SCOPE
              value: "cluster"
            - name: OPERATOR_POD_LOG_MAX_STREAMS
              value: "200"
            - name: OPERATOR_POD_LOG_EXCLUDE_NAMESPACES
              value: "kube-system,kube-public,kube-node-lease"
            - name: OTLP_HOST
              value: "0.0.0.0"
            - name: OTLP_PORT
              value: "4318"
          ports:
            - name: readiness
              containerPort: 8081
            - name: otlp
              containerPort: 4318
          readinessProbe:
            httpGet:
              path: /ready
              port: readiness
            periodSeconds: 2
            failureThreshold: 150
          volumeMounts:
            - name: enrollment
              mountPath: /etc/alien/enrollment
              readOnly: true
            - name: data
              mountPath: /var/lib/operator
            - name: tmp
              mountPath: /tmp
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 50m
              memory: 128Mi
      volumes:
        # Absent after the code was used and the release was upgraded without
        # it: the identity in the Secret is then all the Operator needs.
        - name: enrollment
          secret:
            secretName: alien-enrollment
            optional: true
            defaultMode: 288
        # A cache. The identity and the key to this cache live in the Secret.
        - name: data
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
