# Source: operator/templates/clusterrole.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alien-shop
  labels:
    app.kubernetes.io/name: operator
    app.kubernetes.io/instance: alien
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "1.2.3"
    helm.sh/chart: "operator-1.2.3"
rules:
  # Required by the Operator runtime: Recent events of each observed workload.
  - apiGroups: ['']
    resources: ['events']
    verbs: ['list']
  # Required by kubernetes/get-pods: list pods
  # Required by kubernetes/restart: restart a pod
  # Required by the Operator runtime: Pod status of each observed workload; pod log discovery in podApi mode.
  - apiGroups: ['']
    resources: ['pods']
    verbs: ['get', 'list']
  # Required by the Operator runtime: Workload inventory reported on every sync; log collector discovery in podApi mode.
  - apiGroups: ['apps']
    resources: ['daemonsets']
    verbs: ['list']
  # Required by the Operator runtime: Workload inventory reported on every sync.
  - apiGroups: ['apps']
    resources: ['deployments']
    verbs: ['list']
  # Required by the Operator runtime: Workload inventory reported on every sync.
  - apiGroups: ['apps']
    resources: ['statefulsets']
    verbs: ['list']
  # Required by the Operator runtime: CPU and memory of each observed workload.
  - apiGroups: ['metrics.k8s.io']
    resources: ['pods']
    verbs: ['list']
  # Required by Pod log collection through the Kubernetes API.
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
---
# Source: operator/templates/clusterrolebinding.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
