# Source: operator/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: alien
  namespace: shop
  labels:
    app.kubernetes.io/name: operator
    app.kubernetes.io/instance: alien
    app.kubernetes.io/managed-by: Helm
