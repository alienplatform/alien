---
source: crates/alien-terraform/tests/generator/aws_identity_tests.rs
expression: "serde_json::to_string_pretty(&guards).expect(\"serializes\")"
---
[
  {
    "Sid": "DenyManagementRoleChanges",
    "Effect": "Deny",
    "Action": [
      "iam:DeleteRole",
      "iam:PutRolePolicy",
      "iam:DeleteRolePolicy",
      "iam:AttachRolePolicy",
      "iam:DetachRolePolicy",
      "iam:UpdateAssumeRolePolicy",
      "iam:PutRolePermissionsBoundary",
      "iam:DeleteRolePermissionsBoundary",
      "iam:UpdateRole",
      "iam:TagRole",
      "iam:UntagRole"
    ],
    "Resource": [
      "arn:aws:iam::987654321098:role/acme-parity-management"
    ]
  },
  {
    "Sid": "DenySandboxSetupRoleChanges",
    "Effect": "Deny",
    "Action": [
      "iam:DeleteRole",
      "iam:PutRolePolicy",
      "iam:DeleteRolePolicy",
      "iam:AttachRolePolicy",
      "iam:DetachRolePolicy",
      "iam:UpdateAssumeRolePolicy",
      "iam:PutRolePermissionsBoundary",
      "iam:DeleteRolePermissionsBoundary",
      "iam:UpdateRole",
      "iam:TagRole",
      "iam:UntagRole"
    ],
    "Resource": [
      "*"
    ],
    "Condition": {
      "StringEquals": {
        "aws:ResourceTag/managed-by": "setup",
        "aws:ResourceTag/resource-type": "sandbox"
      }
    }
  },
  {
    "Sid": "BoundedRoleProtectBoundary",
    "Effect": "Deny",
    "Action": [
      "iam:CreatePolicyVersion",
      "iam:SetDefaultPolicyVersion",
      "iam:DeletePolicyVersion",
      "iam:DeletePolicy",
      "iam:TagPolicy",
      "iam:UntagPolicy",
      "iam:DeleteRolePermissionsBoundary"
    ],
    "Resource": [
      "arn:aws-us-gov:iam::987654321098:policy/acme-parity-permissions-boundary",
      "arn:aws:iam::987654321098:role/acme-parity-*"
    ]
  }
]
