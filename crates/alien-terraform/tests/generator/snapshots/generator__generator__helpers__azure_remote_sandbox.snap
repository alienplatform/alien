  address_prefixes = [
    cidrsubnet(tolist(azurerm_virtual_network.sandbox_network.address_space)[0], 8, 3)
  ]

  delegation {
    name = "service-networking"

    service_delegation {
      name = "Microsoft.ServiceNetworking/trafficControllers"
      actions = [
        "Microsoft.Network/virtualNetworks/subnets/join/action"
