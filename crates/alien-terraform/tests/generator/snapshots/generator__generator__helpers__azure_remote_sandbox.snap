---
source: crates/alien-terraform/tests/generator/helpers.rs
expression: buf
---
=== versions.tf ===
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 4.75, < 5.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = ">= 2.6, < 3.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.6"
    }
  }
}

=== variables.tf ===
variable "resource_prefix" {
  type        = string
  description = "Optional stable physical resource prefix. Leave empty to generate one."
  default     = ""

  validation {
    condition     = var.resource_prefix == "" || (can(regex("^[a-z][a-z0-9-]{1,38}[a-z0-9]$", var.resource_prefix)) && length(regexall("--", var.resource_prefix)) == 0)
    error_message = "resource_prefix must be 3-40 characters: lowercase letters, numbers, and hyphens; start with a letter; end with a letter or number; and not contain consecutive hyphens."
  }
}

variable "name" {
  type        = string
  description = "Human-readable application name shown in setup and cloud IAM review metadata."
}

variable "token" {
  type        = string
  description = "Install token from the application setup page. This is the same token used by the deploy CLI --token flag."
  sensitive   = true
}

variable "management_url" {
  type        = string
  description = "Management endpoint used to register this deployment."
  default     = ""
}

variable "azure_location" {
  type        = string
  description = "Azure location."
  default     = "eastus"
}

variable "azure_subscription_id" {
  type        = string
  description = "Azure subscription ID hosting the stack."
}

variable "azure_resource_group_name" {
  type        = string
  description = "Azure resource group name."
}

variable "azure_managing_tenant_id" {
  type        = string
  description = "Azure tenant ID that hosts the management identity for cross-tenant access."
}

variable "azure_oidc_issuer" {
  type        = string
  description = "OIDC issuer URL for Azure Federated Identity Credential."
}

variable "azure_oidc_subject" {
  type        = string
  description = "OIDC subject claim for Azure Federated Identity Credential."
}

=== providers.tf ===
provider "azurerm" {
  resource_provider_registrations = "none"

  features {
    persist_id_on_create_before_polling_for_completion = true

    resource_group {
      prevent_deletion_if_contains_resources = true
    }
  }
}

provider "azapi" {}

=== resource_prefix.tf ===
resource "random_id" "resource_prefix" {
  byte_length = 4
}

=== locals.tf ===
locals {
  resource_prefix              = var.resource_prefix == "" ? format("a%s", random_id.resource_prefix.hex) : var.resource_prefix
  deployment_name              = var.name
  deployment_platform          = "azure"
  deployment_target            = "azure"
  deployment_region            = var.azure_location
  deployment_management_config = null
  deployment_settings = {
    deploymentModel = "push"
    updates         = "approval-required"
    telemetry       = "off"
    heartbeats      = "on"
  }
  deployment_resources = [
    {
      id   = "sandbox-network"
      type = "network"
      importData = {
        subscriptionId = var.azure_subscription_id
        resourceGroup  = var.azure_resource_group_name
        vnetId         = azurerm_virtual_network.sandbox_network.id
        vnetName       = azurerm_virtual_network.sandbox_network.name
        subnetIds = [
          azurerm_subnet.sandbox_network_public.id,
          azurerm_subnet.sandbox_network_private.id
        ]
        applicationGatewaySubnetId   = azurerm_subnet.sandbox_network_appgw.id
        applicationGatewaySubnetName = azurerm_subnet.sandbox_network_appgw.name
        privateEndpointSubnetName    = azurerm_subnet.sandbox_network_pe.name
        natGatewayId                 = azurerm_nat_gateway.sandbox_network_nat.id
        networkSecurityGroupId       = azurerm_network_security_group.sandbox_network_workload.id
        egressPublicIps = [
          azurerm_public_ip.sandbox_network_nat_pip.ip_address
        ]
        isByoVnet = false
      }
    },
    {
      id   = "default-resource-group"
      type = "azure_resource_group"
      importData = {
        subscriptionId = var.azure_subscription_id
        resourceGroup  = azurerm_resource_group.default_resource_group.name
        location       = azurerm_resource_group.default_resource_group.location
      }
    },
    {
      id   = "agents"
      type = "sandbox"
      importData = {
        sandboxGroup  = replace(lower("${local.resource_prefix}-agents"), "_", "-")
        region        = var.azure_location
        resourceGroup = var.azure_resource_group_name
      }
    },
    {
      id   = "access"
      type = "resource-access"
      importData = {
        tenantId    = data.azurerm_client_config.access_current.tenant_id
        identityId  = azurerm_user_assigned_identity.access.id
        principalId = azurerm_user_assigned_identity.access.principal_id
        clientId    = azurerm_user_assigned_identity.access.client_id
      }
    }
  ]
}

=== sandbox_network.tf ===
resource "azurerm_virtual_network" "sandbox_network" {
  name                = "${local.resource_prefix}-sandbox_network"
  resource_group_name = var.azure_resource_group_name
  location            = var.azure_location
  address_space = [
    "10.46.0.0/16"
  ]
  tags = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "sandbox-network"
    "resource-type" = "network"
  }
  depends_on = [
    azurerm_resource_group.default_resource_group
  ]
}

resource "azurerm_subnet" "sandbox_network_public" {
  name                 = "${local.resource_prefix}-sandbox_network-public"
  resource_group_name  = var.azure_resource_group_name
  virtual_network_name = azurerm_virtual_network.sandbox_network.name
  address_prefixes = [
    cidrsubnet(tolist(azurerm_virtual_network.sandbox_network.address_space)[0], 8, 0)
  ]
  depends_on = [
    azurerm_resource_group.default_resource_group
  ]
}

resource "azurerm_subnet" "sandbox_network_private" {
  name                 = "${local.resource_prefix}-sandbox_network-private"
  resource_group_name  = var.azure_resource_group_name
  virtual_network_name = azurerm_virtual_network.sandbox_network.name
  address_prefixes = [
    cidrsubnet(tolist(azurerm_virtual_network.sandbox_network.address_space)[0], 8, 1)
  ]
  depends_on = [
    azurerm_resource_group.default_resource_group
  ]
}

resource "azurerm_subnet" "sandbox_network_container_apps" {
  name                 = "${local.resource_prefix}-sandbox_network-container-apps"
  resource_group_name  = var.azure_resource_group_name
  virtual_network_name = azurerm_virtual_network.sandbox_network.name
  address_prefixes = [
    cidrsubnet(tolist(azurerm_virtual_network.sandbox_network.address_space)[0], 8, 5)
  ]

  delegation {
    name = "container-apps-environment"

    service_delegation {
      name = "Microsoft.App/environments"
      actions = [
        "Microsoft.Network/virtualNetworks/subnets/join/action"
      ]
    }
  }

  depends_on = [
    azurerm_resource_group.default_resource_group
  ]
}

resource "azurerm_subnet" "sandbox_network_appgw" {
