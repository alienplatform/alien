  ]
}

resource "azurerm_public_ip" "sandbox_network_nat_pip" {
  name                = "${local.resource_prefix}-sandbox_network-nat-pip"
  resource_group_name = var.azure_resource_group_name
  location            = var.azure_location
  allocation_method   = "Static"
  sku                 = "Standard"
  tags = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "sandbox-network"
    "resource-type" = "network"
  }

  lifecycle {
    prevent_destroy = true
  }

  depends_on = [
    azurerm_resource_group.default_resource_group
  ]
}

resource "azurerm_nat_gateway" "sandbox_network_nat" {
  name                    = "${local.resource_prefix}-sandbox_network-nat"
  resource_group_name     = var.azure_resource_group_name
  location                = var.azure_location
  sku_name                = "Standard"
  idle_timeout_in_minutes = 10
  tags = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "sandbox-network"
    "resource-type" = "network"
