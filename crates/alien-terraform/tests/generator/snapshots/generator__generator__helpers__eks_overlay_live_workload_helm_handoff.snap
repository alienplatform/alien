=== retain-data.py ===
#!/usr/bin/env python3
"""Detach the generated retention inventory, keeping a recovery receipt.

AWS Aurora and its network are excluded by the generator and remain managed
for destroy. KMS keys remain in the inventory.
"""
import argparse
import json
import os
import re
from pathlib import Path
import subprocess
import tempfile


def tf(*args):
    return subprocess.check_output([CLI, *args], text=True)


def save(path, value):
    # Publish only a complete, durable record, without replacing an earlier one.
    # An interrupted write must not leave an empty intent that cannot be recovered.
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            json.dump(value, output, indent=2)
            output.flush()
            os.fsync(output.fileno())
        os.link(temporary, path)
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        if temporary is not None:
            temporary.unlink()



def protect_dynamodb_ttl(state, selected):
    """Use the installer's AWS credentials; never detach while TTL can still run."""
    addresses = {item['address'] for item in selected}
    for resource in state.get('resources', []):
        if resource.get('mode') != 'managed' or resource.get('type') != 'aws_dynamodb_table':
            continue
        base = '.'.join(filter(None, [resource.get('module'), resource['type'], resource['name']]))
        for instance in resource.get('instances', []):
            suffix = '[' + json.dumps(instance['index_key']) + ']' if 'index_key' in instance else ''
            if base + suffix not in addresses:
                continue
            attributes = instance.get('attributes', {})
            arn = attributes.get('arn', '')
            match = re.fullmatch(r'arn:(aws(?:-us-gov|-cn)?):dynamodb:([a-z0-9-]+):([0-9]{12}):table/([a-zA-Z0-9_.-]+)', arn)
            if not match or attributes.get('id') != match[4]:
                raise RuntimeError('Refresh the exact DynamoDB table ARN before retention; nothing detached')
            def aws(operation, *arguments):
                try:
                    result = subprocess.check_output(
                        ['aws', 'dynamodb', operation, '--region', match[2], '--table-name', arn,
                         *arguments, '--output', 'json', '--no-cli-pager'], text=True)
                except (FileNotFoundError, subprocess.CalledProcessError) as error:
                    raise RuntimeError('DynamoDB retention requires AWS CLI with the installer credentials and DescribeTable, DescribeTimeToLive and UpdateTimeToLive permissions; nothing detached') from error
                return json.loads(result)
            observed = aws('describe-table').get('Table', {})
            if observed.get('TableArn') != arn:
                raise RuntimeError('DynamoDB account/table identity changed; nothing detached')
            ttl = aws('describe-time-to-live').get('TimeToLiveDescription', {})
            if ttl.get('TimeToLiveStatus') == 'ENABLED':
                attribute = ttl.get('AttributeName')
                if not isinstance(attribute, str) or not attribute:
                    raise RuntimeError('DynamoDB TTL attribute is unknown; nothing detached')
                aws('update-time-to-live', '--time-to-live-specification',
                    json.dumps({'Enabled': False, 'AttributeName': attribute}))
                ttl = aws('describe-time-to-live').get('TimeToLiveDescription', {})
            if ttl.get('TimeToLiveStatus') != 'DISABLED':
                raise RuntimeError('DynamoDB TTL is not confirmed DISABLED. Wait for its transition and rerun this retention command; nothing detached')


def installed_inventory(state, module):
    markers = [resource for resource in state.get('resources', [])
               if resource.get('mode') == 'managed'
               and resource.get('type') == 'terraform_data'
               and resource.get('name') == 'retention_inventory'
               and resource.get('module', '') == module]
    if len(markers) != 1 or len(markers[0].get('instances', [])) != 1:
        raise RuntimeError('Installed retention inventory is unavailable. Upgrade the original resource configuration in place before whole-setup teardown; nothing detached')
    instance = markers[0]['instances'][0]
    inventory = instance.get('attributes', {}).get('input', {}).get('value')
    if (instance.get('deposed') or not isinstance(inventory, dict)
            or inventory.get('version') != 1
            or not isinstance(inventory.get('addresses'), list)
            or not all(isinstance(address, str) for address in inventory['addresses'])):
        raise RuntimeError('Invalid installed retention inventory; nothing detached')
    return inventory['addresses']


def verify_installed_inventory(state, manifest, module):
    if installed_inventory(state, module) != manifest:
        raise RuntimeError('Generated manifest does not match the installed retention inventory; nothing detached')


def azure_expiry_guard(state, selected):
    """Only delete actions that may affect detached blob data block retention."""
    accounts = set()
    containers = {}
    for resource in state.get('resources', []):
        if resource.get('mode') != 'managed':
            continue
        base = '.'.join(filter(None, [resource.get('module'), resource['type'], resource['name']]))
        for instance in resource.get('instances', []):
            suffix = '[' + json.dumps(instance['index_key']) + ']' if 'index_key' in instance else ''
            if base + suffix not in selected:
                continue
            attributes = instance['attributes']
            if resource['type'] == 'azurerm_storage_account':
                accounts.add(attributes['id'].lower())
            elif resource['type'] == 'azurerm_storage_container':
                account = attributes.get('storage_account_id')
                name = attributes.get('name')
                if not account or not name:
                    raise RuntimeError('Cannot identify retained Azure container account/name; refresh or upgrade the installed package before detachment')
                containers.setdefault(account.lower(), set()).add(name)
    for resource in state.get('resources', []):
        if resource.get('mode') != 'managed' or resource['type'] != 'azurerm_storage_management_policy':
            continue
        for instance in resource.get('instances', []):
            attributes = instance['attributes']
            account = attributes.get('storage_account_id', '').lower()
            if account not in accounts and account not in containers:
                continue
            for rule in attributes.get('rule', []):
                if not rule.get('enabled', True):
                    continue
                filters = rule.get('filters') or []
                prefixes = [prefix for entry in filters for prefix in entry.get('prefix_match') or []]
                if (account not in accounts and prefixes
                        and not any(prefix.startswith(name + '/') or (name + '/').startswith(prefix)
                                    for name in containers[account] for prefix in prefixes)):
                    continue
                # Provider state uses -1/null for unset age fields. Tag filters
                # cannot prove safety: retained blobs may acquire matching tags.
                actions = rule.get('actions')
                if not isinstance(actions, list) or not actions:
                    raise RuntimeError('Unknown applicable Azure lifecycle action; nothing detached')
                for action in actions:
                    for kind, blocks in action.items():
                        if kind not in ('base_blob', 'snapshot', 'version'):
                            raise RuntimeError('Unknown applicable Azure lifecycle action; nothing detached')
                        for block in blocks or []:
                            if any(key.startswith('delete') and value is not None and value != -1
                                   for key, value in block.items()):
                                raise RuntimeError('Disable Azure storage lifecycle delete rules affecting retained data, apply; nothing detached')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--detach', action='store_true', help='confirm detachment before whole-setup teardown')
    parser.add_argument('--module-address', default='', help='exact installed child module address')
    parser.add_argument('--receipt-dir', type=Path, required=True, help='private recovery directory outside the module')
    args = parser.parse_args()
    if os.name != "posix":
        raise RuntimeError("Use Linux, macOS, or a WSL Linux filesystem for private recovery receipts; native Windows is not supported")
    manifest_path = Path(__file__).with_name('retained-data.json')
    manifest = json.loads(manifest_path.read_text())
    if not isinstance(manifest, list) or not all(isinstance(address, str) for address in manifest):
        raise RuntimeError('Invalid recovery inventory; nothing detached')
    prefix = args.module_address + '.' if args.module_address else ''
    addresses = {prefix + address for address in manifest}
    # A failed read must abort, never masquerade as an empty installation.
    state = json.loads(tf('state', 'pull'))
    if state.get('version') != 4 or not state.get('lineage') or not isinstance(state.get('serial'), int):
        raise RuntimeError('Unsupported or incomplete Terraform state; nothing detached')
    verify_installed_inventory(state, manifest, args.module_address)
    selected = []
    for resource in state.get('resources', []):
        if resource.get('mode') != 'managed':
            continue
        base = '.'.join(filter(None, [resource.get('module'), resource['type'], resource['name']]))
        if base not in addresses:
            continue
        for instance in resource.get('instances', []):
            suffix = '[' + json.dumps(instance['index_key']) + ']' if 'index_key' in instance else ''
            resource_id = instance['attributes'].get('id')
            if not resource_id:
                raise RuntimeError('Cannot detach a resource without a recovery ID: ' + base + suffix)
            if resource['type'] == 'google_storage_bucket':
                rules = instance['attributes'].get('lifecycle_rule') or []
                if any(action.get('type') == 'Delete' for rule in rules for action in rule.get('action', [])):
                    raise RuntimeError('Remove Cloud Storage delete lifecycle rules and apply before retaining ' + base + suffix + '; nothing detached')
            if resource['type'] == 'azurerm_storage_container':
                if instance['attributes'].get('container_access_type') != 'private':
                    raise RuntimeError('Set Azure container publicRead=false and apply before retaining ' + base + suffix + '; nothing detached')
            selected.append({'address': base + suffix, 'id': resource_id})
    azure_expiry_guard(state, {item['address'] for item in selected})
    print(json.dumps(selected, indent=2))
    if not args.detach:
        return
    os.umask(0o077)
    args.receipt_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    if args.receipt_dir.stat().st_mode & 0o077:
        raise RuntimeError('Receipt directory must be private (mode 0700)')
    # One immutable receipt per attempt preserves IDs across partial failures/retries.
    attempt = Path(tempfile.mkdtemp(prefix='detach-', dir=args.receipt_dir))
    save(attempt / 'state-before.json', state)
    save(attempt / 'retained.json', selected)
    save(attempt / 'manifest.json', manifest)
    save(attempt / 'source.json', {'directory': str(Path.cwd()), 'lineage': state.get('lineage'), 'serial': state.get('serial'), 'module': args.module_address})
    # Keep the exact inventory before touching cloud expiry, and stop before any state
    # removal until every selected table confirms DISABLED. A retry re-reads AWS.
    protect_dynamodb_ttl(state, selected)
    # Check for a concurrent writer between inventory and mutation. Terraform locks
    # the state mutation itself. Operators must serialize this entire teardown with
    # other Terraform runs, just as they do for a multi-command import procedure.
    current = json.loads(tf('state', 'pull'))
    if (current.get('lineage'), current.get('serial')) != (state.get('lineage'), state.get('serial')):
        raise RuntimeError('Terraform state changed; no resources detached. Retry after the other run finishes.')
    if selected:
        subprocess.run([CLI, 'state', 'rm', '-lock-timeout=60s', *[item['address'] for item in selected]], check=True)
    save(attempt / 'state-after.json', json.loads(tf('state', 'pull')))
    print('Recovery receipt: ' + str(attempt))
    print('Data is retained. Access has NOT yet been revoked. Run and review terraform plan -destroy, then apply that destroy plan. Do not run an ordinary apply after detaching.')


if __name__ == '__main__':
    CLI = os.environ.get('TF_CLI', 'terraform')
    if CLI not in ('terraform', 'tofu'):
        raise SystemExit('TF_CLI must be terraform or tofu')
    main()

=== data.tf ===
resource "aws_s3_bucket" "data" {
  bucket        = "${local.resource_prefix}-data"
  force_destroy = false
  tags = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "data"
    "resource-type" = "storage"
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "data" {
  bucket = aws_s3_bucket.data.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_ownership_controls" "data" {
  bucket = aws_s3_bucket.data.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_public_access_block" "data" {
  bucket                  = aws_s3_bucket.data.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_policy" "data" {
  bucket = aws_s3_bucket.data.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [{ Sid = "DenyInsecureTransport", Effect = "Deny", Principal = "*", Action = "s3:*", Resource = [aws_s3_bucket.data.arn, "${aws_s3_bucket.data.arn}/*"], Condition = { Bool = { "aws:SecureTransport" = "false" } } }] })
}

=== execution_sa.tf ===
data "aws_eks_cluster" "target" {
  name = var.eks_cluster_name
}

data "tls_certificate" "eks_oidc" {
  url = data.aws_eks_cluster.target.identity[0].oidc[0].issuer
}

data "aws_iam_openid_connect_provider" "eks_existing" {
  count = var.kubernetes_cluster_mode == "existing" ? 1 : 0
  url   = data.aws_eks_cluster.target.identity[0].oidc[0].issuer
}

data "aws_iam_policy_document" "execution_sa_assume_role" {
  statement {
    effect = "Allow"
    actions = [
      "sts:AssumeRoleWithWebIdentity"
    ]

    principals {
      type = "Federated"
      identifiers = [
        local.eks_oidc_provider_arn
      ]
    }

    condition {
      test     = "StringEquals"
      variable = "${local.eks_oidc_issuer_host_path}:sub"
      values = [
        "system:serviceaccount:${var.kubernetes_namespace}:${trim(substr(format("%s-%s-sa", coalesce(trim(lower(replace(local.resource_prefix, "/[^a-zA-Z0-9]+/", "-")), "-"), "alien"), coalesce(trim(lower(replace("execution", "/[^a-zA-Z0-9]+/", "-")), "-"), "alien")), 0, 63), "-")}"
      ]
    }

    condition {
      test     = "StringEquals"
      variable = "${local.eks_oidc_issuer_host_path}:aud"
      values = [
        "sts.amazonaws.com"
      ]
    }
  }
}

resource "aws_iam_role" "execution_sa" {
  name               = length(format("%s-%s", local.resource_prefix, "execution-sa")) <= 64 ? format("%s-%s", local.resource_prefix, "execution-sa") : format("%s-%s", substr(format("%s-%s", local.resource_prefix, "execution-sa"), 0, 55), substr(sha1(format("%s-%s", local.resource_prefix, "execution-sa")), 0, 8))
  assume_role_policy = data.aws_iam_policy_document.execution_sa_assume_role.json
  tags = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "execution-sa"
    "resource-type" = "service-account"
  }
}

resource "aws_iam_role_policy" "execution_sa_set_0" {
  name   = "storage-data-read-0"
  role   = aws_iam_role.execution_sa.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [{ Sid = "ReadS3Objects", Effect = "Allow", Action = ["s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAcl"], Resource = ["arn:aws:s3:::${local.resource_prefix}-*", "arn:aws:s3:::${local.resource_prefix}-*/*"] }] })
}

resource "aws_iam_openid_connect_provider" "eks" {
  count = var.kubernetes_cluster_mode == "create" ? 1 : 0
  url   = data.aws_eks_cluster.target.identity[0].oidc[0].issuer
  client_id_list = [
    "sts.amazonaws.com"
  ]
  thumbprint_list = [
    data.tls_certificate.eks_oidc.certificates[0].sha1_fingerprint
  ]
  tags = {
    Name                         = "${local.resource_prefix}-eks-oidc"
    "deployment-resource-prefix" = local.resource_prefix
  }
}

=== registration.tf ===
resource "terraform_data" "deployment_registration" {
  input = {
    platform                    = local.deployment_platform
    token                       = var.token
    name                        = var.name
    resource_prefix             = local.resource_prefix
    setup_target                = ""
    setup_import_format_version = 1
    setup_fingerprint           = ""
    setup_fingerprint_version   = 0
    management_url              = var.management_url
    management_config           = local.deployment_management_config
    stack_settings              = local.deployment_settings
    resources                   = local.deployment_resources
    inputValues                 = {}
    basePlatform                = local.deployment_base_platform
  }
  depends_on = [
    aws_s3_bucket.data,
    aws_s3_bucket_server_side_encryption_configuration.data,
    aws_s3_bucket_ownership_controls.data,
    aws_s3_bucket_public_access_block.data,
    aws_s3_bucket_policy.data,
    aws_iam_role.execution_sa,
    aws_iam_role_policy.execution_sa_set_0,
    aws_iam_openid_connect_provider.eks
  ]
}

=== outputs.tf ===
output "deployment_target" {
  value       = "eks"
  description = "Terraform module target."
}

output "deployment_resource_prefix" {
  value       = local.resource_prefix
  description = "Physical resource prefix."
}

output "deployment_platform" {
  value       = local.deployment_platform
  description = "Target platform."
}

output "deployment_region" {
  value       = local.deployment_region
  description = "Target cloud region or location."
}

output "deployment_setup_target" {
  value       = ""
  description = "Setup target."
}

output "deployment_setup_import_format_version" {
  value       = 1
  description = "Setup registration payload format version."
}

output "deployment_setup_fingerprint" {
  value       = ""
  description = "Setup compatibility fingerprint."
}

output "deployment_setup_fingerprint_version" {
  value       = 0
  description = "Setup fingerprint algorithm version."
}

output "deployment_management_config" {
  value       = jsonencode(local.deployment_management_config)
  description = "Deployment registration management configuration JSON."
}

output "deployment_stack_settings" {
  value       = jsonencode(local.deployment_settings)
  description = "Deployment registration settings JSON."
  sensitive   = true
}

output "deployment_resources" {
  value       = jsonencode(local.deployment_resources)
  description = "Deployment registration resource metadata JSON."
}

output "deployment_base_platform" {
  value       = local.deployment_base_platform
  description = "Base cloud platform for Kubernetes targets."
}

output "kubernetes_namespace" {
  value       = var.kubernetes_namespace
  description = "Kubernetes namespace for runtime resources."
}

output "kubernetes_kubeconfig" {
  value       = local.kubernetes_kubeconfig
  description = "Kubeconfig for managed Kubernetes clusters created by this module."
  sensitive   = true
}

output "kubernetes_kube_context" {
  value       = local.kubernetes_kube_context
  description = "Kube context for managed Kubernetes clusters created by this module."
}

output "kubernetes_update_kubeconfig_command" {
  value       = "AWS_PROFILE=<target-profile> aws eks update-kubeconfig --region ${local.deployment_region} --name ${local.kubernetes_kube_context} --alias ${local.kubernetes_kube_context}"
  description = "AWS CLI command template for configuring kubectl access to the target EKS cluster."
}

=== README.md ===
# Deployment setup - eks-live-workload

Target: `eks`.

This module creates setup-owned infrastructure, grants the management access needed after setup, and prepares deployment registration metadata. Review the generated `.tf` files before applying; each resource file maps to one setup resource.

## Inputs

Required:

- `token`: install token from the setup page.
- `name`: deployment name to include in the registration metadata: lowercase letters, numbers, and single hyphens.

Common optional settings:

- `resource_prefix`: stable physical-name prefix. Leave empty to generate one.
- `management_url`: optional management endpoint used by pull-style runtimes.
- `deployment_model`: `push` or `pull`.
- `updates_mode`: `auto` or `approval-required`.
- `telemetry_mode`: `off`, `auto`, or `approval-required`.
- `heartbeats_mode`: `off` or `on`.
- `advanced_settings_json`: complete advanced deployment settings JSON. Most installs should keep the generated default.
- `advanced_settings_overlay_json`: partial advanced settings merged over package defaults, preserving generated values such as compute selections.

AWS settings:

- `aws_region`: AWS region used by the provider.
- `managing_role_arn`: management identity allowed to assume setup-created roles.
- `managing_account_id`: account that hosts application container images. Empty disables scoped cross-account image-pull grants.

Network settings:

- `network_mode`: `create-new`, `use-existing`, or `use-default`.
- `vpc_cidr`, `availability_zones`: used with `create-new`.
- `vpc_id`, `public_subnet_ids`, `private_subnet_ids`, `security_group_ids`: required with `use-existing`.

Kubernetes settings:

- `kubernetes_cluster_mode`: `create` or `existing`.
- `kubernetes_namespace`: namespace for runtime resources.
- `eks_cluster_name`: existing EKS cluster name when `kubernetes_cluster_mode = "existing"`.
- `custom_domain_name`, `custom_domain_certificate_arn`: optional EKS public route hostname and ACM certificate ARN. Leave empty to use the generated load balancer hostname.

## Run

Use your organization's normal backend and approval workflow. A typical local review looks like:

```bash
export TF_VAR_name="eks-live-workload"
export TF_VAR_token="..."
terraform init
terraform validate
terraform plan -out=tfplan
terraform apply tfplan
```

## Registration

This module exposes `deployment_management_config`, `deployment_stack_settings`, `deployment_resources`, and (when the stack declares deployer inputs) `deployment_input_values` outputs for registration flows managed outside Terraform.

## Outputs

- `deployment_management_config`: management endpoint and credential-boundary metadata.
- `deployment_stack_settings`: deployment settings JSON assembled from typed variables, package defaults, and advanced-setting overlays.
- `deployment_resources`: setup-owned resource metadata handed to the deployment runtime.
- `deployment_input_values`: deployer input values JSON, emitted only when the stack declares deployer inputs.
- `deployment_id` and `deployment_token`: emitted only when Terraform performs registration.

## Kubernetes Operations

Before inspecting the cluster, verify that your AWS CLI points at the target account, not the management account:

```bash
AWS_PROFILE=<target-profile> aws sts get-caller-identity
terraform output kubernetes_update_kubeconfig_command
AWS_PROFILE=<target-profile> aws eks update-kubeconfig --region $(terraform output -raw deployment_region) --name $(terraform output -raw kubernetes_kube_context) --alias $(terraform output -raw kubernetes_kube_context)
kubectl --context $(terraform output -raw kubernetes_kube_context) -n $(terraform output -raw kubernetes_namespace) get pods,pvc,svc,ingress,events
```

Treat live `kubectl patch` changes as diagnostics only. Durable fixes belong in the generated package, Helm values, or deployment configuration.

## Destroy Order

If `helm_install_enabled = true`, `terraform destroy` uninstalls the Operator Helm release first. The chart's pre-delete cleanup job removes runtime Kubernetes objects, then Terraform removes the setup registration and infrastructure.

If `helm_install_enabled = false`, uninstall the Helm release yourself and confirm the cleanup job completed before running `terraform destroy`. Terraform cannot clean runtime Kubernetes objects for a Helm release it did not install.
## Retain AWS setup data during uninstall

Setup-owned S3 buckets, DynamoDB tables and ECR repositories are protected against replacement and destroy. This includes empty resources. Their KMS keys survive with them. Aurora PostgreSQL, its managed password secret, writer instance, parameter group, security group, subnet group and setup-created network are deleted during teardown, without a final database snapshot. Their KMS keys remain retained. Apply this package to the existing installation before teardown; older state may still allow destructive deletion. Removing data declarations from an installed configuration is not supported by this helper. `prevent_destroy` protection disappears when a block is removed; keep the installed declarations until whole-setup detachment. Never bypass protection to force a replacement.

Use Python 3 on Linux or macOS (on Windows, use WSL with receipts on its Linux filesystem) and the same Terraform backend, workspace and working directory used to install this setup. Stop deployment workloads first. Serialize the following procedure with all other Terraform runs. For a child module, add `--module-address 'module.<name>'` (including any module instance index).

```bash
# Preview exactly which addresses and cloud IDs will be retained.
python3 ./retain-data.py --receipt-dir /secure/path/retained-setup
# Save private recovery state and detach only the generated retention inventory.
python3 ./retain-data.py --receipt-dir /secure/path/retained-setup --detach
terraform plan -destroy -out=uninstall.tfplan
terraform apply uninstall.tfplan
```

Review the destroy plan before applying: it must remove this setup's application/management roles and bucket policies, while the retained resources stay absent from the delete list. Detachment alone does not revoke access. Retained bucket encryption, object ownership, public-access-block and versioning settings stay in place; lifecycle-expiration configuration remains managed and is removed during destroy. Existing external grants are outside this setup's ownership and require a separate access review.

The receipt contains exact addresses, cloud IDs, state lineage and full before/after state. Keep it private and backed up: Terraform state can contain secrets. A retry creates a new receipt without overwriting earlier IDs. The helper fails on state-read errors and keeps Terraform locking enabled. Do not run ordinary `terraform apply` after whole-setup detachment: it would try to recreate the resources. To resume management, restore their declarations and use `terraform import ADDRESS ID` for each retained instance, then review an in-place plan. Do not restore a full old state over newer state.



Retained resources continue to incur cloud charges, including storage and KMS. To explicitly erase data, first finish access revocation, then use the cloud's deletion operations on the exact IDs in the receipt, including stored versions/images, only after confirming that no retained data depends on a key. This workflow covers the AWS setup resources listed above; other database backends, other data types, runtime-owned resources and other clouds require their own retention procedure.

When retaining DynamoDB tables, install AWS CLI and use the same target-account installer credentials as Terraform. The helper verifies the recorded table ARN, disables its observed TTL attribute and requires AWS to report `DISABLED` before removing any selected resource from state. If TTL is transitioning, wait and rerun the same command; no resources are detached. Required metadata/control permissions are `DescribeTable`, `DescribeTimeToLive` and `UpdateTimeToLive`.

=== retention-inventory.tf ===
resource "terraform_data" "retention_inventory" {
  input = {
    version = 1
    addresses = [
      "aws_s3_bucket.data",
      "aws_s3_bucket_server_side_encryption_configuration.data",
      "aws_s3_bucket_ownership_controls.data",
      "aws_s3_bucket_public_access_block.data"
    ]
  }
}
