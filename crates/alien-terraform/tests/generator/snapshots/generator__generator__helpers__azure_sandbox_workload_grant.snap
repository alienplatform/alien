resource "terraform_data" "deployment_registration" {
  input = {
    platform                    = local.deployment_platform
    token                       = var.token
    name                        = var.name
    resource_prefix             = local.resource_prefix
    setup_target                = ""
    setup_import_format_version = 1
    setup_fingerprint           = ""
    setup_fingerprint_version   = 0
    management_url              = var.management_url
    management_config           = local.deployment_management_config
    stack_settings              = local.deployment_settings
    resources                   = local.deployment_resources
    inputValues                 = {}
  }
  depends_on = [
    azurerm_resource_group.default_resource_group,
    azurerm_role_definition.setup_execution_sandbox_management_microsoft_app_sandbox_groups_sandboxes_write_permissions_0,
    azurerm_log_analytics_workspace.default_container_apps_environment_logs,
    azurerm_container_app_environment.default_container_apps_environment,
    azurerm_user_assigned_identity.execution_sa,
    azurerm_role_definition.execution_sa_custom_microsoft_app_sandbox_groups_sandboxes_write_permissions,
    azurerm_role_assignment.execution_sa_sandbox_management_microsoft_app_sandbox_groups_sandboxes_write_permissions_assignment,
    azapi_resource.agents,
    azurerm_role_assignment.agents-execution_sa-c24cf47c_5077_412d_a19c_45202126392c,
    azapi_resource.other,
    azurerm_role_assignment.other-execution_sa-c24cf47c_5077_412d_a19c_45202126392c
  ]
}

