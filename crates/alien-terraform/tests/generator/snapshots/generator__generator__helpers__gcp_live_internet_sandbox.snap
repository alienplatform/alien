resource "google_project_iam_custom_role" "gcp_role_sandbox_templates" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_sandbox_templates", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Sandbox templates"
  description = "Used by ${local.deployment_name}. Allows creating, reading and deleting environment templates, which set a sandbox's image and internet access, under the selected reasoning engine. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "aiplatform.sandboxEnvironmentTemplates.create",
    "aiplatform.sandboxEnvironmentTemplates.delete",
    "aiplatform.sandboxEnvironmentTemplates.get",
    "aiplatform.sandboxEnvironmentTemplates.list"
  ]
}

resource "google_vertex_ai_reasoning_engine_iam_member" "gcp_role_sandbox_templates_agents_engine_templates_0" {
  provider         = google-beta
  reasoning_engine = google_vertex_ai_reasoning_engine.agents_engine.name
  role             = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_sandbox_templates[0].name : format("projects/%s/roles/role_%s_sandbox_templates", var.gcp_project, local.gcp_custom_role_prefix)
  member           = "serviceAccount:${google_service_account.management.email}"
}

resource "google_artifact_registry_repository" "agents_image" {
  project       = var.gcp_project
  location      = var.gcp_region
  repository_id = replace(lower(format("%s-agents-img", local.resource_prefix)), "_", "-")
  format        = "DOCKER"
  description   = "Image of sandbox 'agents'"
  labels = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "agents"
    "resource-type" = "sandbox"
  }
  depends_on = [
    google_project_service.enable_artifact_registry,
    google_vertex_ai_reasoning_engine.agents_engine,
    google_project_iam_member.secretmanager_secretaccessor_operator_sa_secrets_vault_sandbox_egress_signing_key_read_binding_0,
