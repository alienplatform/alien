=== iam_propagation.tf ===
resource "time_sleep" "gcp_iam_propagation" {
  create_duration = "120s"
  depends_on = [
    google_vertex_ai_reasoning_engine_iam_member.gcp_role_sandbox_templates_agents_engine_templates_0,
    google_vertex_ai_reasoning_engine_iam_member.gcp_role_sandbox_preview_edge_agents_engine_preview_0,
    google_service_account_iam_member.agents_preview_sign_operator_sa,
    google_project_iam_member.default_network_sbx_attachment_agent,
    google_project_iam_member.default_network_sbx_gateway_secrets,
    google_project_iam_member.gcp_role_container_heartbeat_management_binding_0,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_810962d4_management_binding_0,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_57427f21_management_binding_1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_931128e1_management_binding_2,
    google_project_iam_member.gcp_role_network_heartbeat_management_binding_0,
    google_project_iam_member.gcp_role_sandbox_heartbeat_management_binding_0,
    google_project_iam_member.gcp_role_sandbox_management_management_binding_0,
    google_project_iam_member.gcp_role_manage_sandbox_private_endpoint_management_binding_0,
    google_project_iam_member.gcp_role_service_account_quota_metadata_management_binding_0,
    google_project_iam_member.iam_serviceaccountviewer_management_binding_1,
    google_project_iam_member.iam_roleviewer_management_binding_2,
    google_project_iam_member.serviceusage_serviceusageviewer_management_binding_0,
    google_project_iam_member.secretmanager_viewer_management_binding_0,
    google_service_account_iam_member.management_manager,
    google_project_iam_member.secretmanager_secretaccessor_operator_sa_secrets_vault_sandbox_egress_signing_key_read_binding_0,
    google_project_iam_member.gcp_role_create_secret_manager_secrets_management_secrets_vault_data_write_binding_0,
    google_project_iam_member.secretmanager_secretversionadder_management_secrets_vault_data_write_binding_1,
    google_project_iam_member.gcp_role_write_secret_manager_values_management_secrets_vault_data_write_binding_2,
    google_project_iam_member.secretmanager_viewer_management_secrets_vault_heartbeat_binding_0,
    google_project_iam_member.gcp_role_sandbox_execute_operator_sa_binding_0,
    google_project_iam_member.gcp_role_sandbox_management_operator_sa_binding_0
  ]
}

=== registration.tf ===
resource "terraform_data" "deployment_registration" {
  input = {
    platform                    = local.deployment_platform
    name                        = var.name
    resource_prefix             = local.resource_prefix
    setup_target                = ""
    setup_import_format_version = 2
    setup_fingerprint           = ""
    setup_fingerprint_version   = 0
    management_url              = var.management_url
    management_config           = local.deployment_management_config
    stack_settings              = local.deployment_settings
    resources                   = local.deployment_resources
    inputValues                 = {}
  }
  depends_on = [
    google_project_iam_custom_role.gcp_role_sandbox_templates,
    google_vertex_ai_reasoning_engine_iam_member.gcp_role_sandbox_templates_agents_engine_templates_0,
    google_artifact_registry_repository.agents_image,
    google_project_iam_custom_role.gcp_role_sandbox_image_write,
    google_artifact_registry_repository_iam_member.agents_image_write,
    google_service_account.agents_preview,
    google_project_iam_custom_role.gcp_role_sandbox_preview_edge,
    google_vertex_ai_reasoning_engine_iam_member.gcp_role_sandbox_preview_edge_agents_engine_preview_0,
    google_project_iam_custom_role.gcp_role_sandbox_preview_sign,
    google_service_account_iam_member.agents_preview_sign_operator_sa,
    google_compute_network.default_network,
    google_compute_subnetwork.default_network_workload,
    google_compute_router.default_network_router,
    google_compute_router_nat.default_network_nat,
    google_compute_firewall.default_network_internal,
    google_compute_subnetwork.default_network_sbx_attachment,
    google_compute_network_attachment.default_network_sbx_attachment,
    google_project_service_identity.default_network_sbx_aiplatform_agent,
    google_project_iam_custom_role.default_network_sbx_attachment,
    google_project_iam_member.default_network_sbx_attachment_agent,
    time_sleep.default_network_sbx_role_propagation,
    google_compute_subnetwork.default_network_sbx_gateway,
    google_compute_router.default_network_sbx_gateway_router,
    google_compute_router_nat.default_network_sbx_gateway_nat,
    google_compute_firewall.default_network_sbx_allow_proxy,
    google_compute_firewall.default_network_sbx_allow_admin,
    google_compute_firewall.default_network_sbx_deny_attachment,
    google_service_account.default_network_sbx_gateway,
    google_project_iam_member.default_network_sbx_gateway_secrets,
    google_compute_instance.default_network_sbx_gateway_0,
    google_compute_instance.default_network_sbx_gateway_1,
    google_service_account.management,
    google_project_iam_custom_role.gcp_role_container_heartbeat,
    google_project_iam_member.gcp_role_container_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_810962d4,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_57427f21,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_931128e1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_810962d4_management_binding_0,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_57427f21_management_binding_1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_931128e1_management_binding_2,
    google_project_iam_custom_role.gcp_role_network_heartbeat,
    google_project_iam_member.gcp_role_network_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_heartbeat,
    google_project_iam_member.gcp_role_sandbox_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_management,
    google_project_iam_member.gcp_role_sandbox_management_management_binding_0,
    google_project_iam_custom_role.gcp_role_manage_sandbox_private_endpoint,
    google_project_iam_member.gcp_role_manage_sandbox_private_endpoint_management_binding_0,
    google_project_iam_custom_role.gcp_role_service_account_quota_metadata,
    google_project_iam_member.gcp_role_service_account_quota_metadata_management_binding_0,
    google_project_iam_member.iam_serviceaccountviewer_management_binding_1,
    google_project_iam_member.iam_roleviewer_management_binding_2,
    google_project_iam_member.serviceusage_serviceusageviewer_management_binding_0,
    google_project_iam_member.secretmanager_viewer_management_binding_0,
    google_iam_workload_identity_pool.management_manager,
    google_iam_workload_identity_pool_provider.management_manager,
    google_service_account_iam_member.management_manager,
    google_project_iam_member.secretmanager_secretaccessor_operator_sa_secrets_vault_sandbox_egress_signing_key_read_binding_0,
    google_project_iam_custom_role.gcp_role_create_secret_manager_secrets,
    google_project_iam_custom_role.gcp_role_write_secret_manager_values,
    google_project_iam_member.gcp_role_create_secret_manager_secrets_management_secrets_vault_data_write_binding_0,
    google_project_iam_member.secretmanager_secretversionadder_management_secrets_vault_data_write_binding_1,
    google_project_iam_member.gcp_role_write_secret_manager_values_management_secrets_vault_data_write_binding_2,
    google_project_iam_member.secretmanager_viewer_management_secrets_vault_heartbeat_binding_0,
    google_service_account.operator_sa,
    google_project_iam_custom_role.gcp_role_sandbox_execute,
    google_project_iam_member.gcp_role_sandbox_execute_operator_sa_binding_0,
    google_project_iam_member.gcp_role_sandbox_management_operator_sa_binding_0,
    google_vertex_ai_reasoning_engine.agents_engine,
    google_project_service.enable_aiplatform,
    google_project_service.enable_artifact_registry,
    google_project_service.enable_cloud_quotas,
    google_project_service.enable_cloud_resource_manager,
    google_project_service.enable_compute_engine,
    google_project_service.enable_iam,
    google_project_service.enable_iam_credentials,
    google_project_service.enable_secret_manager,
    google_project_service.enable_security_token_service,
    time_sleep.gcp_iam_propagation
  ]

  lifecycle {
    precondition {
      condition     = try(local.deployment_settings.setupManagement, "manual") == "manual"
      error_message = format("This setup module was built for manual setup, but the settings request %s setup. Regenerate the setup artifact for the requested setup management.", nonsensitive(sensitive(try(local.deployment_settings.setupManagement == "manual", true))) ? "manual" : nonsensitive(sensitive(try(local.deployment_settings.setupManagement == "automatic", false))) ? "automatic" : "invalid")
    }
  }
}

=== outputs.tf ===
output "deployment_target" {
  value       = "gcp"
  description = "Terraform module target."
}

output "deployment_resource_prefix" {
  value       = local.resource_prefix
  description = "Physical resource prefix."
}

output "deployment_platform" {
  value       = local.deployment_platform
  description = "Target platform."
}

output "deployment_region" {
  value       = local.deployment_region
  description = "Target cloud region or location."
}

output "deployment_setup_target" {
  value       = ""
  description = "Setup target."
}

output "deployment_setup_import_format_version" {
  value       = 2
  description = "Setup registration payload format version."
}

output "deployment_setup_fingerprint" {
  value       = ""
  description = "Setup compatibility fingerprint."
}

output "deployment_setup_fingerprint_version" {
  value       = 0
  description = "Setup fingerprint algorithm version."
}

output "deployment_management_config" {
  value       = jsonencode(local.deployment_management_config)
  description = "Deployment registration management configuration JSON."
}

output "deployment_stack_settings" {
  value       = jsonencode(local.deployment_settings)
  description = "Deployment registration settings JSON."
  sensitive   = true
}

output "deployment_resources" {
  value       = jsonencode(local.deployment_resources)
  description = "Deployment registration resource metadata JSON."
}

=== README.md ===
# Deployment setup - gcpint

Target: `gcp`.

This module creates setup-owned infrastructure, grants the management access needed after setup, and prepares deployment registration metadata. Review the generated `.tf` files before applying; each resource file maps to one setup resource.

## Resources

Names and purpose are authored documentation. Setup components below are derived from this module; review their `.tf` files for permissions and deletion policies. Frozen resources are setup-owned; Live resources are runtime-owned.

