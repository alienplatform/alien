    google_project_iam_custom_role.gcp_role_write_secret_manager_values,
    google_project_iam_member.gcp_role_create_secret_manager_secrets_management_secrets_vault_data_write_binding_0,
    google_project_iam_member.secretmanager_secretversionadder_management_secrets_vault_data_write_binding_1,
    google_project_iam_member.gcp_role_write_secret_manager_values_management_secrets_vault_data_write_binding_2,
    google_project_iam_member.secretmanager_viewer_management_secrets_vault_heartbeat_binding_0,
    google_service_account.operator_sa,
    google_project_iam_custom_role.gcp_role_sandbox_execute,
    google_project_iam_member.gcp_role_sandbox_execute_operator_sa_binding_0,
    google_project_iam_member.gcp_role_sandbox_management_operator_sa_binding_0,
    google_compute_network.default_network,
    google_compute_subnetwork.default_network_workload,
    google_compute_router.default_network_router,
    google_compute_router_nat.default_network_nat,
    google_compute_firewall.default_network_internal,
    google_compute_subnetwork.default_network_sbx_attachment,
    google_compute_network_attachment.default_network_sbx_attachment,
    google_project_service_identity.default_network_sbx_aiplatform_agent,
    google_project_iam_custom_role.default_network_sbx_attachment,
    google_project_iam_member.default_network_sbx_attachment_agent,
    time_sleep.default_network_sbx_role_propagation,
    google_compute_subnetwork.default_network_sbx_gateway,
    google_compute_router.default_network_sbx_gateway_router,
    google_compute_router_nat.default_network_sbx_gateway_nat,
    google_compute_firewall.default_network_sbx_allow_proxy,
    google_compute_firewall.default_network_sbx_allow_admin,
    google_compute_firewall.default_network_sbx_deny_attachment,
    google_service_account.default_network_sbx_gateway,
    google_project_iam_member.default_network_sbx_gateway_secrets,
    google_compute_instance.default_network_sbx_gateway_0,
    google_compute_instance.default_network_sbx_gateway_1,
    google_service_account.management,
    google_project_iam_custom_role.gcp_role_container_heartbeat,
    google_project_iam_member.gcp_role_container_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_810962d4,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_57427f21,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_931128e1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_810962d4_management_binding_0,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_57427f21_management_binding_1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_931128e1_management_binding_2,
    google_project_iam_custom_role.gcp_role_network_heartbeat,
    google_project_iam_member.gcp_role_network_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_heartbeat,
    google_project_iam_member.gcp_role_sandbox_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_management,
    google_project_iam_member.gcp_role_sandbox_management_management_binding_0,
    google_project_iam_custom_role.gcp_role_manage_sandbox_private_endpoint,
    google_project_iam_member.gcp_role_manage_sandbox_private_endpoint_management_binding_0,
    google_project_iam_custom_role.gcp_role_service_account_quota_metadata,
    google_project_iam_member.gcp_role_service_account_quota_metadata_management_binding_0,
    google_project_iam_member.iam_serviceaccountviewer_management_binding_1,
    google_project_iam_member.iam_roleviewer_management_binding_2,
    google_project_iam_member.serviceusage_serviceusageviewer_management_binding_0,
    google_project_iam_member.secretmanager_viewer_management_binding_0,
    google_iam_workload_identity_pool.management_manager,
    google_iam_workload_identity_pool_provider.management_manager,
    google_service_account_iam_member.management_manager
  ]

  docker_config {
    immutable_tags = true
  }

  cleanup_policies {
    id     = "delete-untagged"
    action = "DELETE"

    condition {
      tag_state  = "UNTAGGED"
      older_than = "604800s"
    }
  }

  lifecycle {
    precondition {
      condition     = length(replace(lower(format("%s-agents-img", local.resource_prefix)), "_", "-")) <= 63
      error_message = "The image repository name of sandbox 'agents' (resource_prefix, the sandbox id and '-img') is longer than the 63 characters Artifact Registry allows. Use a shorter resource_prefix."
    }
  }
}

