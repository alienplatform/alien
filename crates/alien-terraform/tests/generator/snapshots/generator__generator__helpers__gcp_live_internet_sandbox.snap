=== default_network.tf ===
variable "default_network_sbx_gateway_machine_type" {
  type        = string
  default     = "e2-standard-2"
  description = "Compute Engine machine type of the two egress gateway VMs. Use one with at least 2 vCPUs and 4 GiB of memory that your project has quota for."
}

data "google_compute_network" "default_network" {
  count   = var.network_mode != "create-new" ? 1 : 0
  name    = var.network_mode == "use-default" ? "default" : var.network_name
  project = var.gcp_project
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

data "google_compute_subnetwork" "default_network_existing_subnet" {
  count   = var.network_mode != "create-new" ? 1 : 0
  name    = var.network_mode == "use-default" ? "default" : var.subnet_name
  project = var.gcp_project
  region  = var.network_mode == "use-default" || var.network_region == "" ? var.gcp_region : var.network_region
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

data "google_project" "default_network_sbx_project" {
  project_id = var.gcp_project
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

data "google_compute_zones" "default_network_sbx" {
  project = var.gcp_project
  region  = var.gcp_region
  status  = "UP"
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_network" "default_network" {
  count                   = var.network_mode == "create-new" ? 1 : 0
  name                    = trim(substr("${local.resource_prefix}-default-network", 0, 63), "-")
  project                 = var.gcp_project
  auto_create_subnetworks = false
  routing_mode            = "REGIONAL"
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_subnetwork" "default_network_workload" {
  count                    = var.network_mode == "create-new" ? 1 : 0
  name                     = trim(substr("${local.resource_prefix}-default-network-workload", 0, 63), "-")
  project                  = var.gcp_project
  region                   = var.gcp_region
  ip_cidr_range            = "10.44.0.0/16"
  network                  = google_compute_network.default_network[0].id
  private_ip_google_access = true
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_router" "default_network_router" {
  count   = var.network_mode == "create-new" ? 1 : 0
  name    = trim(substr("${local.resource_prefix}-default-network-router", 0, 63), "-")
  project = var.gcp_project
  region  = var.gcp_region
  network = google_compute_network.default_network[0].id
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_router_nat" "default_network_nat" {
  count                              = var.network_mode == "create-new" ? 1 : 0
  name                               = trim(substr("${local.resource_prefix}-default-network-nat", 0, 63), "-")
  project                            = var.gcp_project
  region                             = var.gcp_region
  router                             = google_compute_router.default_network_router[0].name
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "LIST_OF_SUBNETWORKS"

  log_config {
    enable = true
    filter = "ERRORS_ONLY"
  }

  subnetwork {
    name = google_compute_subnetwork.default_network_workload[0].self_link
    source_ip_ranges_to_nat = [
      "ALL_IP_RANGES"
    ]
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_firewall" "default_network_internal" {
  count     = var.network_mode == "create-new" ? 1 : 0
  name      = trim(substr("${local.resource_prefix}-default-network-internal", 0, 63), "-")
  project   = var.gcp_project
  network   = google_compute_network.default_network[0].id
  direction = "INGRESS"
  source_ranges = [
    "10.44.0.0/16"
  ]

  allow {
    protocol = "all"
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_subnetwork" "default_network_sbx_attachment" {
  name          = trim(substr("${local.resource_prefix}-sbx-attachment", 0, 63), "-")
  project       = var.gcp_project
  region        = var.gcp_region
  ip_cidr_range = "192.168.250.0/28"
  network       = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_network_attachment" "default_network_sbx_attachment" {
  name                  = trim(substr("${local.resource_prefix}-sbx-attachment", 0, 63), "-")
  project               = var.gcp_project
  region                = var.gcp_region
  connection_preference = "ACCEPT_AUTOMATIC"
  subnetworks = [
    google_compute_subnetwork.default_network_sbx_attachment.self_link
  ]
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_project_service_identity" "default_network_sbx_aiplatform_agent" {
  provider = google-beta
  project  = var.gcp_project
  service  = "aiplatform.googleapis.com"
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_project_iam_custom_role" "default_network_sbx_attachment" {
  role_id     = replace("${local.resource_prefix}_sandbox_attachment", "-", "_")
  title       = "Alien sandbox network attachment"
  description = "Lets Agent Platform connect sandboxes to the network attachment"
  project     = var.gcp_project
  permissions = [
    "compute.networkAttachments.get",
    "compute.networkAttachments.update"
  ]
}

resource "google_project_iam_member" "default_network_sbx_attachment_agent" {
  project = var.gcp_project
  role    = google_project_iam_custom_role.default_network_sbx_attachment.name
  member  = "serviceAccount:service-${data.google_project.default_network_sbx_project.number}@gcp-sa-aiplatform.iam.gserviceaccount.com"
  depends_on = [
    google_project_service_identity.default_network_sbx_aiplatform_agent
  ]
}

resource "time_sleep" "default_network_sbx_role_propagation" {
  create_duration = "180s"
  depends_on = [
    google_project_iam_member.default_network_sbx_attachment_agent,
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_subnetwork" "default_network_sbx_gateway" {
  name                     = trim(substr("${local.resource_prefix}-sbx-gateway", 0, 63), "-")
  project                  = var.gcp_project
  region                   = var.gcp_region
  ip_cidr_range            = "192.168.251.0/27"
  network                  = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  private_ip_google_access = true
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_router" "default_network_sbx_gateway_router" {
  name    = trim(substr("${local.resource_prefix}-sbx-gateway-router", 0, 63), "-")
  project = var.gcp_project
  region  = var.gcp_region
  network = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_router_nat" "default_network_sbx_gateway_nat" {
  name                               = trim(substr("${local.resource_prefix}-sbx-gateway-nat", 0, 63), "-")
  project                            = var.gcp_project
  region                             = var.gcp_region
  router                             = google_compute_router.default_network_sbx_gateway_router.name
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "LIST_OF_SUBNETWORKS"

  subnetwork {
    name = google_compute_subnetwork.default_network_sbx_gateway.self_link
    source_ip_ranges_to_nat = [
      "ALL_IP_RANGES"
    ]
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_firewall" "default_network_sbx_allow_proxy" {
  name      = trim(substr("${local.resource_prefix}-sbx-allow-proxy", 0, 63), "-")
  project   = var.gcp_project
  network   = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  direction = "INGRESS"
  priority  = 900
  source_ranges = [
    google_compute_subnetwork.default_network_sbx_attachment.ip_cidr_range
  ]
  target_tags = [
    "alien-sandbox-gateway"
  ]

  allow {
    protocol = "tcp"
    ports = [
      "22"
    ]
  }

  log_config {
    metadata = "INCLUDE_ALL_METADATA"
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_firewall" "default_network_sbx_allow_admin" {
  name      = trim(substr("${local.resource_prefix}-sbx-allow-admin", 0, 63), "-")
  project   = var.gcp_project
  network   = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  direction = "INGRESS"
  priority  = 900
  source_ranges = [
    google_compute_subnetwork.default_network_sbx_gateway.ip_cidr_range,
    var.network_mode == "create-new" ? google_compute_subnetwork.default_network_workload[0].ip_cidr_range : data.google_compute_subnetwork.default_network_existing_subnet[0].ip_cidr_range
  ]
  target_tags = [
    "alien-sandbox-gateway"
  ]

  allow {
    protocol = "tcp"
    ports = [
      "3129"
    ]
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_firewall" "default_network_sbx_deny_attachment" {
  name      = trim(substr("${local.resource_prefix}-sbx-deny-attachment", 0, 63), "-")
  project   = var.gcp_project
  network   = var.network_mode == "create-new" ? google_compute_network.default_network[0].id : data.google_compute_network.default_network[0].id
  direction = "INGRESS"
  priority  = 1000
  source_ranges = [
    google_compute_subnetwork.default_network_sbx_attachment.ip_cidr_range
  ]

  deny {
    protocol = "all"
  }

  log_config {
    metadata = "INCLUDE_ALL_METADATA"
  }

  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_service_account" "default_network_sbx_gateway" {
  account_id   = trim(substr("sbx-gw-${local.resource_prefix}", 0, 30), "-")
  project      = var.gcp_project
  display_name = "Alien sandbox egress gateway"
  depends_on = [
    google_project_service.enable_compute_engine
  ]
}

resource "google_project_iam_member" "default_network_sbx_gateway_secrets" {
  project = var.gcp_project
  role    = "roles/secretmanager.secretAccessor"
  member  = "serviceAccount:${google_service_account.default_network_sbx_gateway.email}"

  condition {
    title      = "gateway secrets only"
    expression = "resource.name.startsWith(\"projects/${data.google_project.default_network_sbx_project.number}/secrets/${local.resource_prefix}-secrets-sandbox-egress-gateway-config/\") || resource.name.startsWith(\"projects/${data.google_project.default_network_sbx_project.number}/secrets/${local.resource_prefix}-secrets-sandbox-egress-replica-secret/\")"
  }
}

resource "google_compute_instance" "default_network_sbx_gateway_0" {
  name         = trim(substr("${local.resource_prefix}-sbx-gateway-0", 0, 63), "-")
  project      = var.gcp_project
  zone         = data.google_compute_zones.default_network_sbx.names[0]
  machine_type = var.default_network_sbx_gateway_machine_type
  tags = [
    "alien-sandbox-gateway"
  ]

  boot_disk {
    initialize_params {
      image = "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      size  = 20
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.default_network_sbx_gateway.self_link
    network_ip = cidrhost(google_compute_subnetwork.default_network_sbx_gateway.ip_cidr_range, 10)
  }

  service_account {
    email = google_service_account.default_network_sbx_gateway.email
    scopes = [
      "cloud-platform"
    ]
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  metadata = {
    "block-project-ssh-keys" = "true"
    "enable-oslogin"         = "TRUE"
  }
  metadata_startup_script = format("#!/bin/bash\nset -u\nfor i in $(seq 1 30); do apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io iptables && break; sleep 10; done\nfor i in $(seq 1 30); do docker pull ghcr.io/alienplatform/alien-egress-gateway@sha256:40a22a2aebf068da82d4310043875b383cdeba9cfa0aa90a649d67f70398a037 && break; sleep 10; done\numask 077\ncat > /etc/alien-egress-gateway.env <<'ENV'\nALIEN_DEPLOYMENT_TYPE=gcp\nGCP_PROJECT_ID=%s\nGCP_REGION=%s\nALIEN_SECRETS_BINDING=%s\nRUST_LOG=warn\nENV\ncat > /etc/systemd/system/alien-egress-gateway.service <<'UNIT'\n[Unit]\nDescription=Alien egress gateway\nAfter=docker.service network-online.target\nRequires=docker.service\n[Service]\nRestart=always\nRestartSec=3\nExecStartPre=-/usr/bin/docker rm -f gateway\nExecStartPre=/bin/sh -c 'iptables -t nat -C PREROUTING -s 192.168.250.0/28 -p tcp --dport 22 -j REDIRECT --to-ports 3128 || iptables -t nat -I PREROUTING 1 -s 192.168.250.0/28 -p tcp --dport 22 -j REDIRECT --to-ports 3128'\nExecStart=/usr/bin/docker run --name gateway --env-file /etc/alien-egress-gateway.env --user 1000:1000 --cap-drop ALL --memory 2g --security-opt no-new-privileges --read-only --tmpfs /tmp -p 3128:3128 -p 3129:3129 ghcr.io/alienplatform/alien-egress-gateway@sha256:40a22a2aebf068da82d4310043875b383cdeba9cfa0aa90a649d67f70398a037\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable alien-egress-gateway.service\nsystemctl restart alien-egress-gateway.service\n", var.gcp_project, var.gcp_region, jsonencode({ service = "secret-manager", vaultPrefix = "${local.resource_prefix}-secrets" }))
  depends_on = [
    google_compute_router_nat.default_network_sbx_gateway_nat,
    google_project_iam_member.default_network_sbx_gateway_secrets,
    google_project_service.enable_compute_engine
  ]
}

resource "google_compute_instance" "default_network_sbx_gateway_1" {
  name         = trim(substr("${local.resource_prefix}-sbx-gateway-1", 0, 63), "-")
  project      = var.gcp_project
  zone         = data.google_compute_zones.default_network_sbx.names[1]
  machine_type = var.default_network_sbx_gateway_machine_type
  tags = [
    "alien-sandbox-gateway"
  ]

  boot_disk {
    initialize_params {
      image = "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      size  = 20
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.default_network_sbx_gateway.self_link
    network_ip = cidrhost(google_compute_subnetwork.default_network_sbx_gateway.ip_cidr_range, 11)
  }

  service_account {
    email = google_service_account.default_network_sbx_gateway.email
    scopes = [
      "cloud-platform"
    ]
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  metadata = {
    "block-project-ssh-keys" = "true"
    "enable-oslogin"         = "TRUE"
  }
  metadata_startup_script = format("#!/bin/bash\nset -u\nfor i in $(seq 1 30); do apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io iptables && break; sleep 10; done\nfor i in $(seq 1 30); do docker pull ghcr.io/alienplatform/alien-egress-gateway@sha256:40a22a2aebf068da82d4310043875b383cdeba9cfa0aa90a649d67f70398a037 && break; sleep 10; done\numask 077\ncat > /etc/alien-egress-gateway.env <<'ENV'\nALIEN_DEPLOYMENT_TYPE=gcp\nGCP_PROJECT_ID=%s\nGCP_REGION=%s\nALIEN_SECRETS_BINDING=%s\nRUST_LOG=warn\nENV\ncat > /etc/systemd/system/alien-egress-gateway.service <<'UNIT'\n[Unit]\nDescription=Alien egress gateway\nAfter=docker.service network-online.target\nRequires=docker.service\n[Service]\nRestart=always\nRestartSec=3\nExecStartPre=-/usr/bin/docker rm -f gateway\nExecStartPre=/bin/sh -c 'iptables -t nat -C PREROUTING -s 192.168.250.0/28 -p tcp --dport 22 -j REDIRECT --to-ports 3128 || iptables -t nat -I PREROUTING 1 -s 192.168.250.0/28 -p tcp --dport 22 -j REDIRECT --to-ports 3128'\nExecStart=/usr/bin/docker run --name gateway --env-file /etc/alien-egress-gateway.env --user 1000:1000 --cap-drop ALL --memory 2g --security-opt no-new-privileges --read-only --tmpfs /tmp -p 3128:3128 -p 3129:3129 ghcr.io/alienplatform/alien-egress-gateway@sha256:40a22a2aebf068da82d4310043875b383cdeba9cfa0aa90a649d67f70398a037\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable alien-egress-gateway.service\nsystemctl restart alien-egress-gateway.service\n", var.gcp_project, var.gcp_region, jsonencode({ service = "secret-manager", vaultPrefix = "${local.resource_prefix}-secrets" }))
  depends_on = [
    google_compute_router_nat.default_network_sbx_gateway_nat,
    google_project_iam_member.default_network_sbx_gateway_secrets,
    google_project_service.enable_compute_engine
  ]
}

=== management.tf ===
data "google_project" "current" {
  project_id = var.gcp_project
}

resource "google_service_account" "management" {
  project      = var.gcp_project
  account_id   = format("%s-%s", trim(substr(replace(lower(format("a-%s-management", local.resource_prefix)), "_", "-"), 0, 21), "-"), substr(sha1(replace(lower(format("%s-management", local.resource_prefix)), "_", "-")), 0, 8))
  display_name = "${local.deployment_name}: Management service account"
  description  = "Management cloud identity for ${local.deployment_name}. Resource prefix: ${local.resource_prefix}."
}

resource "google_project_iam_custom_role" "gcp_role_container_heartbeat" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_container_heartbeat", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Container heartbeat"
  description = "Used by ${local.deployment_name}. Allows readonly health monitoring for containers and their cloud infrastructure (LB target health, volume status). Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "compute.backendServices.get",
    "compute.disks.get"
  ]
}

resource "google_project_iam_member" "gcp_role_container_heartbeat_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_container_heartbeat[0].name : format("projects/%s/roles/role_%s_container_heartbeat", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_container_provision_inspect_clo_810962d4" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_container_provision_inspect_clo_810962d4", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Container provision - Inspect Cloud Networking 73c"
  description = "Used by ${local.deployment_name}. Allows creating container infrastructure (load balancers, volumes, certificates). Derived from AwsContainerController, GcpContainerController, AzureContainerController API calls. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "compute.backendServices.create",
    "compute.backendServices.delete",
    "compute.backendServices.get",
    "compute.backendServices.update",
    "compute.backendServices.use",
    "compute.globalAddresses.create",
    "compute.globalAddresses.delete",
    "compute.globalAddresses.get",
    "compute.globalAddresses.use",
    "compute.globalForwardingRules.create",
    "compute.globalForwardingRules.delete",
    "compute.globalForwardingRules.get",
    "compute.healthChecks.create",
    "compute.healthChecks.delete",
    "compute.healthChecks.get",
    "compute.healthChecks.update",
    "compute.healthChecks.useReadOnly",
    "compute.networkEndpointGroups.create",
    "compute.networkEndpointGroups.delete",
    "compute.networkEndpointGroups.get",
    "compute.networkEndpointGroups.use",
    "compute.sslCertificates.create",
    "compute.sslCertificates.delete",
    "compute.sslCertificates.get",
    "compute.targetHttpsProxies.create",
    "compute.targetHttpsProxies.delete",
    "compute.targetHttpsProxies.get",
    "compute.targetHttpsProxies.use",
    "compute.targetTcpProxies.create",
    "compute.targetTcpProxies.delete",
    "compute.targetTcpProxies.use",
    "compute.urlMaps.create",
    "compute.urlMaps.delete",
    "compute.urlMaps.get",
    "compute.urlMaps.use",
    "compute.zones.list"
  ]
}

resource "google_project_iam_custom_role" "gcp_role_container_provision_inspect_clo_57427f21" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_container_provision_inspect_clo_57427f21", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Container provision - Inspect Cloud Networking 13f"
  description = "Used by ${local.deployment_name}. Allows creating container infrastructure (load balancers, volumes, certificates). Derived from AwsContainerController, GcpContainerController, AzureContainerController API calls. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "compute.disks.create",
    "compute.disks.delete",
    "compute.disks.get",
    "compute.disks.resize",
    "compute.zones.list"
  ]
}

resource "google_project_iam_custom_role" "gcp_role_container_provision_inspect_clo_931128e1" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_container_provision_inspect_clo_931128e1", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Container provision - Inspect Cloud Networking Ff6"
  description = "Used by ${local.deployment_name}. Allows creating container infrastructure (load balancers, volumes, certificates). Derived from AwsContainerController, GcpContainerController, AzureContainerController API calls. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "compute.disks.addResourcePolicies",
    "compute.disks.createSnapshot",
    "compute.disks.removeResourcePolicies",
    "compute.regionOperations.get",
    "compute.resourcePolicies.create",
    "compute.resourcePolicies.delete",
    "compute.resourcePolicies.get",
    "compute.resourcePolicies.use",
    "compute.snapshots.create",
    "compute.snapshots.delete",
    "compute.snapshots.get",
    "compute.snapshots.list",
    "compute.snapshots.setLabels",
    "compute.snapshots.useReadOnly",
    "compute.zoneOperations.get"
  ]
}

resource "google_project_iam_member" "gcp_role_container_provision_inspect_clo_810962d4_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_810962d4[0].name : format("projects/%s/roles/role_%s_container_provision_inspect_clo_810962d4", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "gcp_role_container_provision_inspect_clo_57427f21_management_binding_1" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_57427f21[0].name : format("projects/%s/roles/role_%s_container_provision_inspect_clo_57427f21", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "gcp_role_container_provision_inspect_clo_931128e1_management_binding_2" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_931128e1[0].name : format("projects/%s/roles/role_%s_container_provision_inspect_clo_931128e1", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_network_heartbeat" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_network_heartbeat", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Network heartbeat"
  description = "Used by ${local.deployment_name}. Allows reading network metadata needed to monitor and consume imported network infrastructure. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "compute.firewalls.get",
    "compute.networks.get",
    "compute.routers.get",
    "compute.subnetworks.get"
  ]
}

resource "google_project_iam_member" "gcp_role_network_heartbeat_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_network_heartbeat[0].name : format("projects/%s/roles/role_%s_network_heartbeat", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_sandbox_heartbeat" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_sandbox_heartbeat", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Sandbox heartbeat"
  description = "Used by ${local.deployment_name}. Allows reading sandbox parent state. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "aiplatform.sandboxEnvironmentTemplates.get"
  ]
}

resource "google_project_iam_member" "gcp_role_sandbox_heartbeat_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_sandbox_heartbeat[0].name : format("projects/%s/roles/role_%s_sandbox_heartbeat", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_sandbox_management" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_sandbox_management", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Sandbox management"
  description = "Used by ${local.deployment_name}. Allows creating and terminating sandboxes (no access to sandbox contents). Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "aiplatform.sandboxEnvironments.create",
    "aiplatform.sandboxEnvironments.delete",
    "aiplatform.sandboxEnvironments.get",
    "aiplatform.sandboxEnvironments.list",
    "aiplatform.sandboxEnvironments.pause",
    "aiplatform.sandboxEnvironments.resume",
    "aiplatform.sandboxEnvironments.snapshot"
  ]
}

resource "google_project_iam_member" "gcp_role_sandbox_management_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_sandbox_management[0].name : format("projects/%s/roles/role_%s_sandbox_management", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_manage_sandbox_private_endpoint" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_manage_sandbox_private_endpoint", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Manage Sandbox Private Endpoint"
  description = "Used by ${local.deployment_name}. Read the project's sandbox placement and manage the private endpoint Internet sandboxes are reached through. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "aiplatform.reasoningEngines.list",
    "aiplatform.sandboxEnvironments.create",
    "aiplatform.sandboxEnvironments.delete",
    "aiplatform.sandboxEnvironments.get",
    "aiplatform.sandboxEnvironments.list",
    "compute.addresses.create",
    "compute.addresses.createInternal",
    "compute.addresses.delete",
    "compute.addresses.deleteInternal",
    "compute.addresses.get",
    "compute.addresses.use",
    "compute.addresses.useInternal",
    "compute.forwardingRules.create",
    "compute.forwardingRules.delete",
    "compute.forwardingRules.get",
    "compute.forwardingRules.pscCreate",
    "compute.forwardingRules.pscDelete",
    "compute.networkAttachments.get",
    "compute.networkAttachments.list",
    "compute.networks.use",
    "compute.regionOperations.get",
    "compute.subnetworks.use",
    "servicedirectory.services.delete"
  ]
}

resource "google_project_iam_member" "gcp_role_manage_sandbox_private_endpoint_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_manage_sandbox_private_endpoint[0].name : format("projects/%s/roles/role_%s_manage_sandbox_private_endpoint", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_custom_role" "gcp_role_service_account_quota_metadata" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_service_account_quota_metadata", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Service Account Quota Metadata"
  description = "Used by ${local.deployment_name}. Read applied project quotas and service-account inventory. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "iam.serviceAccounts.list",
    "serviceusage.quotas.get"
  ]
}

resource "google_project_iam_member" "gcp_role_service_account_quota_metadata_management_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_service_account_quota_metadata[0].name : format("projects/%s/roles/role_%s_service_account_quota_metadata", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "iam_serviceaccountviewer_management_binding_1" {
  project = var.gcp_project
  role    = "roles/iam.serviceAccountViewer"
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "iam_roleviewer_management_binding_2" {
  project = var.gcp_project
  role    = "roles/iam.roleViewer"
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "serviceusage_serviceusageviewer_management_binding_0" {
  project = var.gcp_project
  role    = "roles/serviceusage.serviceUsageViewer"
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "secretmanager_viewer_management_binding_0" {
  project = var.gcp_project
  role    = "roles/secretmanager.viewer"
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_iam_workload_identity_pool" "management_manager" {
  project                   = var.gcp_project
  workload_identity_pool_id = "deployment-${substr(sha256("gcp-deployment-access-v1:${base64encode(var.deployment_id)}:${base64encode("remote-stack-management")}"), 0, 20)}"
  display_name              = "Deployment access"
  description               = "Deployment identity pool. Scope: urn:deployment-access:v1:${sha256("gcp-deployment-access-v1:${base64encode(var.deployment_id)}:${base64encode("remote-stack-management")}")}"
}

resource "google_iam_workload_identity_pool_provider" "management_manager" {
  project                            = var.gcp_project
  workload_identity_pool_id          = google_iam_workload_identity_pool.management_manager.workload_identity_pool_id
  workload_identity_pool_provider_id = "manager"
  attribute_mapping = {
    "google.subject" = "assertion.sub"
  }
  attribute_condition = "assertion.sub == ${jsonencode(var.managing_oidc_subject)}"

  oidc {
    issuer_uri = var.managing_oidc_issuer
    allowed_audiences = [
      "urn:deployment-access:v1:${sha256("gcp-deployment-access-v1:${base64encode(var.deployment_id)}:${base64encode("remote-stack-management")}")}"
    ]
  }
}

resource "google_service_account_iam_member" "management_manager" {
  service_account_id = google_service_account.management.id
  role               = "roles/iam.workloadIdentityUser"
  member             = "principal://iam.googleapis.com/${google_iam_workload_identity_pool.management_manager.name}/subject/${var.managing_oidc_subject}"
  depends_on = [
    google_iam_workload_identity_pool_provider.management_manager
  ]
}

=== secrets.tf ===
resource "google_project_iam_member" "secretmanager_secretaccessor_operator_sa_secrets_vault_sandbox_egress_signing_key_read_binding_0" {
  project = var.gcp_project
  role    = "roles/secretmanager.secretAccessor"
  member  = "serviceAccount:${google_service_account.operator_sa.email}"

  condition {
    title       = "SandboxEgressSigningKeyRead"
    description = "Limit to SandboxEgressSigningKeyRead"
    expression  = "resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-secrets-sandbox-egress-signing-key/\")"
  }
}

resource "google_project_iam_custom_role" "gcp_role_create_secret_manager_secrets" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_create_secret_manager_secrets", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Create Secret Manager Secrets"
  description = "Used by ${local.deployment_name}. Create application-owned Secret Manager secrets. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "secretmanager.secrets.create"
  ]
}

resource "google_project_iam_custom_role" "gcp_role_write_secret_manager_values" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_write_secret_manager_values", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Write Secret Manager Values"
  description = "Used by ${local.deployment_name}. Add values to application-owned Secret Manager secrets and delete those secrets during cleanup. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "secretmanager.secrets.delete",
    "secretmanager.secrets.get"
  ]
}

resource "google_project_iam_member" "gcp_role_create_secret_manager_secrets_management_secrets_vault_data_write_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_create_secret_manager_secrets[0].name : format("projects/%s/roles/role_%s_create_secret_manager_secrets", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"
}

resource "google_project_iam_member" "secretmanager_secretversionadder_management_secrets_vault_data_write_binding_1" {
  project = var.gcp_project
  role    = "roles/secretmanager.secretVersionAdder"
  member  = "serviceAccount:${google_service_account.management.email}"

  condition {
    title       = "ResourceVaultSecrets"
    description = "Limit to ResourceVaultSecrets"
    expression  = "(resource.type == \"secretmanager.googleapis.com/Secret\" || resource.type == \"secretmanager.googleapis.com/SecretVersion\") && resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-secrets-\") && !resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-deployer-secrets-\")"
  }
}

resource "google_project_iam_member" "gcp_role_write_secret_manager_values_management_secrets_vault_data_write_binding_2" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_write_secret_manager_values[0].name : format("projects/%s/roles/role_%s_write_secret_manager_values", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.management.email}"

  condition {
    title       = "ResourceVaultSecrets"
    description = "Limit to ResourceVaultSecrets"
    expression  = "(resource.type == \"secretmanager.googleapis.com/Secret\" || resource.type == \"secretmanager.googleapis.com/SecretVersion\") && resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-secrets-\") && !resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-deployer-secrets-\")"
  }
}

resource "google_project_iam_member" "secretmanager_viewer_management_secrets_vault_heartbeat_binding_0" {
  project = var.gcp_project
  role    = "roles/secretmanager.viewer"
  member  = "serviceAccount:${google_service_account.management.email}"

  condition {
    title       = "ResourceVaultSecretsHeartbeat"
    description = "Limit to ResourceVaultSecretsHeartbeat"
    expression  = "resource.type == \"secretmanager.googleapis.com/Secret\" && resource.name.startsWith(\"projects/${data.google_project.current.number}/secrets/${local.resource_prefix}-secrets-\")"
  }
}

=== operator_sa.tf ===
resource "google_service_account" "operator_sa" {
  project      = var.gcp_project
  account_id   = format("%s-%s", trim(substr(replace(lower(format("a-%s-operator_sa", local.resource_prefix)), "_", "-"), 0, 21), "-"), substr(sha1(replace(lower(format("%s-operator_sa", local.resource_prefix)), "_", "-")), 0, 8))
  display_name = "${local.deployment_name}: Runtime service account (operator-sa)"
  description  = "Runtime cloud identity for ${local.deployment_name}. Resource prefix: ${local.resource_prefix}. Resource: operator_sa."
}

resource "google_project_iam_custom_role" "gcp_role_sandbox_execute" {
  count       = var.gcp_manage_custom_roles ? 1 : 0
  project     = var.gcp_project
  role_id     = format("role_%s_sandbox_execute", local.gcp_custom_role_prefix)
  title       = "${local.deployment_name}: Sandbox execute"
  description = "Used by ${local.deployment_name}. Allows running commands and moving files inside an existing sandbox. Resource prefix: ${local.resource_prefix}."
  stage       = "GA"
  permissions = [
    "aiplatform.sandboxEnvironments.execute"
  ]
}

resource "google_project_iam_member" "gcp_role_sandbox_execute_operator_sa_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_sandbox_execute[0].name : format("projects/%s/roles/role_%s_sandbox_execute", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.operator_sa.email}"
}

resource "google_project_iam_member" "gcp_role_sandbox_management_operator_sa_binding_0" {
  project = var.gcp_project
  role    = var.gcp_manage_custom_roles ? google_project_iam_custom_role.gcp_role_sandbox_management[0].name : format("projects/%s/roles/role_%s_sandbox_management", var.gcp_project, local.gcp_custom_role_prefix)
  member  = "serviceAccount:${google_service_account.operator_sa.email}"
}

=== agents_engine.tf ===
resource "google_vertex_ai_reasoning_engine" "agents_engine" {
  provider     = google-beta
  region       = var.gcp_region
  display_name = "${local.resource_prefix}-agents-engine"
  labels = {
    "managed-by"    = "setup"
    deployment      = local.resource_prefix
    resource        = "agents-engine"
    "resource-type" = "sandbox-engine"
  }
  depends_on = [
    google_service_account.management,
    google_project_iam_custom_role.gcp_role_container_heartbeat,
    google_project_iam_member.gcp_role_container_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_810962d4,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_57427f21,
    google_project_iam_custom_role.gcp_role_container_provision_inspect_clo_931128e1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_810962d4_management_binding_0,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_57427f21_management_binding_1,
    google_project_iam_member.gcp_role_container_provision_inspect_clo_931128e1_management_binding_2,
    google_project_iam_custom_role.gcp_role_network_heartbeat,
    google_project_iam_member.gcp_role_network_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_heartbeat,
    google_project_iam_member.gcp_role_sandbox_heartbeat_management_binding_0,
    google_project_iam_custom_role.gcp_role_sandbox_management,
    google_project_iam_member.gcp_role_sandbox_management_management_binding_0,
    google_project_iam_custom_role.gcp_role_manage_sandbox_private_endpoint,
    google_project_iam_member.gcp_role_manage_sandbox_private_endpoint_management_binding_0,
    google_project_iam_custom_role.gcp_role_service_account_quota_metadata,
    google_project_iam_member.gcp_role_service_account_quota_metadata_management_binding_0,
    google_project_iam_member.iam_serviceaccountviewer_management_binding_1,
    google_project_iam_member.iam_roleviewer_management_binding_2,
    google_project_iam_member.serviceusage_serviceusageviewer_management_binding_0,
    google_project_iam_member.secretmanager_viewer_management_binding_0,
    google_iam_workload_identity_pool.management_manager,
    google_iam_workload_identity_pool_provider.management_manager,
    google_service_account_iam_member.management_manager
  ]
}

