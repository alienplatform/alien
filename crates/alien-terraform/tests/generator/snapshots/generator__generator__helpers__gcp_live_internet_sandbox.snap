locals {
  resource_prefix              = var.resource_prefix == "" ? format("a%s", random_id.resource_prefix.hex) : var.resource_prefix
  deployment_name              = var.name
  gcp_custom_role_prefix       = var.gcp_custom_role_prefix != "" ? substr(replace(lower(var.gcp_custom_role_prefix), "-", "_"), 0, 18) : length(replace(lower(local.resource_prefix), "-", "_")) <= 18 ? replace(lower(local.resource_prefix), "-", "_") : format("%s_%s", substr(replace(lower(local.resource_prefix), "-", "_"), 0, 9), substr(sha256(local.resource_prefix), 0, 8))
  deployment_platform          = "gcp"
  deployment_target            = "gcp"
  deployment_region            = var.gcp_region
  deployment_management_config = var.deployment_model == "push" ? { platform = "gcp", projectId = var.gcp_project, serviceAccountEmail = var.managing_service_account_email, federationTrust = var.managing_oidc_issuer != "" ? { issuer = var.managing_oidc_issuer, subject = var.managing_oidc_subject } : null } : null
  advanced_settings            = merge(jsondecode(var.advanced_settings_json), jsondecode(var.advanced_settings_overlay_json))
  deployment_settings          = merge(local.advanced_settings, { deploymentModel = var.deployment_model, updates = var.updates_mode, telemetry = var.telemetry_mode, heartbeats = var.heartbeats_mode, endpointAccess = var.endpoint_access, network = jsondecode(var.network_mode == "create-new" ? jsonencode({ type = "create", cidr = var.network_cidr == "" ? null : var.network_cidr, availabilityZones = var.availability_zones }) : var.network_mode == "use-existing" ? jsonencode({ type = "byo-vpc-gcp", networkName = var.network_name, subnetName = var.subnet_name, region = var.network_region == "" ? var.gcp_region : var.network_region }) : jsonencode({ type = "use-default" })) })
  deployment_resources = [
    {
      id   = "agents"
      type = "sandbox"
      importData = {
        region                = var.gcp_region
        previewServiceAccount = "${google_service_account.agents_preview.email}"
      }
    },
    {
      id   = "default-network"
      type = "network"
      importData = {
        projectId       = var.gcp_project
        vpcSelfLink     = var.network_mode == "create-new" ? google_compute_network.default_network[0].self_link : data.google_compute_network.default_network[0].self_link
        vpcName         = var.network_mode == "create-new" ? google_compute_network.default_network[0].name : data.google_compute_network.default_network[0].name
        subnetSelfLinks = var.network_mode == "create-new" ? [google_compute_subnetwork.default_network_workload[0].self_link] : [data.google_compute_subnetwork.default_network_existing_subnet[0].self_link]
        cidrBlock       = var.network_mode == "create-new" ? google_compute_subnetwork.default_network_workload[0].ip_cidr_range : data.google_compute_subnetwork.default_network_existing_subnet[0].ip_cidr_range
        routerSelfLink  = var.network_mode == "create-new" ? google_compute_router.default_network_router[0].self_link : null
        natName         = var.network_mode == "create-new" ? google_compute_router_nat.default_network_nat[0].name : null
        isByoVpc        = var.network_mode != "create-new"
        sandboxNetwork = {
          networkAttachment = "projects/${var.gcp_project}/regions/${var.gcp_region}/networkAttachments/${google_compute_network_attachment.default_network_sbx_attachment.name}"
          attachmentCidr    = google_compute_subnetwork.default_network_sbx_attachment.ip_cidr_range
          gatewayCidr       = google_compute_subnetwork.default_network_sbx_gateway.ip_cidr_range
          gatewayIps = [
            google_compute_instance.default_network_sbx_gateway_0.network_interface[0].network_ip,
            google_compute_instance.default_network_sbx_gateway_1.network_interface[0].network_ip
          ]
