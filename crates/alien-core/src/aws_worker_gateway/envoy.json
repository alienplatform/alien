{
  "static_resources": {
    "listeners": [
      {
        "name": "worker",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8080
          }
        },
        "per_connection_buffer_limit_bytes": 16384,
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "worker",
                  "codec_type": "AUTO",
                  "normalize_path": false,
                  "merge_slashes": false,
                  "path_with_escaped_slashes_action": "KEEP_UNCHANGED",
                  "stream_idle_timeout": "0s",
                  "request_timeout": "0s",
                  "use_remote_address": true,
                  "xff_num_trusted_hops": 1,
                  "route_config": {
                    "name": "private_worker",
                    "ignore_port_in_host_matching": true,
                    "virtual_hosts": [
                      {
                        "name": "gateway",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "cluster": "private_api",
                              "timeout": "0s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.lua",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "inline_string": "\nfunction envoy_on_request(handle)\n  local headers = handle:headers()\n  local api, upstream, path = headers:get(\":path\"):match(\"^/__alien_gateway/([a-z0-9]+)/([^/]+)(/.*)$\")\n  if not api or not upstream:match(\"^vpce%-[a-z0-9%-]+%.execute%-api%.[a-z0-9%-]+%.vpce%.amazonaws%.com$\") then\n    handle:respond({[\":status\"] = \"400\"}, \"Invalid gateway route\")\n    return\n  end\n  headers:replace(\"x-alien-original-target\", path)\n  headers:replace(\"x-apigw-api-id\", api)\n  headers:replace(\":path\", \"/private\" .. path)\n  handle:streamInfo():dynamicMetadata():set(\"alien.gateway\", \"upstream\", upstream)\nend\n"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.set_filter_state",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config",
                        "on_request_headers": [
                          {
                            "object_key": "envoy.upstream.dynamic_host",
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "%DYNAMIC_METADATA(alien.gateway:upstream)%"
                              }
                            }
                          },
                          {
                            "object_key": "envoy.upstream.dynamic_port",
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "443"
                              }
                            }
                          },
                          {
                            "object_key": "envoy.network.upstream_server_name",
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "%DYNAMIC_METADATA(alien.gateway:upstream)%"
                              }
                            }
                          },
                          {
                            "object_key": "envoy.network.upstream_subject_alt_names",
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "%DYNAMIC_METADATA(alien.gateway:upstream)%"
                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": "envoy.filters.http.dynamic_forward_proxy",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig",
                        "dns_cache_config": {
                          "name": "gateway_upstreams",
                          "dns_lookup_family": "V4_ONLY"
                        },
                        "allow_dynamic_host_from_filter_state": true
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "name": "health",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8081
          }
        },
        "per_connection_buffer_limit_bytes": 16384,
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "health",
                  "codec_type": "AUTO",
                  "normalize_path": false,
                  "merge_slashes": false,
                  "path_with_escaped_slashes_action": "KEEP_UNCHANGED",
                  "stream_idle_timeout": "0s",
                  "request_timeout": "0s",
                  "use_remote_address": true,
                  "xff_num_trusted_hops": 1,
                  "route_config": {
                    "name": "health",
                    "virtual_hosts": [
                      {
                        "name": "health",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "direct_response": {
                              "status": 200
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "private_api",
        "cluster_type": {
          "name": "envoy.clusters.dynamic_forward_proxy",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig",
            "dns_cache_config": {
              "name": "gateway_upstreams",
              "dns_lookup_family": "V4_ONLY"
            },
            "allow_insecure_cluster_options": false
          }
        },
        "connect_timeout": "5s",
        "transport_socket": {
          "name": "envoy.transport_sockets.tls",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
            "common_tls_context": {
              "validation_context": {
                "trusted_ca": {
                  "filename": "/etc/ssl/certs/ca-certificates.crt"
                }
              }
            }
          }
        },
        "lb_policy": "CLUSTER_PROVIDED"
      }
    ]
  }
}
