{
  "id": "test-stack",
  "permissions": {
    "management": "auto",
    "profiles": {
      "execution": {
        "*": [
          "storage/data-read",
          "storage/data-write"
        ]
      }
    }
  },
  "resources": {
    "my-bucket": {
      "config": {
        "corsAllowedOrigins": [],
        "id": "my-bucket",
        "lifecycleRules": [],
        "publicRead": true,
        "type": "storage",
        "versioning": false
      },
      "dependencies": [],
      "lifecycle": "frozen",
      "remoteAccess": false
    },
    "my-worker": {
      "config": {
        "code": {
          "image": "rust:latest",
          "type": "image"
        },
        "commandsEnabled": false,
        "concurrencyLimit": null,
        "environment": {},
        "id": "my-worker",
        "links": [
          {
            "id": "my-bucket",
            "type": "storage"
          }
        ],
        "memoryMb": 512,
        "permissions": "execution",
        "readinessProbe": null,
        "timeoutSeconds": 180,
        "triggers": [],
        "type": "worker"
      },
      "dependencies": [],
      "lifecycle": "live",
      "remoteAccess": false
    }
  }
