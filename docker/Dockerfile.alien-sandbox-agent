# Multi-arch build for the alien-sandbox-agent Docker image
# Run directly as the GCP Agent Platform sandbox; nothing layers on top of it

FROM docker.io/chainguard/wolfi-base:latest AS binary-selector

COPY target/aarch64-unknown-linux-musl/release/alien-sandbox-agent /tmp/alien-sandbox-agent-aarch64
COPY target/x86_64-unknown-linux-musl/release/alien-sandbox-agent /tmp/alien-sandbox-agent-x86_64

ARG TARGETARCH
RUN case "$TARGETARCH" in \
       amd64)  cp /tmp/alien-sandbox-agent-x86_64 /tmp/alien-sandbox-agent ;; \
       arm64)  cp /tmp/alien-sandbox-agent-aarch64 /tmp/alien-sandbox-agent ;; \
       *)      echo "unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac

FROM docker.io/chainguard/wolfi-base:latest

# git is for the sandboxed command, not the agent, and pulls 24 transitive packages. That cost
# lands here because this image is the sandbox, with no customer base image underneath to carry it.
RUN apk add --no-cache git

# Root-owned and unwritable by uid 1000: the supervised command runs under that uid and must not
# be able to rewrite its own supervisor.
COPY --from=binary-selector --chown=0:0 --chmod=0755 \
     /tmp/alien-sandbox-agent /usr/local/bin/alien-sandbox-agent

# Numeric ids and a plain append rather than adduser, which differs across base distributions.
# Linux runs a process under a uid with no passwd entry, but tooling inside the sandbox reads one.
RUN printf 'sandbox:x:1000:1000::/sandbox:/sbin/nologin\n' >> /etc/passwd \
 && printf 'sandbox:x:1000:\n' >> /etc/group \
 && mkdir -p /sandbox \
 && chown 1000:1000 /sandbox \
 && chmod 0700 /sandbox

# The contract lives here because the Agent Platform template deliberately carries no env, and the
# agent refuses to start without every one of these.
#
# transport serves a request that carries no capability, so what keeps the supervised command from
# calling the agent on this same port is peer::transport_may_serve refusing a socket owned by the
# exec uid. load_authorization will not start the agent where /proc/net/tcp is unreadable.
ENV ALIEN_SANDBOX_ROOT=/sandbox \
    ALIEN_SANDBOX_PORT=8080 \
    ALIEN_SANDBOX_AUTHORIZATION=transport \
    ALIEN_SANDBOX_EXEC_UID=1000 \
    ALIEN_SANDBOX_EXEC_GID=1000 \
    ALIEN_SANDBOX_ISOLATION=platform

EXPOSE 8080
# Explicit gid so a runtime that does not read /etc/passwd cannot start the agent in group 0, which
# makes the exec drop a privilege crossing whose setgroups needs a CAP_SETGID this image lacks, so
# every exec fails.
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/alien-sandbox-agent"]
