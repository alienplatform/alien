# Multi-stage build to avoid copying both architectures to final image
# Stage 1: Copy and select the correct binary
FROM docker.io/chainguard/wolfi-base:latest AS binary-selector

# Copy alien-worker-runtime for both architectures
COPY target/aarch64-unknown-linux-musl/release/alien-worker-runtime /tmp/alien-worker-runtime-aarch64
COPY target/x86_64-unknown-linux-musl/release/alien-worker-runtime /tmp/alien-worker-runtime-x86_64

# Select the appropriate binary based on target architecture
ARG TARGETARCH
RUN case "$TARGETARCH" in \
       amd64)  cp /tmp/alien-worker-runtime-x86_64 /tmp/alien-worker-runtime ;; \
       arm64)  cp /tmp/alien-worker-runtime-aarch64 /tmp/alien-worker-runtime ;; \
    esac

# Bind the capabilities reported by the selected executable to its exact bytes.
# Consumers must also verify the final image entrypoint and immutable manifest:
# a derived image can replace either the runtime or its startup command.
RUN set -eu; \
    capabilities="$(/tmp/alien-worker-runtime --print-capabilities-json)"; \
    executable_sha256="$(sha256sum /tmp/alien-worker-runtime)"; \
    executable_sha256="${executable_sha256%% *}"; \
    printf '{"executableSha256":"%s","capabilities":%s}\n' \
      "$executable_sha256" "$capabilities" > /tmp/alien-worker-runtime.capabilities.json

# Stage 2: Final runtime image
FROM docker.io/chainguard/wolfi-base:latest

WORKDIR /app

# Apply mode and ownership in the copy layer. Separate chmod/chown layers would
# duplicate the runtime binary in the OCI image.
COPY --from=binary-selector --chmod=755 --chown=nonroot:nonroot /tmp/alien-worker-runtime /app/alien-worker-runtime
COPY --from=binary-selector --chmod=644 --chown=nonroot:nonroot /tmp/alien-worker-runtime.capabilities.json /app/alien-worker-runtime.capabilities.json

# Switch to nonroot user
USER nonroot

ENTRYPOINT ["/app/alien-worker-runtime"]
