# The generic Worker runtime remains language-neutral. TypeScript Workers add
# Bun and the target native addon once in this shared, versioned layer;
# application images then contain only their bundle and source map.
ARG ALIEN_WORKER_BASE=ghcr.io/alienplatform/alien-base:latest

FROM docker.io/oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS bun-runtime

FROM docker.io/chainguard/wolfi-base:latest AS addon-selector
COPY crates/alien-bindings-node/alien-bindings-node.linux-arm64-gnu.node /tmp/alien-bindings-arm64.node
COPY crates/alien-bindings-node/alien-bindings-node.linux-x64-gnu.node /tmp/alien-bindings-amd64.node
COPY target/aarch64-unknown-linux-musl/release/alien-ai-gateway /tmp/alien-ai-gateway-arm64
COPY target/x86_64-unknown-linux-musl/release/alien-ai-gateway /tmp/alien-ai-gateway-amd64
ARG TARGETARCH
RUN case "$TARGETARCH" in \
       amd64) cp /tmp/alien-bindings-amd64.node /tmp/alien-bindings.node && cp /tmp/alien-ai-gateway-amd64 /tmp/alien-ai-gateway ;; \
       arm64) cp /tmp/alien-bindings-arm64.node /tmp/alien-bindings.node && cp /tmp/alien-ai-gateway-arm64 /tmp/alien-ai-gateway ;; \
    esac

FROM ${ALIEN_WORKER_BASE}

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
COPY --from=addon-selector --chmod=644 --chown=nonroot:nonroot /tmp/alien-bindings.node /app/alien-bindings.node
# The ai() client spawns this from the bundle's working directory; staging it in
# the versioned base keeps app images bundle-only, exactly like the addon above.
COPY --from=addon-selector --chmod=755 --chown=nonroot:nonroot /tmp/alien-ai-gateway /app/alien-ai-gateway
