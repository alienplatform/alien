{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "react/react-in-jsx-scope": "off",
    "no-shadow": "off",
    "oxc/no-accumulating-spread": "error",
    "no-unexpected-multiline": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/.wrangler/**/*.js",
    "**/.turbo",
    "**/.alien",
    "**/alien-data",
    "**/dist",
    "client-sdks/manager/typescript",
    "client-sdks/platform/typescript",
    "**/openapi.json",
    "**/openapi-3.0.json",
    "**/openapi",
    "**/app/.well-known",
    "**/code-samples-overlay.json",
    "**/.next",
    "**/api-v1.d.ts",
    "**/entrypoint.js",
    "packages/core/src/generated",
    "packages/sdk/src/worker-runtime/generated",
    "**/shim.mjs",
    "**/target"
  ],
  "overrides": [
    {
      "files": [
        "examples/github-agent/packages/dashboard/components/ui/**/*.tsx",
        "examples/github-agent/packages/dashboard/ui/**/*.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["examples/github-agent/packages/dashboard/components/ui/calendar.tsx"],
      "rules": {
        "react/no-unstable-nested-components": "off"
      }
    },
    {
      "files": [
        "examples/github-agent/packages/dashboard/components/ui/carousel.tsx",
        "examples/github-agent/packages/dashboard/app/(dashboard)/agents/page.tsx",
        "examples/github-agent/packages/dashboard/app/(dashboard)/_components/dashboard-content.tsx",
        "examples/github-agent/packages/dashboard/app/(dashboard)/agents/_components/deployment-method.tsx",
        "examples/github-agent/packages/dashboard/app/(dashboard)/integrations/page.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
