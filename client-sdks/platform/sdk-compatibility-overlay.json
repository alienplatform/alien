{
  "overlay": "1.0.0",
  "info": {
    "title": "Preserve previously published SDK contracts independently of server API removals",
    "version": "1.0.0"
  },
  "actions": [
    {
      "target": "$['components']['schemas']",
      "update": {
        "OperatorInstallationsRollup": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Total pull-mode installations tracked."
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "syncing": {
              "type": "integer",
              "minimum": 0
            },
            "stuck": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "total",
            "ready",
            "syncing",
            "stuck"
          ],
          "description": "Rollup of this project's pull-mode installations by operations-bundle sync status, reflecting the currently enabled plugin set."
        },
        "OperationsPermissionDiff": {
          "type": "object",
          "properties": {
            "aws": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsAwsPermissionDiffStatement"
                  },
                  "description": "IAM statements this change adds."
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsAwsPermissionDiffStatement"
                  },
                  "description": "IAM statements this change removes from the generated cloud configuration."
                }
              },
              "required": [
                "added",
                "removed"
              ]
            },
            "gcp": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsGcpPermissionDiffGrant"
                  }
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsGcpPermissionDiffGrant"
                  }
                }
              },
              "required": [
                "added",
                "removed"
              ]
            },
            "kubernetes": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsKubernetesPermissionDiffGrant"
                  }
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationsKubernetesPermissionDiffGrant"
                  }
                }
              },
              "required": [
                "added",
                "removed"
              ]
            },
            "incompleteForPlugins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Previously enabled plugins whose grants could not be read before this change disabled or replaced them. Added and removed grants may be incomplete; inspect existing cloud policies before applying the regenerated configuration."
            }
          },
          "required": [
            "aws",
            "gcp",
            "kubernetes"
          ],
          "description": "Cloud permission delta versus the previously enabled set."
        },
        "OperationsAwsPermissionDiffStatement": {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "enum": [
                "Allow",
                "Deny"
              ]
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "condition": {
              "type": "object",
              "nullable": true,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OperationsPermissionDiffSource"
              }
            }
          },
          "required": [
            "effect",
            "actions",
            "resources",
            "condition",
            "sources"
          ]
        },
        "OperationsPermissionDiffSource": {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "string",
              "description": "Plugin that declared the permission."
            },
            "operation": {
              "type": "string",
              "description": "Operation that declared the permission."
            },
            "reason": {
              "type": "string",
              "description": "Why the operation needs this permission."
            }
          },
          "required": [
            "plugin",
            "operation",
            "reason"
          ]
        },
        "OperationsGcpPermissionDiffGrant": {
          "type": "object",
          "properties": {
            "permission": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "projects/${projectName}",
                "projects/${projectName}/buckets/${resourceName}"
              ],
              "description": "Where setup grants the permission: the configured project, or each Cloud Storage bucket the installer lists."
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OperationsPermissionDiffSource"
              }
            }
          },
          "required": [
            "permission",
            "scope",
            "sources"
          ]
        },
        "OperationsKubernetesPermissionDiffGrant": {
          "type": "object",
          "properties": {
            "apiGroup": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "verbs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resourceNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Empty means every resource name."
            },
            "remediationOnly": {
              "type": "boolean",
              "description": "True for write verbs. The Helm chart renders them only when Operator permission is set to remediation; diagnostics installs omit them."
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OperationsPermissionDiffSource"
              }
            }
          },
          "required": [
            "apiGroup",
            "resource",
            "verbs",
            "resourceNames",
            "remediationOnly",
            "sources"
          ]
        }
      }
    },
    {
      "target": "$['components']['schemas']['ListOperationsPluginsResponse']['properties']",
      "update": {
        "installations": {
          "$ref": "#/components/schemas/OperatorInstallationsRollup"
        }
      }
    },
    {
      "target": "$['components']['schemas']['OperationsPlugin']['properties']",
      "update": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    {
      "target": "$['components']['schemas']['PublishOperationsPluginResponse']['properties']",
      "update": {
        "enabled": {
          "type": "boolean"
        },
        "permissionDiff": {
          "$ref": "#/components/schemas/OperationsPermissionDiff"
        }
      }
    }
  ]
}
